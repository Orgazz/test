      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Tiny Empire Tycoon :: arranque del servidor.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")

local World = script.Parent.World
local Services = script.Parent.Services

local WorldBuilder = require(World.WorldBuilder)
local PlotService = require(Services.PlotService)
local GameService = require(Services.GameService)
local DataService = require(Services.DataService)
local CrateService = require(Services.CrateService)
local DayNightService = require(Services.DayNightService)
local LeaderboardService = require(Services.LeaderboardService)

-- Grupos de colision: efectos fisicos que no chocan con los jugadores
for _, group in ipairs({ "TE_Players", "TE_Effects" }) do
	if not PhysicsService:IsCollisionGroupRegistered(group) then
		PhysicsService:RegisterCollisionGroup(group)
	end
end
PhysicsService:CollisionGroupSetCollidable("TE_Effects", "TE_Players", false)
PhysicsService:CollisionGroupSetCollidable("TE_Effects", "TE_Effects", false)

-- Remotos
local remotes = Instance.new("Folder")
remotes.Name = "TinyEmpireRemotes"
for _, name in ipairs({ "Action", "State", "Tick", "Notify", "Effect" }) do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
end

-- Mundo
local map, plotDefs = WorldBuilder.build()
PlotService.init(plotDefs, map.Plots, GameService.onPad)

-- Los clientes esperan a que exista la carpeta de remotos (mundo listo)
remotes.Parent = ReplicatedStorage

DayNightService.start()
DataService.start()
GameService.init(remotes)
CrateService.init(map, GameService.collectCrate, GameService.announceRain)
LeaderboardService.start(map, GameService.getStates)

Players.CharacterAutoLoads = true
print(string.format("[TinyEmpire] Servidor listo: %d parcelas creadas.", #plotDefs))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">ChallengeService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Retos diarios: 3 retos por jugador y dia (reinicio a las 00:00 UTC).
-- La seleccion es determinista por jugador y dia para que no se puedan "rerollear".

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.TinyEmpireShared.Config)
local Economy = require(ReplicatedStorage.TinyEmpireShared.Economy)
local Format = require(ReplicatedStorage.TinyEmpireShared.Format)

local ChallengeService = {}

function ChallengeService.today()
	return os.time() // 86400
end

function ChallengeService.secondsUntilReset()
	return 86400 - (os.time() % 86400)
end

local function describe(def, target)
	if def.kind == "earn" then
		return string.format(def.text, Format.cash(target))
	elseif def.text:find("%%d") then
		return string.format(def.text, target)
	end
	return def.text
end

-- Garantiza que el jugador tenga los retos del dia. Devuelve true si se generaron.
function ChallengeService.ensure(state)
	local data = state.data
	local day = ChallengeService.today()
	if data.daily and data.daily.day == day then
		return false
	end
	local income = Economy.totalIncome(data, state.passes.x2)
	local rng = Random.new(day * 7919 + (state.player.UserId % 100000))
	local pool = table.clone(Config.DailyPool)
	local list = {}
	for _ = 1, math.min(Config.DailyCount, #pool) do
		local def = table.remove(pool, rng:NextInteger(1, #pool))
		local target = def.target or 1
		if def.kind == "earn" then
			target = math.floor(math.max(def.min, income * def.incomeSeconds))
		end
		local reward = math.floor(math.max(Config.DailyMinReward, income * Config.DailyRewardIncomeSeconds))
		table.insert(list, {
			id = def.id,
			kind = def.kind,
			text = describe(def, target),
			target = target,
			progress = 0,
			reward = reward,
			claimed = false,
		})
	end
	data.daily = { day = day, list = list, bonusClaimed = false }
	return true
end

-- Suma progreso a los retos de un tipo. Devuelve true si alguno se completo.
function ChallengeService.progress(state, kind, amount)
	local daily = state.data.daily
	if not daily then
		return false
	end
	local completed = false
	for _, c in ipairs(daily.list) do
		if c.kind == kind and not c.claimed and c.progress < c.target then
			c.progress = math.min(c.target, c.progress + amount)
			if c.progress >= c.target then
				completed = true
			end
		end
	end
	return completed
end

-- Reclama un reto. Devuelve recompensa (0 si no se puede) y bonus extra.
function ChallengeService.claim(state, index)
	local daily = state.data.daily
	if not daily then
		return 0, 0
	end
	local c = daily.list[index]
	if not c or c.claimed or c.progress < c.target then
		return 0, 0
	end
	c.claimed = true
	local bonus = 0
	local all = true
	for _, other in ipairs(daily.list) do
		if not other.claimed then
			all = false
		end
	end
	if all and not daily.bonusClaimed then
		daily.bonusClaimed = true
		for _, other in ipairs(daily.list) do
			bonus += other.reward
		end
		bonus = math.floor(bonus * (Config.DailyAllBonusMult - 1))
	end
	return c.reward, bonus
end

return ChallengeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CrateService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Maletines de bonificacion que caen del cielo sobre la plaza central.
--  * Son piezas fisicas: caen, rebotan y ruedan; al asentarse se anclan y giran.
--  * Cada 5 minutos hay una "Lluvia de maletines" para todos los jugadores.
-- Dan dinero proporcional al ingreso de quien los recoge (no quitan nada a nadie).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.Parent.World.Kit)
local Config = require(ReplicatedStorage.TinyEmpireShared.Config)

local CrateService = {}

local folder = nil
local onCollect = nil -- function(player, position): boolean
local onRain = nil -- function()
local rng = Random.new()

CrateService.RainInterval = 300
CrateService.RainCount = 8
CrateService.SettleTime = 3.5

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function spawnCrate(force)
	local active = #folder:GetChildren()
	if active >= Config.Crates.maxActive and not force then
		return
	end
	if active >= Config.Crates.maxActive + CrateService.RainCount * 2 then
		return
	end
	local a = rng:NextNumber(0, math.pi * 2)
	local r = rng:NextNumber(14, 46)
	local ground = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
	local startPos = ground + Vector3.new(rng:NextNumber(-4, 4), rng:NextNumber(28, 40), rng:NextNumber(-4, 4))
	local m = Instance.new("Model")
	m.Name = "Briefcase"
	local cf = CFrame.new(startPos) * CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, 6.28), rng:NextNumber(-0.6, 0.6))
	local body = Kit.box(m, "Body", Vector3.new(3, 2.2, 1.2), cf, Color3.fromRGB(140, 85, 45), Enum.Material.SmoothPlastic)
	body.Anchored = false
	body.CustomPhysicalProperties = PhysicalProperties.new(0.6, 0.45, 0.55, 1, 1)
	local function attach(part)
		part.Anchored = false
		part.CanCollide = false
		part.Massless = true
		weld(body, part)
		return part
	end
	attach(Kit.box(m, "Band", Vector3.new(3.05, 0.4, 1.25), cf, Color3.fromRGB(255, 205, 60), Enum.Material.Foil))
	attach(Kit.box(m, "Handle", Vector3.new(1.2, 0.5, 0.3), cf * CFrame.new(0, 1.35, 0), Color3.fromRGB(255, 205, 60), Enum.Material.Foil))
	local glow = attach(Kit.ball(m, "Glow", 4.5, cf, Color3.fromRGB(255, 230, 120), Enum.Material.Neon, { Transparency = 0.82, CastShadow = false }))
	glow.CanQuery = false
	Kit.sparkles(body, Color3.fromRGB(255, 230, 120), 8)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 120)
	light.Range = 10
	light.Brightness = 2
	light.Parent = glow
	local _, label = Kit.billboard(body, "💼", UDim2.fromOffset(60, 60), Vector3.new(0, 3, 0), Color3.new(1, 1, 1), 90)
	label.TextStrokeTransparency = 1
	local touch = attach(Kit.box(m, "Touch", Vector3.new(6, 6, 6), cf, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, { Transparency = 1 }))
	touch.CanQuery = false
	m.PrimaryPart = body

	local taken = false
	touch.Touched:Connect(function(hit)
		if taken then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player then
			return
		end
		taken = true
		local ok = onCollect(player, body.Position)
		if ok then
			m:Destroy()
		else
			taken = false
		end
	end)
	m.Parent = folder
	-- Impulso inicial: cae girando
	body.AssemblyLinearVelocity = Vector3.new(rng:NextNumber(-8, 8), -10, rng:NextNumber(-8, 8))
	body.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-4, 4), rng:NextNumber(-6, 6), rng:NextNumber(-4, 4))
	pcall(function()
		body:SetNetworkOwner(nil) -- el servidor simula: nadie puede teletransportarlo
	end)
	-- Al asentarse: anclar en pie, flotar y girar (lo anima el cliente)
	task.delay(CrateService.SettleTime, function()
		if not m.Parent then
			return
		end
		local p = body.Position
		if p.Y < -20 or p.Magnitude > 200 then
			m:Destroy() -- se salio de la plaza
			return
		end
		body.Anchored = true
		local rest = CFrame.new(p.X, math.max(p.Y, 1.7) + 0.9, p.Z)
		body.CFrame = rest
		m.WorldPivot = rest
		m:SetAttribute("SpinSpeed", 90)
		m:SetAttribute("SpinAxis", "Y")
		m:SetAttribute("BobHeight", 0.5)
		m:SetAttribute("BobSpeed", 1.2)
		m:AddTag("TE_Spin")
		m:AddTag("TE_Bob")
	end)
	task.delay(150, function()
		if m.Parent then
			m:Destroy()
		end
	end)
	return m
end

function CrateService.spawn(force)
	return spawnCrate(force)
end

-- Lluvia de maletines: varios a la vez durante unos segundos
function CrateService.rain()
	if onRain then
		onRain()
	end
	for i = 1, CrateService.RainCount do
		task.delay(i * 0.35, spawnCrate, true)
	end
end

function CrateService.init(map, collectHandler, rainHandler)
	folder = map:FindFirstChild("Crates")
	onCollect = collectHandler
	onRain = rainHandler
	task.spawn(function()
		task.wait(3)
		for _ = 1, 3 do
			spawnCrate()
		end
		while true do
			task.wait(Config.Crates.spawnInterval)
			spawnCrate()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(CrateService.RainInterval)
			CrateService.rain()
		end
	end)
end

return CrateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Guardado de progreso con DataStoreService.
--  * Bloqueo de sesion para evitar que dos servidores pisen los mismos datos.
--  * Reintentos con espera creciente.
--  * Autoguardado periodico y guardado al cerrar el servidor.
--  * Si los DataStores no estan disponibles (Studio sin acceso a API), el juego
--    sigue funcionando en memoria y avisa al jugador.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.TinyEmpireShared.Config)
local Economy = require(ReplicatedStorage.TinyEmpireShared.Economy)

local DataService = {}

local SESSION_LOCK_SECONDS = 150
local MAX_ATTEMPTS = 5

local store = nil
local storeAvailable = true
local profiles = {} -- [Player] = { data, persistent, saving, released }

local function jobId()
	local id = game.JobId
	if id == nil or id == "" then
		return "studio"
	end
	return id
end

local function keyFor(userId)
	return "Player_" .. tostring(userId)
end

local function isFatal(err)
	local msg = tostring(err)
	return msg:find("StudioAccessToApisNotAllowed") ~= nil
		or msg:find("publish") ~= nil
		or msg:find("API Services") ~= nil
		or msg:find("403") ~= nil
end

local function getStore()
	if not storeAvailable then
		return nil
	end
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		return store
	end
	warn("[TinyEmpire] DataStore no disponible: " .. tostring(result))
	storeAvailable = false
	return nil
end

function DataService.isAvailable()
	return storeAvailable
end

-- Carga los datos de un jugador. Devuelve el perfil (nunca nil).
function DataService.load(player)
	local ds = getStore()
	local key = keyFor(player.UserId)
	local loaded = nil
	local persistent = false

	if ds then
		for attempt = 1, MAX_ATTEMPTS do
			if not player.Parent then
				return nil
			end
			local lockedByOther = false
			local forceTakeover = attempt == MAX_ATTEMPTS
			local ok, result = pcall(function()
				return ds:UpdateAsync(key, function(old)
					if type(old) ~= "table" then
						old = { data = Economy.newData() }
					end
					local session = old.session
					if session and session.jobId ~= jobId() and os.time() - (session.time or 0) < SESSION_LOCK_SECONDS and not forceTakeover then
						lockedByOther = true
						return nil
					end
					old.session = { jobId = jobId(), time = os.time() }
					return old
				end)
			end)
			if ok and not lockedByOther and type(result) == "table" then
				loaded = result.data
				persistent = true
				break
			elseif not ok then
				warn(string.format("[TinyEmpire] Error cargando %s (intento %d): %s", player.Name, attempt, tostring(result)))
				if isFatal(result) then
					storeAvailable = false
					break
				end
			end
			task.wait(math.min(2 * attempt, 6))
		end
	end

	if loaded == nil then
		loaded = Economy.newData()
	end
	local data = Economy.reconcile(loaded)
	local profile = {
		data = data,
		persistent = persistent,
		saving = false,
		released = false,
	}
	profiles[player] = profile
	return profile
end

function DataService.get(player)
	return profiles[player]
end

-- Guarda el perfil. `release` libera el bloqueo de sesion (al salir).
function DataService.save(player, release)
	local profile = profiles[player]
	if not profile then
		return false
	end
	if not profile.persistent then
		return true -- modo en memoria: no hay nada que guardar
	end
	local ds = getStore()
	if not ds then
		return false
	end
	-- Espera a que termine un guardado anterior
	local waited = 0
	while profile.saving and waited < 15 do
		task.wait(0.25)
		waited += 0.25
	end
	profile.saving = true
	profile.data.lastOnline = os.time()
	local stolen = false
	local ok, err = pcall(function()
		ds:UpdateAsync(keyFor(player.UserId), function(old)
			if type(old) == "table" and old.session and old.session.jobId ~= jobId() then
				-- Otro servidor tomo el control: no sobrescribir
				stolen = true
				return nil
			end
			return {
				data = profile.data,
				session = (not release) and { jobId = jobId(), time = os.time() } or nil,
			}
		end)
	end)
	profile.saving = false
	if not ok then
		warn(string.format("[TinyEmpire] Error guardando %s: %s", player.Name, tostring(err)))
		return false
	end
	if stolen then
		warn("[TinyEmpire] La sesion de " .. player.Name .. " esta activa en otro servidor; no se sobrescribe.")
		return false
	end
	return true
end

-- Guardado con reintentos (usado tras compras con Robux)
function DataService.forceSave(player)
	for attempt = 1, 3 do
		if DataService.save(player, false) then
			return true
		end
		task.wait(attempt)
	end
	return false
end

function DataService.isPersistent(player)
	local p = profiles[player]
	return p ~= nil and p.persistent
end

function DataService.release(player)
	local profile = profiles[player]
	if not profile or profile.released then
		return
	end
	profile.released = true
	DataService.save(player, true)
	profiles[player] = nil
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				if profiles[player] then
					task.spawn(DataService.save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			if profiles[player] then
				pending += 1
				task.spawn(function()
					DataService.release(player)
					pending -= 1
				end)
			end
		end
		local t = 0
		while pending > 0 and t < 25 do
			task.wait(0.25)
			t += 0.25
		end
		if RunService:IsStudio() then
			task.wait(1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">DayNightService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Ciclo dia/noche: 10 minutos de dia y 4 de noche. Enciende farolas y ventanas.

local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local DayNightService = {}

local DAY_SECONDS = 600
local NIGHT_SECONDS = 240
local isNight = nil

local WINDOW_DAY = Color3.fromRGB(160, 215, 245)
local WINDOW_NIGHT = Color3.fromRGB(255, 215, 130)

local function setNight(night)
	if isNight == night then
		return
	end
	isNight = night
	workspace:SetAttribute("IsNight", night)
	for _, part in ipairs(CollectionService:GetTagged("TE_Lamp")) do
		for _, l in ipairs(part:GetChildren()) do
			if l:IsA("Light") then
				l.Enabled = night
			end
		end
	end
	for _, w in ipairs(CollectionService:GetTagged("TE_Window")) do
		if w:IsA("BasePart") then
			w.Material = night and Enum.Material.Neon or Enum.Material.Glass
			w.Color = night and WINDOW_NIGHT or WINDOW_DAY
			w.Transparency = night and 0.1 or 0.15
		end
	end
	local cc = Lighting:FindFirstChild("TE_Color")
	if cc then
		cc.TintColor = night and Color3.fromRGB(205, 215, 255) or Color3.new(1, 1, 1)
	end
end

-- Aplica el estado actual a piezas nuevas (edificios construidos de noche)
function DayNightService.applyTo(model)
	if not isNight then
		return
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Light") and d.Parent and d.Parent:HasTag("TE_Lamp") then
			d.Enabled = true
		elseif d:IsA("BasePart") and d:HasTag("TE_Window") then
			d.Material = Enum.Material.Neon
			d.Color = WINDOW_NIGHT
		end
	end
end

function DayNightService.isNight()
	return isNight == true
end

function DayNightService.start()
	local cycle = DAY_SECONDS + NIGHT_SECONDS
	local t = 0
	isNight = nil
	setNight(false)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		t = (t + dt) % cycle
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		local clock
		if t < DAY_SECONDS then
			-- 6:30 -> 18:30
			clock = 6.5 + 12 * (t / DAY_SECONDS)
		else
			-- 18:30 -> 6:30
			clock = (18.5 + 12 * ((t - DAY_SECONDS) / NIGHT_SECONDS)) % 24
		end
		Lighting.ClockTime = clock
		setNight(clock >= 18.2 or clock < 6.4)
		local nightFactor = 0
		if clock >= 18 or clock < 6 then
			nightFactor = 1
		elseif clock >= 17 then
			nightFactor = clock - 17
		elseif clock < 7 then
			nightFactor = 7 - clock
		end
		Lighting.Brightness = 2.6 - nightFactor * 1.4
		Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 155):Lerp(Color3.fromRGB(80, 85, 130), nightFactor)
	end)
end

return DayNightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Nucleo del juego: estado de cada jugador, economia automatica, acciones
-- validadas en el servidor, tutorial, objetivos y sincronizacion con el cliente.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.TinyEmpireShared.Config)
local Economy = require(ReplicatedStorage.TinyEmpireShared.Economy)
local Format = require(ReplicatedStorage.TinyEmpireShared.Format)

local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local ChallengeService = require(script.Parent.ChallengeService)
local MonetizationService = require(script.Parent.MonetizationService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local DayNightService = require(script.Parent.DayNightService)

local GameService = {}

local states = {} -- [Player] = state
local remotes = nil

local COLORS = {
	good = Color3.fromRGB(90, 220, 120),
	bad = Color3.fromRGB(255, 95, 95),
	info = Color3.fromRGB(110, 180, 255),
	gold = Color3.fromRGB(255, 205, 60),
	purple = Color3.fromRGB(190, 120, 255),
}

-- Pasos del tutorial (el cliente muestra texto y flecha guia)
GameService.TutorialSteps = 7
local TUTORIAL_DONE = 99

------------------------------------------------------------------------------
-- Utilidades
------------------------------------------------------------------------------

local function notify(player, text, color, sound)
	if remotes and player.Parent then
		remotes.Notify:FireClient(player, { text = text, color = color or COLORS.info, sound = sound })
	end
end

local function effect(player, payload)
	if remotes and player.Parent then
		remotes.Effect:FireClient(player, payload)
	end
end

local function hasX2(state)
	return state.passes.x2 == true
end

local function snapshot(state)
	local data = state.data
	local level, info, nextInfo, progress = Economy.empireLevel(data.runEarned)
	return {
		cash = data.cash,
		income = Economy.totalIncome(data, hasX2(state)),
		runEarned = data.runEarned,
		lifetimeEarned = data.lifetimeEarned,
		empireLevel = level,
		empireTitle = info.title,
		nextLevelNeed = nextInfo and nextInfo.need or nil,
		levelProgress = progress,
		businesses = data.businesses,
		upgrades = data.upgrades,
		expansions = data.expansions,
		franchises = data.franchises,
		goalsClaimed = data.goalsClaimed,
		tutorial = data.tutorial,
		daily = data.daily,
		dailyReset = ChallengeService.secondsUntilReset(),
		stats = data.stats,
		passes = state.passes,
		settings = data.settings,
		plotIndex = state.plot and state.plot.index or nil,
		simulation = MonetizationService.simulationAllowed(),
		persistent = DataService.isPersistent(state.player),
		canFranchise = Economy.canFranchise(data),
		crateReward = Economy.crateReward(data, hasX2(state)),
	}
end

local function markDirty(state)
	state.dirty = true
end

local function sync(state)
	if not state.ready or not state.player.Parent then
		return
	end
	remotes.State:FireClient(state.player, snapshot(state))
	state.dirty = false
end

local function earn(state, amount)
	local data = state.data
	data.cash += amount
	data.runEarned += amount
	data.lifetimeEarned += amount
	if ChallengeService.progress(state, "earn", amount) then
		notify(state.player, "🎯 ¡Reto diario completado! Reclámalo en Retos.", COLORS.gold, "success")
		markDirty(state)
	end
end

-- Gasto seguro: devuelve true si habia dinero suficiente
local function spend(state, amount)
	if amount < 0 or state.data.cash < amount then
		return false
	end
	state.data.cash -= amount
	return true
end

local function refreshVisuals(state)
	if state.plot then
		PlotService.updateIncomeAttributes(state.plot, state)
		PlotService.updatePads(state.plot, state)
		PlotService.updateStats(state.plot, state, Economy.totalIncome(state.data, hasX2(state)))
	end
end

------------------------------------------------------------------------------
-- Tutorial
------------------------------------------------------------------------------

local function checkTutorial(state)
	local data = state.data
	local step = data.tutorial
	if step >= TUTORIAL_DONE then
		return
	end
	local advanced = false
	local function advance(nextStep)
		data.tutorial = nextStep
		step = nextStep
		advanced = true
	end
	for _ = 1, 8 do
		local before = step
		if step == 1 and (data.businesses.lemonade or 0) > 0 then
			advance(2)
		elseif step == 2 and (data.cash >= Config.BusinessById.foodtruck.cost or (data.businesses.foodtruck or 0) > 0) then
			advance(3)
		elseif step == 3 and (data.businesses.foodtruck or 0) > 0 then
			advance(4)
		elseif step == 4 and Economy.maxBusinessLevel(data) >= 2 then
			advance(5)
		elseif step == 5 and Economy.upgradeCount(data) >= 1 then
			advance(6)
		elseif step == 6 and state.flags.openedChallenges then
			advance(7)
		elseif step == 7 and state.flags.visitedPlaza then
			advance(TUTORIAL_DONE)
			earn(state, 500)
			notify(state.player, "🎓 ¡Tutorial completado! +$500 de regalo.", COLORS.gold, "success")
			effect(state.player, { kind = "confetti" })
		end
		if step == before then
			break
		end
	end
	if advanced then
		markDirty(state)
	end
end

------------------------------------------------------------------------------
-- Acciones del jugador
------------------------------------------------------------------------------

local Actions = {}

function Actions.buyBusiness(state, id)
	if type(id) ~= "string" then
		return
	end
	local b = Config.BusinessById[id]
	if not b then
		return
	end
	local st, reason = Economy.businessState(state.data, id)
	if st == "owned" then
		Actions.upgradeBusiness(state, id)
		return
	end
	if st ~= "available" then
		notify(state.player, "🔒 " .. (reason or "Bloqueado"), COLORS.bad, "error")
		return
	end
	if not spend(state, b.cost) then
		notify(state.player, "💸 Te faltan " .. Format.cash(b.cost - state.data.cash), COLORS.bad, "error")
		return
	end
	state.data.businesses[id] = 1
	state.data.stats.builds += 1
	ChallengeService.progress(state, "builds", 1)
	local where = nil
	if state.plot then
		local model = PlotService.buildBusiness(state.plot, state, id, true)
		where = model and model:GetPivot().Position
		DayNightService.applyTo(state.plot.model.Buildings)
	end
	notify(state.player, b.icon .. " ¡Has abierto " .. b.name .. "!", COLORS.good, "build")
	effect(state.player, { kind = "build", id = id, position = where })
	refreshVisuals(state)
	checkTutorial(state)
	markDirty(state)
end

function Actions.upgradeBusiness(state, id)
	if type(id) ~= "string" then
		return
	end
	local b = Config.BusinessById[id]
	local level = state.data.businesses[id] or 0
	if not b or level <= 0 then
		return
	end
	local cost = Economy.levelUpCost(id, level)
	if not cost then
		notify(state.player, "⭐ " .. b.name .. " ya está al nivel máximo", COLORS.info)
		return
	end
	if not spend(state, cost) then
		notify(state.player, "💸 Te faltan " .. Format.cash(cost - state.data.cash), COLORS.bad, "error")
		return
	end
	state.data.businesses[id] = level + 1
	state.data.stats.levelUps += 1
	state.data.stats.builds += 1
	ChallengeService.progress(state, "levelUps", 1)
	ChallengeService.progress(state, "builds", 1)
	local where = nil
	if state.plot then
		local model = PlotService.buildBusiness(state.plot, state, id, true)
		where = model and model:GetPivot().Position
		DayNightService.applyTo(state.plot.model.Buildings)
	end
	notify(state.player, "⬆️ " .. b.name .. " sube a nivel " .. (level + 1) .. "!", COLORS.good, "levelup")
	effect(state.player, { kind = "levelup", id = id, level = level + 1, position = where })
	refreshVisuals(state)
	checkTutorial(state)
	markDirty(state)
end

function Actions.buyUpgrade(state, id)
	if type(id) ~= "string" then
		return
	end
	local u = Config.UpgradeById[id]
	if not u then
		return
	end
	local st, reason = Economy.upgradeState(state.data, id)
	if st == "owned" then
		return
	end
	if st ~= "available" then
		notify(state.player, "🔒 " .. (reason or "Bloqueado"), COLORS.bad, "error")
		return
	end
	if not spend(state, u.cost) then
		notify(state.player, "💸 Te faltan " .. Format.cash(u.cost - state.data.cash), COLORS.bad, "error")
		return
	end
	state.data.upgrades[id] = true
	state.data.stats.upgrades += 1
	ChallengeService.progress(state, "upgrades", 1)
	if u.visual and state.plot then
		PlotService.rebuildExtras(state.plot, state)
	end
	notify(state.player, u.icon .. " Mejora comprada: " .. u.name, COLORS.purple, "upgrade")
	effect(state.player, { kind = "upgrade", id = id })
	refreshVisuals(state)
	checkTutorial(state)
	markDirty(state)
end

function Actions.buyExpansion(state, index)
	index = tonumber(index)
	if not index then
		return
	end
	local exp = Config.Expansions[index]
	if not exp then
		return
	end
	local st, reason = Economy.expansionState(state.data, index)
	if st == "owned" then
		return
	end
	if st ~= "available" then
		notify(state.player, "🔒 " .. (reason or "Bloqueado"), COLORS.bad, "error")
		return
	end
	if not spend(state, exp.cost) then
		notify(state.player, "💸 Te faltan " .. Format.cash(exp.cost - state.data.cash), COLORS.bad, "error")
		return
	end
	state.data.expansions = index
	if state.plot then
		PlotService.rebuildZones(state.plot, state)
	end
	notify(state.player, "🚧 ¡Has desbloqueado " .. exp.name .. "! Nuevos negocios disponibles.", COLORS.gold, "success")
	effect(state.player, { kind = "expansion", index = index })
	effect(state.player, { kind = "confetti" })
	refreshVisuals(state)
	markDirty(state)
end

function Actions.claimGoal(state)
	local goal = Economy.currentGoal(state.data)
	if not goal then
		return
	end
	if Economy.goalProgress(state.data, goal) < goal.target then
		notify(state.player, "🎯 Aún no has completado: " .. goal.text, COLORS.bad, "error")
		return
	end
	state.data.goalsClaimed[goal.id] = true
	earn(state, goal.reward)
	notify(state.player, "🏅 Objetivo cumplido: +" .. Format.cash(goal.reward), COLORS.gold, "success")
	effect(state.player, { kind = "confetti" })
	refreshVisuals(state)
	markDirty(state)
end

function Actions.claimDaily(state, index)
	index = tonumber(index)
	if not index then
		return
	end
	local reward, bonus = ChallengeService.claim(state, index)
	if reward <= 0 then
		return
	end
	earn(state, reward)
	notify(state.player, "🎯 Reto completado: +" .. Format.cash(reward), COLORS.gold, "success")
	if bonus > 0 then
		earn(state, bonus)
		notify(state.player, "🔥 ¡Bonus por los 3 retos!: +" .. Format.cash(bonus), COLORS.gold, "success")
		effect(state.player, { kind = "confetti" })
	end
	refreshVisuals(state)
	markDirty(state)
end

function Actions.franchise(state)
	local data = state.data
	if not Economy.canFranchise(data) then
		notify(state.player, "🏢 Necesitas la Torre Corporativa y " .. Format.cash(Config.Franchise.needEarned) .. " ganados.", COLORS.bad, "error")
		return
	end
	data.franchises += 1
	data.cash = 0
	data.runEarned = 0
	data.businesses = {}
	data.upgrades = {}
	data.expansions = 0
	if state.plot then
		PlotService.rebuildAll(state.plot, state)
	end
	notify(state.player, string.format("🌟 ¡Nueva franquicia! Bonus permanente: %s", Format.percent(data.franchises * Config.Franchise.bonusPerFranchise)), COLORS.gold, "success")
	effect(state.player, { kind = "confetti" })
	refreshVisuals(state)
	markDirty(state)
end

function Actions.teleport(state, target)
	local character = state.player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return
	end
	if target == "plot" and state.plot then
		character:PivotTo(PlotService.spawnCFrame(state.plot))
	elseif target == "plaza" then
		character:PivotTo(CFrame.new(0, 4, -44) * CFrame.Angles(0, math.rad(180), 0))
	end
end

function Actions.setting(state, key, value)
	if type(value) ~= "boolean" then
		return
	end
	if key == "decor" then
		state.data.settings.decor = value
		if state.plot then
			PlotService.rebuildExtras(state.plot, state)
		end
	elseif key == "theme" then
		state.data.settings.theme = value
		if state.plot then
			PlotService.rebuildAll(state.plot, state)
			DayNightService.applyTo(state.plot.model)
		end
	else
		return
	end
	markDirty(state)
end

function Actions.tutorial(state, event)
	if event == "openedChallenges" then
		state.flags.openedChallenges = true
	elseif event == "skip" then
		state.data.tutorial = TUTORIAL_DONE
	end
	checkTutorial(state)
	markDirty(state)
end

function Actions.simulate(state, kind, key)
	if type(kind) ~= "string" or type(key) ~= "string" then
		return
	end
	local ok, err = MonetizationService.simulate(state.player, kind, key)
	if not ok and err then
		notify(state.player, err, COLORS.bad, "error")
	end
end

function Actions.requestState(state)
	markDirty(state)
end

------------------------------------------------------------------------------
-- Pads (botones fisicos de la parcela)
------------------------------------------------------------------------------

function GameService.onPad(player, plot, kind, target)
	local state = states[player]
	if kind == "notOwner" then
		notify(player, "🚫 Esta no es tu parcela. Solo su dueño puede construir aquí.", COLORS.bad, "error")
		return
	end
	if not state or not state.ready or state.plot ~= plot then
		return
	end
	if kind == "business" then
		Actions.buyBusiness(state, target)
	elseif kind == "expansion" then
		Actions.buyExpansion(state, target)
	end
end

------------------------------------------------------------------------------
-- Ciclo de vida de jugadores
------------------------------------------------------------------------------

local function grantOffline(state)
	local data = state.data
	if (data.lastOnline or 0) <= 0 then
		return
	end
	local elapsed = os.time() - data.lastOnline
	if elapsed < Config.Offline.minSeconds then
		return
	end
	local rate, maxSeconds = Economy.offlineSettings(data)
	local seconds = math.min(elapsed, maxSeconds)
	local amount = math.floor(Economy.totalIncome(data, hasX2(state)) * seconds * rate)
	if amount > 0 then
		earn(state, amount)
		task.delay(3, function()
			if state.player.Parent then
				effect(state.player, { kind = "offline", amount = amount, seconds = seconds })
			end
		end)
	end
end

local function placeCharacter(state)
	local player = state.player
	local character = player.Character
	if not character or not state.plot then
		return
	end
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if root then
		task.wait(0.1)
		character:PivotTo(PlotService.spawnCFrame(state.plot))
	end
end

local function onPlayerAdded(player)
	LeaderboardService.setup(player)
	local state = {
		player = player,
		data = nil,
		ready = false,
		dirty = true,
		passes = { decor = false, theme = false, x2 = false },
		flags = {},
		plot = nil,
		actionTimes = {},
		minuteAcc = 0,
	}
	states[player] = state

	local profile = DataService.load(player)
	if not profile or not player.Parent then
		-- El jugador se fue mientras cargaba: liberar el bloqueo de sesion
		DataService.release(player)
		states[player] = nil
		return
	end
	state.data = profile.data
	state.passes = MonetizationService.loadPasses(player, state.data)

	local plot = PlotService.assign(player)
	if not plot then
		player:Kick("El servidor está lleno (8 parcelas). ¡Prueba en otro servidor!")
		return
	end
	state.plot = plot
	ChallengeService.ensure(state)
	grantOffline(state)
	state.ready = true

	PlotService.rebuildAll(plot, state)
	DayNightService.applyTo(plot.model)
	refreshVisuals(state)
	LeaderboardService.update(player, state.data)
	checkTutorial(state)
	sync(state)

	if not profile.persistent then
		task.delay(4, function()
			notify(player, "⚠️ Guardado desactivado: activa 'Enable Studio Access to API Services' o publica el juego.", COLORS.bad)
		end)
	end
	notify(player, "👋 ¡Bienvenido a Tiny Empire Tycoon, " .. player.DisplayName .. "!", COLORS.gold, "success")

	player.CharacterAdded:Connect(function(character)
		GameService.setCollisionGroup(character)
		task.defer(placeCharacter, state)
	end)
	if player.Character then
		GameService.setCollisionGroup(player.Character)
		task.defer(placeCharacter, state)
	end
end

local function onPlayerRemoving(player)
	local state = states[player]
	if state then
		state.ready = false
	end
	DataService.release(player)
	PlotService.release(player)
	states[player] = nil
end

------------------------------------------------------------------------------
-- Bucles
------------------------------------------------------------------------------

local function incomeLoop()
	while true do
		task.wait(Config.IncomeTick)
		for player, state in pairs(states) do
			if state.ready and player.Parent then
				local income = Economy.totalIncome(state.data, hasX2(state)) * Config.IncomeTick
				if income > 0 then
					earn(state, income)
				end
				-- Tiempo jugado (retos de minutos)
				state.data.stats.playSeconds += Config.IncomeTick
				state.minuteAcc += Config.IncomeTick
				if state.minuteAcc >= 60 then
					state.minuteAcc -= 60
					if ChallengeService.progress(state, "minutes", 1) then
						notify(player, "🎯 ¡Reto diario completado!", COLORS.gold, "success")
					end
					markDirty(state)
				end
				-- Nuevo dia
				if ChallengeService.ensure(state) then
					notify(player, "🌅 ¡Nuevos retos diarios disponibles!", COLORS.gold)
					markDirty(state)
				end
				-- Visita a la plaza
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root then
					local p = root.Position
					local inPlaza = Vector3.new(p.X, 0, p.Z).Magnitude < Config.PlazaRadius
					if inPlaza and not state.flags.visitedPlaza then
						state.flags.visitedPlaza = true
						ChallengeService.progress(state, "plaza", 1)
						markDirty(state)
					end
				end
				checkTutorial(state)
				refreshVisuals(state)
				LeaderboardService.update(player, state.data)
				if state.dirty then
					sync(state)
				else
					remotes.Tick:FireClient(player, state.data.cash, income / Config.IncomeTick, state.data.runEarned)
				end
			end
		end
	end
end

------------------------------------------------------------------------------
-- API publica para otros servicios
------------------------------------------------------------------------------

-- Personajes en su propio grupo de colision: los efectos fisicos (monedas,
-- escombros) rebotan en el suelo pero atraviesan a los jugadores.
function GameService.setCollisionGroup(character)
	local function apply(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = "TE_Players"
		end
	end
	for _, d in ipairs(character:GetDescendants()) do
		apply(d)
	end
	character.DescendantAdded:Connect(apply)
end

function GameService.announceRain()
	for player, state in pairs(states) do
		if state.ready then
			notify(player, "🌧️💼 ¡Lluvia de maletines en la plaza central! ¡Corre!", COLORS.gold, "success")
			effect(player, { kind = "rain" })
		end
	end
end

function GameService.getState(player)
	return states[player]
end

function GameService.getStates()
	return states
end

function GameService.collectCrate(player, position)
	local state = states[player]
	if not state or not state.ready then
		return false
	end
	local reward = Economy.crateReward(state.data, hasX2(state))
	earn(state, reward)
	state.data.stats.crates += 1
	if ChallengeService.progress(state, "crates", 1) then
		notify(player, "🎯 ¡Reto diario completado!", COLORS.gold, "success")
	end
	effect(player, { kind = "cash", amount = reward, position = position })
	notify(player, "💼 ¡Maletín recogido! +" .. Format.cash(reward), COLORS.gold, "coin")
	markDirty(state)
	return true
end

function GameService.init(remoteFolder)
	remotes = remoteFolder

	MonetizationService.init({
		getState = GameService.getState,
		onPassGranted = function(player, key)
			local state = states[player]
			if not state then
				return
			end
			local pass = Config.GamePasses[key]
			if key == "decor" and state.plot then
				PlotService.rebuildExtras(state.plot, state)
			elseif key == "theme" and state.plot then
				PlotService.rebuildAll(state.plot, state)
				DayNightService.applyTo(state.plot.model)
			end
			notify(player, pass.icon .. " ¡Gracias! Has desbloqueado: " .. pass.name, COLORS.gold, "success")
			effect(player, { kind = "confetti" })
			refreshVisuals(state)
			markDirty(state)
			sync(state)
		end,
		onCashGranted = function(player, amount, product)
			local state = states[player]
			if not state then
				return
			end
			notify(player, product.icon .. " ¡Gracias! +" .. Format.cash(amount), COLORS.gold, "success")
			effect(player, { kind = "cash", amount = amount })
			effect(player, { kind = "confetti" })
			refreshVisuals(state)
			markDirty(state)
			sync(state)
		end,
	})

	remotes.Action.OnServerEvent:Connect(function(player, action, a, b)
		local state = states[player]
		if not state or not state.ready then
			return
		end
		if type(action) ~= "string" then
			return
		end
		-- Limite de peticiones: maximo 12 por segundo
		local now = os.clock()
		local times = state.actionTimes
		while #times > 0 and now - times[1] > 1 do
			table.remove(times, 1)
		end
		if #times >= 12 then
			return
		end
		table.insert(times, now)
		local handler = Actions[action]
		if handler then
			handler(state, a, b)
			if state.dirty then
				sync(state)
			end
		end
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	task.spawn(incomeLoop)
end

GameService.Actions = Actions
GameService._checkTutorial = checkTutorial
GameService._snapshot = snapshot

return GameService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Ranking del servidor en el panel de la plaza + leaderstats.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.TinyEmpireShared.Format)
local Economy = require(ReplicatedStorage.TinyEmpireShared.Economy)

local LeaderboardService = {}

function LeaderboardService.setup(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "💰 Dinero"
	cash.Value = "$0"
	cash.Parent = ls
	local level = Instance.new("IntValue")
	level.Name = "⭐ Nivel"
	level.Value = 1
	level.Parent = ls
	ls.Parent = player
end

function LeaderboardService.update(player, data)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	local cash = ls:FindFirstChild("💰 Dinero")
	if cash then
		cash.Value = Format.cash(data.cash)
	end
	local level = ls:FindFirstChild("⭐ Nivel")
	if level then
		level.Value = Economy.empireLevel(data.runEarned)
	end
end

function LeaderboardService.start(map, getStates)
	local board = map:FindFirstChild("LeaderboardBoard", true)
	local label = nil
	if board then
		local gui = board:FindFirstChildOfClass("SurfaceGui")
		local frame = gui and gui:FindFirstChildOfClass("Frame")
		if frame then
			for _, c in ipairs(frame:GetChildren()) do
				if c:IsA("TextLabel") and c.TextXAlignment == Enum.TextXAlignment.Left then
					label = c
				end
			end
		end
	end
	task.spawn(function()
		while true do
			local rows = {}
			for player, state in pairs(getStates()) do
				if state.ready and player.Parent then
					table.insert(rows, { name = player.DisplayName, earned = state.data.lifetimeEarned, income = Economy.totalIncome(state.data, state.passes.x2) })
				end
			end
			table.sort(rows, function(a, b)
				return a.earned > b.earned
			end)
			local lines = {}
			local medals = { "🥇", "🥈", "🥉" }
			for i = 1, math.min(8, #rows) do
				local r = rows[i]
				table.insert(lines, string.format("%s %s  %s  (%s/s)", medals[i] or (i .. "."), r.name, Format.cash(r.earned), Format.cash(r.income)))
			end
			if #lines == 0 then
				lines = { "¡Sé el primero en el ranking!" }
			end
			if label then
				label.Text = table.concat(lines, "\n")
			end
			task.wait(8)
		end
	end)
	local _ = Players
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Compras con Robux: pases (decoracion, tema, x2) y productos de efectivo.
--  * ProcessReceipt se gestiona SOLO en el servidor.
--  * Cada recibo se registra en los datos del jugador y se guarda antes de
--    confirmar la compra -> sin duplicados aunque Roblox reintente.
--  * Con IDs = 0 y dentro de Roblox Studio, las compras se simulan para pruebas.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.TinyEmpireShared.Config)
local Economy = require(ReplicatedStorage.TinyEmpireShared.Economy)
local DataService = require(script.Parent.DataService)

local MonetizationService = {}

local api = nil -- { getState, onPassGranted, onCashGranted }
local processing = {} -- [PurchaseId] = true
local MAX_RECEIPTS = 200

local productByKey = Config.Products
local passKeyById = {}
local productKeyById = {}
for key, p in pairs(Config.GamePasses) do
	if p.id and p.id > 0 then
		passKeyById[p.id] = key
	end
end
for key, p in pairs(Config.Products) do
	if p.id and p.id > 0 then
		productKeyById[p.id] = key
	end
end

function MonetizationService.simulationAllowed()
	return RunService:IsStudio()
end

-- Comprueba los pases del jugador (reales y simulados en Studio)
function MonetizationService.loadPasses(player, data)
	local passes = { decor = false, theme = false, x2 = false }
	for key, p in pairs(Config.GamePasses) do
		if p.id and p.id > 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, p.id)
			end)
			if ok and owns then
				passes[key] = true
			end
		end
		if MonetizationService.simulationAllowed() and data.passes and data.passes[key] then
			passes[key] = true
		end
	end
	return passes
end

local function rememberReceipt(data, purchaseId)
	data.receipts[purchaseId] = os.time()
	table.insert(data.receiptOrder, purchaseId)
	while #data.receiptOrder > MAX_RECEIPTS do
		local old = table.remove(data.receiptOrder, 1)
		data.receipts[old] = nil
	end
end

-- Concede un producto de efectivo de forma idempotente
local function grantProduct(player, key, purchaseId)
	local state = api.getState(player)
	if not state or not state.data then
		return false
	end
	local data = state.data
	if data.receipts[purchaseId] then
		return true -- ya concedido antes
	end
	local reward = Economy.productReward(data, key, state.passes.x2)
	local previousCash = data.cash
	data.cash += reward
	rememberReceipt(data, purchaseId)
	if DataService.isPersistent(player) then
		if not DataService.forceSave(player) then
			-- No se pudo guardar: revertir y dejar que Roblox reintente
			data.cash = previousCash
			data.receipts[purchaseId] = nil
			local idx = table.find(data.receiptOrder, purchaseId)
			if idx then
				table.remove(data.receiptOrder, idx)
			end
			return false
		end
	end
	api.onCashGranted(player, reward, productByKey[key])
	return true
end

local function processReceipt(receiptInfo)
	local purchaseId = tostring(receiptInfo.PurchaseId)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local key = productKeyById[receiptInfo.ProductId]
	if not key then
		warn("[TinyEmpire] Producto desconocido: " .. tostring(receiptInfo.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Espera a que los datos esten cargados
	local t = 0
	while (not api.getState(player) or not api.getState(player).ready) and t < 20 and player.Parent do
		task.wait(0.5)
		t += 0.5
	end
	if not api.getState(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if processing[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	processing[purchaseId] = true
	local ok, granted = pcall(grantProduct, player, key, purchaseId)
	processing[purchaseId] = nil
	if ok and granted then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if not ok then
		warn("[TinyEmpire] Error en ProcessReceipt: " .. tostring(granted))
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function grantPass(player, key)
	local state = api.getState(player)
	if not state then
		return
	end
	if state.passes[key] then
		return
	end
	state.passes[key] = true
	api.onPassGranted(player, key)
end

-- Compra simulada (solo Studio y solo para articulos sin ID real)
function MonetizationService.simulate(player, kind, key)
	if not MonetizationService.simulationAllowed() then
		return false, "Las compras simuladas solo funcionan en Studio."
	end
	if kind == "pass" then
		local p = Config.GamePasses[key]
		if not p or (p.id and p.id > 0) then
			return false, "Pase no valido."
		end
		local state = api.getState(player)
		if not state then
			return false, "Datos no cargados."
		end
		state.data.passes[key] = true
		grantPass(player, key)
		return true
	elseif kind == "product" then
		local p = Config.Products[key]
		if not p or (p.id and p.id > 0) then
			return false, "Producto no valido."
		end
		local ok = grantProduct(player, key, "STUDIO-" .. HttpService:GenerateGUID(false))
		if ok then
			return true
		end
		return false, "No se pudo guardar la compra."
	end
	return false, "Tipo desconocido."
end

function MonetizationService.init(gameApi)
	api = gameApi
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = passKeyById[passId]
		if key then
			grantPass(player, key)
		end
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Asignacion de parcelas, botones de compra y reconstruccion visual.
-- Solo el dueno puede activar los botones de su parcela.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = script.Parent.Parent.World
local PlotBuilder = require(World.PlotBuilder)
local Palettes = require(World.Palettes)
local Config = require(ReplicatedStorage.TinyEmpireShared.Config)
local Economy = require(ReplicatedStorage.TinyEmpireShared.Economy)
local Format = require(ReplicatedStorage.TinyEmpireShared.Format)

local PlotService = {}

local plots = {} -- [index] = { def, model, pads, owner }
local byPlayer = {} -- [Player] = plot
local padHandler = nil -- function(player, plot, kind, target)
local nonOwnerWarned = {} -- [Player] = os.clock()

local GREEN = Color3.fromRGB(80, 230, 110)
local RED = Color3.fromRGB(240, 80, 80)
local BLUE = Color3.fromRGB(80, 170, 255)
local GOLD = Color3.fromRGB(255, 200, 60)

function PlotService.init(defs, parent, onPad)
	padHandler = onPad
	for _, def in ipairs(defs) do
		local model, pads = PlotBuilder.create(parent, def)
		local plot = { def = def, model = model, pads = pads, owner = nil, index = def.index }
		plots[def.index] = plot
		PlotBuilder.buildZones(model, def, 0)
		for key, pad in pairs(pads) do
			PlotBuilder.setPadVisible(pad.model, false)
			local debounce = {}
			pad.touch.Touched:Connect(function(hit)
				local character = hit.Parent
				local player = character and Players:GetPlayerFromCharacter(character)
				if not player then
					return
				end
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if not humanoid or humanoid.Health <= 0 then
					return
				end
				local now = os.clock()
				if debounce[player] and now - debounce[player] < 0.8 then
					return
				end
				debounce[player] = now
				if plot.owner ~= player then
					-- Proteccion: nadie puede modificar parcelas ajenas
					if not nonOwnerWarned[player] or now - nonOwnerWarned[player] > 4 then
						nonOwnerWarned[player] = now
						if padHandler then
							padHandler(player, nil, "notOwner", nil)
						end
					end
					return
				end
				if not pad.model:GetAttribute("Visible") then
					return
				end
				if padHandler then
					padHandler(player, plot, pad.model:GetAttribute("Kind"), pad.model:GetAttribute("Target"))
				end
			end)
			local _ = key
		end
		PlotBuilder.setOwnerText(model, "🏗️ PARCELA LIBRE")
		PlotBuilder.setStatsText(model, "Disponible")
	end
	Players.PlayerRemoving:Connect(function(player)
		nonOwnerWarned[player] = nil
	end)
end

function PlotService.assign(player)
	if byPlayer[player] then
		return byPlayer[player]
	end
	for i = 1, Config.MaxPlots do
		local plot = plots[i]
		if plot and plot.owner == nil then
			plot.owner = player
			byPlayer[player] = plot
			plot.model:SetAttribute("Owner", player.UserId)
			plot.model:SetAttribute("OwnerName", player.DisplayName)
			PlotBuilder.setOwnerText(plot.model, "🏠 " .. player.DisplayName, Color3.fromRGB(255, 240, 150))
			return plot
		end
	end
	return nil
end

function PlotService.get(player)
	return byPlayer[player]
end

function PlotService.all()
	return plots
end

function PlotService.release(player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	plot.owner = nil
	plot.model:SetAttribute("Owner", 0)
	plot.model:SetAttribute("OwnerName", "")
	plot.model.Buildings:ClearAllChildren()
	plot.model.Extras:ClearAllChildren()
	PlotBuilder.buildZones(plot.model, plot.def, 0)
	for _, pad in pairs(plot.pads) do
		PlotBuilder.setPadVisible(pad.model, false)
	end
	PlotBuilder.setOwnerText(plot.model, "🏗️ PARCELA LIBRE")
	PlotBuilder.setStatsText(plot.model, "Disponible")
end

function PlotService.palette(plot, state)
	local premium = state.passes.theme and (state.data.settings.theme ~= false)
	return Palettes.forPlot(plot.def.neighborhood, premium)
end

function PlotService.spawnCFrame(plot)
	return plot.def.cframe * PlotBuilder.SpawnOffset
end

-- Posicion local respecto a la parcela (para saber si un jugador esta dentro)
function PlotService.isInside(plot, position)
	local rel = plot.def.cframe:PointToObjectSpace(position)
	return math.abs(rel.X) <= 61 and math.abs(rel.Z) <= 61
end

function PlotService.buildBusiness(plot, state, id, animate)
	local level = state.data.businesses[id] or 0
	if level <= 0 then
		local existing = plot.model.Buildings:FindFirstChild(id)
		if existing then
			existing:Destroy()
		end
		return
	end
	local m = PlotBuilder.buildBusiness(plot.model, plot.def, id, level, PlotService.palette(plot, state))
	m:SetAttribute("Owner", state.player.UserId)
	if animate then
		m:SetAttribute("BuiltAt", workspace:GetServerTimeNow())
	end
	return m
end

-- Reconstruye la parcela entera a partir de los datos
function PlotService.rebuildAll(plot, state)
	plot.model.Buildings:ClearAllChildren()
	PlotBuilder.buildZones(plot.model, plot.def, state.data.expansions or 0)
	for _, b in ipairs(Config.Businesses) do
		if (state.data.businesses[b.id] or 0) > 0 then
			PlotService.buildBusiness(plot, state, b.id, false)
		end
	end
	PlotService.rebuildExtras(plot, state)
	PlotService.updateIncomeAttributes(plot, state)
	PlotService.updatePads(plot, state)
end

function PlotService.rebuildExtras(plot, state)
	PlotBuilder.buildExtras(plot.model, plot.def, state.data, PlotService.palette(plot, state), state.passes.decor)
end

function PlotService.rebuildZones(plot, state)
	PlotBuilder.buildZones(plot.model, plot.def, state.data.expansions or 0)
end

-- Atributo de ingreso por edificio (el cliente muestra "+$" flotantes)
function PlotService.updateIncomeAttributes(plot, state)
	for _, m in ipairs(plot.model.Buildings:GetChildren()) do
		local id = m:GetAttribute("Business")
		if id then
			m:SetAttribute("Income", Economy.businessIncome(state.data, id, state.passes.x2))
		end
	end
end

-- Actualiza colores y textos de los botones segun el dinero actual
function PlotService.updatePads(plot, state)
	local data = state.data
	local cash = data.cash
	for _, b in ipairs(Config.Businesses) do
		local pad = plot.pads[b.id].model
		local st = Economy.businessState(data, b.id)
		if st == "available" then
			PlotBuilder.setPadVisible(pad, true)
			local afford = cash >= b.cost
			PlotBuilder.setPadStyle(pad, b.icon .. " " .. b.name, b.cost == 0 and "¡GRATIS!" or Format.cash(b.cost), afford and GREEN or RED)
		elseif st == "owned" then
			local level = data.businesses[b.id]
			local cost = Economy.levelUpCost(b.id, level)
			if cost then
				PlotBuilder.setPadVisible(pad, true)
				local afford = cash >= cost
				PlotBuilder.setPadStyle(pad, "⬆️ Nivel " .. (level + 1), Format.cash(cost), afford and BLUE or RED)
			else
				PlotBuilder.setPadVisible(pad, false)
			end
		else
			PlotBuilder.setPadVisible(pad, false)
		end
	end
	for i, exp in ipairs(Config.Expansions) do
		local pad = plot.pads["exp" .. i].model
		local st, reason = Economy.expansionState(data, i)
		if st == "available" then
			PlotBuilder.setPadVisible(pad, true)
			PlotBuilder.setPadStyle(pad, "🚧 " .. exp.name, Format.cash(exp.cost), cash >= exp.cost and GOLD or RED)
		elseif st == "locked" and (data.expansions or 0) == i - 1 then
			PlotBuilder.setPadVisible(pad, true)
			PlotBuilder.setPadStyle(pad, "🔒 " .. exp.name, reason, Color3.fromRGB(130, 130, 140))
		else
			PlotBuilder.setPadVisible(pad, false)
		end
	end
end

function PlotService.updateStats(plot, state, income)
	PlotBuilder.setStatsText(plot.model, "💰 " .. Format.cash(income) .. "/s")
end

return PlotService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Buildings</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Constructores procedurales de los 10 negocios. Cada negocio crece de forma
-- visible en sus 5 niveles. El frente del edificio mira hacia -Z local.
--
-- Etiquetas de animacion (las anima el cliente, ver Client/Animator):
--   TE_Spin  (SpinSpeed grados/s, SpinAxis "X"|"Y"|"Z")
--   TE_Bob   (BobHeight, BobSpeed)
--   TE_Slide (SlideOffset Vector3 local, SlideSpeed, SlideMode "pingpong"|"loop")
--   TE_Pulse (PulseSpeed) neon que parpadea suavemente

local Kit = require(script.Parent.Kit)
local Details = require(script.Parent.Details)

local Buildings = {}

local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(45, 45, 55)
local METAL = Color3.fromRGB(150, 155, 165)
local GLASS = Color3.fromRGB(160, 215, 245)
local CONCRETE = Color3.fromRGB(200, 200, 205)

local function spin(inst, speed, axis)
	inst:AddTag("TE_Spin")
	inst:SetAttribute("SpinSpeed", speed)
	inst:SetAttribute("SpinAxis", axis or "Y")
	return inst
end

local function bob(inst, height, speed)
	inst:AddTag("TE_Bob")
	inst:SetAttribute("BobHeight", height or 1)
	inst:SetAttribute("BobSpeed", speed or 1)
	return inst
end

local function slide(inst, offset, speed, mode)
	inst:AddTag("TE_Slide")
	inst:SetAttribute("SlideOffset", offset)
	inst:SetAttribute("SlideSpeed", speed or 0.3)
	inst:SetAttribute("SlideMode", mode or "pingpong")
	return inst
end

local function pulse(inst, speed)
	inst:AddTag("TE_Pulse")
	inst:SetAttribute("PulseSpeed", speed or 1)
	return inst
end

-- Losa de cimentacion
local function foundation(m, cf, w, d, color)
	Kit.box(m, "Foundation", Vector3.new(w, 0.6, d), cf * CFrame.new(0, 0.3, 0), color or CONCRETE, Enum.Material.Concrete)
end

-- Bloque con ventanas. Devuelve la altura del techo.
local function block(m, cf, w, d, h, y0, wall, opts)
	opts = opts or {}
	local center = cf * CFrame.new(opts.x or 0, y0 + h / 2, opts.z or 0)
	Kit.box(m, opts.name or "Wall", Vector3.new(w, h, d), center, wall, opts.material or Enum.Material.SmoothPlastic)
	if opts.windows ~= false then
		local rows = opts.rows or math.max(1, math.floor(h / 4.5))
		local cols = opts.cols or math.max(1, math.floor(w / 4))
		local winColor = opts.windowColor or GLASS
		Kit.windows(m, center * CFrame.new(0, 0, -d / 2 - 0.1), w - 1.5, h - 1.2, rows, cols, winColor, opts.sill)
		if opts.sideWindows ~= false then
			local sideCols = math.max(1, math.floor(d / 4))
			Kit.windows(m, center * CFrame.new(w / 2 + 0.1, 0, 0) * CFrame.Angles(0, math.rad(-90), 0), d - 1.5, h - 1.2, rows, sideCols, winColor)
			Kit.windows(m, center * CFrame.new(-w / 2 - 0.1, 0, 0) * CFrame.Angles(0, math.rad(90), 0), d - 1.5, h - 1.2, rows, sideCols, winColor)
		end
	end
	if opts.trim then
		Kit.box(m, "Trim", Vector3.new(w + 0.6, 0.6, d + 0.6), cf * CFrame.new(opts.x or 0, y0 + h + 0.3, opts.z or 0), opts.trim)
	end
	return y0 + h + (opts.trim and 0.6 or 0)
end

-- Tejado a dos aguas (cumbrera a lo largo de X)
local function gable(m, cf, w, d, rh, y, color, x, z)
	x = x or 0
	z = z or 0
	Kit.wedge(m, "Roof", Vector3.new(w + 1, rh, d / 2 + 0.5), cf * CFrame.new(x, y + rh / 2, z - d / 4 - 0.25), color, Enum.Material.SmoothPlastic)
	Kit.wedge(m, "Roof", Vector3.new(w + 1, rh, d / 2 + 0.5), cf * CFrame.new(x, y + rh / 2, z + d / 4 + 0.25) * CFrame.Angles(0, math.rad(180), 0), color, Enum.Material.SmoothPlastic)
end

local function door(m, cf, x, z, color, w, h)
	w = w or 3
	h = h or 5
	Kit.box(m, "Door", Vector3.new(w, h, 0.4), cf * CFrame.new(x, 0.6 + h / 2, z - 0.2), color or Color3.fromRGB(120, 80, 55), Enum.Material.Wood)
	Kit.box(m, "DoorFrame", Vector3.new(w + 0.8, 0.5, 0.6), cf * CFrame.new(x, 0.6 + h + 0.25, z - 0.25), WHITE)
end

-- Letrero de fachada con el nombre del negocio
local function frontSign(m, cf, text, y, z, w, bg, fg)
	local s = Kit.box(m, "Sign", Vector3.new(w, 2.4, 0.4), cf * CFrame.new(0, y, z - 0.3), bg or WHITE)
	Kit.surfaceText(s, text, Enum.NormalId.Front, bg or WHITE, fg or DARK)
	return s
end

local function table_(m, cf, umbrella)
	Kit.cylinder(m, "Table", 0.3, 3.2, cf * CFrame.new(0, 2.6, 0), WHITE)
	Kit.cylinder(m, "TableLeg", 2.5, 0.4, cf * CFrame.new(0, 1.3, 0), DARK, Enum.Material.Metal)
	for i = 0, 1 do
		local a = math.rad(90 + i * 180)
		Kit.box(m, "Stool", Vector3.new(1.4, 1.6, 1.4), cf * CFrame.new(math.cos(a) * 2.6, 0.8, math.sin(a) * 2.6), Color3.fromRGB(230, 90, 80))
	end
	if umbrella then
		Kit.cylinder(m, "UmbrellaPole", 5, 0.3, cf * CFrame.new(0, 5, 0), WHITE)
		Kit.cylinder(m, "Umbrella", 0.6, 7, cf * CFrame.new(0, 7.4, 0), umbrella, Enum.Material.Fabric)
		Kit.cylinder(m, "UmbrellaTop", 0.6, 4, cf * CFrame.new(0, 7.9, 0), umbrella:Lerp(WHITE, 0.4), Enum.Material.Fabric)
	end
end

local function crates(m, cf, nx, ny, color)
	for i = 0, nx - 1 do
		for j = 0, ny - 1 do
			Kit.box(m, "Crate", Vector3.new(2.4, 2.4, 2.4), cf * CFrame.new(i * 2.6, 1.2 + j * 2.45, 0) * CFrame.Angles(0, math.rad((i * 13 + j * 7) % 15), 0), color or Color3.fromRGB(190, 140, 80), Enum.Material.Wood)
		end
	end
end

local function chimney(m, cf, x, z, h, y, color)
	local c = Kit.box(m, "Chimney", Vector3.new(2, h, 2), cf * CFrame.new(x, y + h / 2, z), color or Color3.fromRGB(150, 80, 70), Enum.Material.Brick)
	local top = Kit.box(m, "ChimneyTop", Vector3.new(2.4, 0.5, 2.4), cf * CFrame.new(x, y + h + 0.25, z), DARK)
	Kit.smoke(top, Color3.fromRGB(235, 235, 240), 3)
	return c
end

local function stringLights(m, a, b, n, color)
	for i = 0, n do
		local p = a:Lerp(b, i / n) - Vector3.new(0, math.sin(math.pi * i / n) * 1.2, 0)
		local bulb = Kit.ball(m, "Bulb", 0.6, CFrame.new(p), color or Color3.fromRGB(255, 230, 150), Enum.Material.Neon, { CanCollide = false, CastShadow = false })
		if i % 3 == 0 then
			Kit.light(bulb, color or Color3.fromRGB(255, 220, 150), 10, 1)
		end
	end
	local mid = (a + b) / 2
	Kit.box(m, "Wire", Vector3.new(0.1, 0.1, (b - a).Magnitude), CFrame.lookAt(mid, b), DARK, Enum.Material.SmoothPlastic, { CanCollide = false })
end

-- Engranaje (modelo que gira)
local function gear(m, cf, diameter, color, speed)
	local g = Kit.model(m, "Gear")
	Kit.cylinderX(g, "Disc", 0.6, diameter, cf * CFrame.Angles(0, math.rad(90), 0), color, Enum.Material.Metal)
	for i = 0, 7 do
		local a = math.rad(i * 45)
		Kit.box(g, "Tooth", Vector3.new(diameter * 0.18, diameter * 0.18, 0.6), cf * CFrame.Angles(0, 0, a) * CFrame.new(0, diameter / 2, 0), color, Enum.Material.Metal)
	end
	Kit.cylinderX(g, "Hub", 0.8, diameter * 0.3, cf * CFrame.Angles(0, math.rad(90), 0), DARK, Enum.Material.Metal)
	g.WorldPivot = cf
	spin(g, speed or 60, "Z")
	return g
end

-- Cinta transportadora con cajas que avanzan en bucle
local function conveyor(m, cf, length, itemColor, items)
	Kit.box(m, "Belt", Vector3.new(length, 0.4, 3), cf * CFrame.new(0, 2.2, 0), Color3.fromRGB(40, 40, 45), Enum.Material.Metal)
	Kit.box(m, "BeltFrame", Vector3.new(length, 2, 0.4), cf * CFrame.new(0, 1, 1.5), METAL, Enum.Material.Metal)
	Kit.box(m, "BeltFrame", Vector3.new(length, 2, 0.4), cf * CFrame.new(0, 1, -1.5), METAL, Enum.Material.Metal)
	items = items or 4
	for i = 1, items do
		local start = -length / 2 + 1
		local item = Kit.box(m, "Product", Vector3.new(1.6, 1.6, 1.6), cf * CFrame.new(start, 3.2, 0), itemColor or Color3.fromRGB(240, 180, 90), Enum.Material.SmoothPlastic, { CanCollide = false })
		slide(item, Vector3.new(length - 2, 0, 0), 0.15, "loop")
		item:SetAttribute("SlidePhase", (i - 1) / items)
	end
end

------------------------------------------------------------------------------
-- NEGOCIOS
------------------------------------------------------------------------------

local builders = {}

builders.lemonade = function(m, cf, L, pal, S)
	local yellow = Color3.fromRGB(255, 225, 70)
	foundation(m, cf, S - 2, S - 2, pal.path)
	-- Puesto
	local stand = cf * CFrame.new(0, 0, -3)
	Kit.box(m, "Counter", Vector3.new(8, 3.4, 3.4), stand * CFrame.new(0, 2.3, 0), Color3.fromRGB(255, 250, 235), Enum.Material.Wood)
	Kit.box(m, "CounterTop", Vector3.new(8.6, 0.4, 3.8), stand * CFrame.new(0, 4.2, 0), yellow)
	for _, x in ipairs({ -3.8, 3.8 }) do
		Kit.box(m, "Post", Vector3.new(0.5, 4.5, 0.5), stand * CFrame.new(x, 6.5, 1.4), Color3.fromRGB(170, 120, 80), Enum.Material.Wood)
	end
	Kit.awning(m, stand * CFrame.new(0, 9.2, -0.6), 9, 4.4, yellow, WHITE)
	local sign = Kit.box(m, "Sign", Vector3.new(7, 1.8, 0.4), stand * CFrame.new(0, 10.8, 1.4), WHITE)
	Kit.surfaceText(sign, "🍋 LIMONADA", Enum.NormalId.Front, WHITE, Color3.fromRGB(230, 160, 0))
	Kit.cylinder(m, "Jug", 1.6, 1.4, stand * CFrame.new(-2, 5.2, 0), Color3.fromRGB(255, 240, 120), Enum.Material.Glass, { Transparency = 0.2 })
	Kit.cylinder(m, "Cup", 0.8, 0.7, stand * CFrame.new(1, 4.8, -0.5), WHITE)
	Kit.cylinder(m, "Cup", 0.8, 0.7, stand * CFrame.new(2, 4.8, -0.5), WHITE)
	local lemon = Kit.ball(m, "BigLemon", 2.4, stand * CFrame.new(0, 13, 1.4), yellow, Enum.Material.SmoothPlastic, { CanCollide = false })
	bob(lemon, 0.8, 1.2)
	if L >= 2 then
		table_(m, cf * CFrame.new(-6, 0, -6.5), Color3.fromRGB(255, 220, 60))
		table_(m, cf * CFrame.new(6, 0, -6.5), Color3.fromRGB(120, 210, 90))
	end
	if L >= 3 then
		local back = cf * CFrame.new(0, 0, 5)
		local top = block(m, back, 12, 6, 7, 0.6, pal.wall, { windows = true, rows = 1, cols = 2, trim = yellow, sideWindows = false })
		gable(m, back, 12, 6, 2.5, top, yellow)
		Kit.bush(m, cf * CFrame.new(-8, 0.6, 2))
		Kit.bush(m, cf * CFrame.new(8, 0.6, 2))
	end
	if L >= 4 then
		stringLights(m, (cf * CFrame.new(-8.5, 8, -8.5)).Position, (cf * CFrame.new(8.5, 8, -8.5)).Position, 9)
		for _, x in ipairs({ -8.5, 8.5 }) do
			Kit.cylinder(m, "LightPole", 8, 0.4, cf * CFrame.new(x, 4, -8.5), DARK, Enum.Material.Metal)
		end
	end
	if L >= 5 then
		local big = Kit.model(m, "SpinningLemon")
		local c = cf * CFrame.new(0, 18, 5)
		Kit.ball(big, "Lemon", 5, c, yellow, Enum.Material.SmoothPlastic, { CanCollide = false })
		Kit.ball(big, "LemonTip", 1.6, c * CFrame.new(2.6, 0, 0), yellow, Enum.Material.SmoothPlastic, { CanCollide = false })
		Kit.box(big, "Leaf", Vector3.new(0.3, 1.2, 2.2), c * CFrame.new(-1, 2.6, 0), Color3.fromRGB(80, 180, 70), Enum.Material.SmoothPlastic, { CanCollide = false })
		big.WorldPivot = c
		spin(big, 45, "Y")
		Kit.cylinder(m, "Pole", 4, 0.6, cf * CFrame.new(0, 15, 5), WHITE)
		Kit.sparkles(Kit.box(m, "SparkleSrc", Vector3.new(1, 1, 1), c, WHITE, Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false }), yellow, 5)
	end
end

local function truck(m, cf, color, label)
	local t = Kit.model(m, "FoodTruck")
	Kit.box(t, "Body", Vector3.new(12, 6, 5.5), cf * CFrame.new(0, 4.2, 0), color)
	Kit.box(t, "Cab", Vector3.new(3.6, 4.2, 5.5), cf * CFrame.new(-7.6, 3.3, 0), color:Lerp(WHITE, 0.2))
	Kit.box(t, "Windshield", Vector3.new(0.3, 2, 4.8), cf * CFrame.new(-9.45, 4, 0), GLASS, Enum.Material.Glass, { Transparency = 0.2 })
	Kit.box(t, "Hatch", Vector3.new(7, 2.6, 0.3), cf * CFrame.new(0.5, 5, -2.8), Color3.fromRGB(40, 30, 30))
	Kit.box(t, "Shelf", Vector3.new(7.4, 0.3, 1.4), cf * CFrame.new(0.5, 3.6, -3.4), Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
	Kit.awning(t, cf * CFrame.new(0.5, 7.2, -4), 8, 2.8, WHITE, color:Lerp(Color3.new(1, 0.2, 0.2), 0.4))
	for _, x in ipairs({ -7.5, 3.5 }) do
		for _, z in ipairs({ -2.6, 2.6 }) do
			Kit.cylinderX(t, "Wheel", 1, 2.4, cf * CFrame.new(x, 1.2, z) * CFrame.Angles(0, math.rad(90), 0), DARK)
		end
	end
	local sign = Kit.box(t, "RoofSign", Vector3.new(8, 2, 0.4), cf * CFrame.new(0, 8.3, 0), WHITE)
	Kit.surfaceText(sign, label, Enum.NormalId.Front, WHITE, color)
	return t
end

builders.foodtruck = function(m, cf, L, pal, S)
	foundation(m, cf, S - 2, S - 2, Color3.fromRGB(80, 80, 90))
	-- Lineas de aparcamiento
	for _, x in ipairs({ -7, 7 }) do
		Kit.box(m, "Line", Vector3.new(0.4, 0.05, 8), cf * CFrame.new(x, 0.62, 3), WHITE, Enum.Material.SmoothPlastic, { CanCollide = false })
	end
	truck(m, cf * CFrame.new(0.5, 0.6, 1.5), Color3.fromRGB(255, 120, 80), "🌮 TACOS")
	local menu = Kit.box(m, "Menu", Vector3.new(3, 4, 0.3), cf * CFrame.new(-6.5, 2.6, -5), DARK)
	Kit.surfaceText(menu, "MENÚ\nTacos $2\nNachos $3", Enum.NormalId.Front, DARK, Color3.fromRGB(255, 230, 120))
	local taco = Kit.model(m, "Taco")
	local tc = cf * CFrame.new(0.5, 12, 1.5)
	Kit.cylinderX(taco, "Shell", 0.8, 3.2, tc, Color3.fromRGB(245, 200, 90))
	Kit.ball(taco, "Filling", 1.2, tc * CFrame.new(0, 0.8, 0), Color3.fromRGB(110, 200, 80))
	taco.WorldPivot = tc
	bob(taco, 0.7, 1.4)
	if L >= 2 then
		table_(m, cf * CFrame.new(6, 0, -6), Color3.fromRGB(255, 90, 90))
		Kit.cylinder(m, "Bin", 2.4, 1.6, cf * CFrame.new(-8.5, 1.8, -7), Color3.fromRGB(70, 150, 90))
	end
	if L >= 3 then
		local pav = cf * CFrame.new(0, 0, -6.5)
		for _, x in ipairs({ -9, 9 }) do
			Kit.box(m, "PavPost", Vector3.new(0.6, 7, 0.6), pav * CFrame.new(x, 4, -2), Color3.fromRGB(150, 110, 70), Enum.Material.Wood)
		end
		Kit.box(m, "PavRoof", Vector3.new(19, 0.5, 4), pav * CFrame.new(0, 7.6, -1.5), Color3.fromRGB(255, 140, 90), Enum.Material.Fabric)
	end
	if L >= 4 then
		truck(m, cf * CFrame.new(0.5, 0.6, 8.5) * CFrame.Angles(0, math.rad(180), 0), pal.accent2, "🍔 BURGERS")
	end
	if L >= 5 then
		stringLights(m, (cf * CFrame.new(-9, 7.5, -8.5)).Position, (cf * CFrame.new(9, 7.5, -8.5)).Position, 10, Color3.fromRGB(255, 120, 200))
		local arch = Kit.box(m, "Arch", Vector3.new(14, 2.6, 0.6), cf * CFrame.new(0, 15.5, 1.5), Color3.fromRGB(255, 80, 120), Enum.Material.Neon)
		Kit.surfaceText(arch, "FOOD COURT", Enum.NormalId.Front, nil, WHITE)
		pulse(arch, 1.5)
		Kit.cylinder(m, "ArchPole", 7, 0.5, cf * CFrame.new(-6, 11, 1.5), DARK, Enum.Material.Metal)
		Kit.cylinder(m, "ArchPole", 7, 0.5, cf * CFrame.new(6, 11, 1.5), DARK, Enum.Material.Metal)
	end
end

builders.bakery = function(m, cf, L, pal, S)
	foundation(m, cf, S - 2, S - 2, pal.path)
	local wall = Color3.fromRGB(245, 225, 190)
	local floors = L >= 3 and 2 or 1
	local body = cf * CFrame.new(0, 0, 2)
	local top = block(m, body, 13, 9, 7 * floors, 0.6, wall, { rows = floors, cols = 3, trim = Color3.fromRGB(140, 90, 60), sill = Color3.fromRGB(140, 90, 60), material = Enum.Material.Brick })
	gable(m, body, 13, 9, 4, top, Color3.fromRGB(170, 70, 50))
	door(m, body, 0, -4.5, Color3.fromRGB(150, 90, 50))
	frontSign(m, body, "🥐 PANADERÍA", 7.6 * floors - 0.5, -4.5, 9, Color3.fromRGB(140, 90, 60), Color3.fromRGB(255, 235, 200))
	chimney(m, body, 4, 2, 4, top, Color3.fromRGB(170, 90, 70))
	local bread = Kit.model(m, "Croissant")
	local bc = cf * CFrame.new(-7, 4, -7)
	Kit.ball(bread, "Bun", 2, bc, Color3.fromRGB(225, 160, 80))
	Kit.ball(bread, "BunL", 1.4, bc * CFrame.new(-1.1, -0.2, 0), Color3.fromRGB(215, 145, 70))
	Kit.ball(bread, "BunR", 1.4, bc * CFrame.new(1.1, -0.2, 0), Color3.fromRGB(215, 145, 70))
	bread.WorldPivot = bc
	bob(bread, 0.6, 1)
	Kit.cylinder(m, "Stand", 2.6, 1.2, cf * CFrame.new(-7, 1.9, -7), WHITE)
	if L >= 2 then
		Kit.awning(m, body * CFrame.new(0, 6.2, -5.8), 12, 2.6, Color3.fromRGB(200, 80, 60), WHITE)
		crates(m, cf * CFrame.new(4, 0.6, -6.5), 2, 1, Color3.fromRGB(200, 150, 90))
	end
	if L >= 4 then
		local side = cf * CFrame.new(0, 0, 8)
		local ovenTop = block(m, side, 10, 4, 5, 0.6, Color3.fromRGB(180, 110, 80), { windows = false, material = Enum.Material.Brick })
		local glow = Kit.box(m, "OvenGlow", Vector3.new(4, 2, 0.3), side * CFrame.new(5.1, 3, 0) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 140, 40), Enum.Material.Neon)
		pulse(glow, 0.8)
		chimney(m, side, -3, 0, 3, ovenTop, Color3.fromRGB(150, 80, 70))
	end
	if L >= 5 then
		local mill = Kit.model(m, "Windmill")
		local hub = body * CFrame.new(0, top + 3, -5)
		Kit.cylinderX(mill, "Hub", 1, 1.4, hub * CFrame.Angles(0, math.rad(90), 0), DARK)
		for i = 0, 3 do
			Kit.box(mill, "Blade", Vector3.new(1.4, 7, 0.2), hub * CFrame.Angles(0, 0, math.rad(i * 90)) * CFrame.new(0, 3.8, -0.3), Color3.fromRGB(255, 250, 240), Enum.Material.Fabric)
		end
		mill.WorldPivot = hub
		spin(mill, 50, "Z")
	end
end

builders.cafe = function(m, cf, L, pal, S)
	foundation(m, cf, S - 2, S - 2, Color3.fromRGB(215, 205, 190))
	local brown = Color3.fromRGB(120, 80, 60)
	local floors = (L >= 5 and 3) or (L >= 3 and 2) or 1
	local body = cf * CFrame.new(0, 0, 3)
	local top = block(m, body, 14, 10, 6.5 * floors, 0.6, Color3.fromRGB(235, 220, 200), { rows = floors, cols = 3, trim = brown, material = Enum.Material.Concrete })
	-- Escaparate grande
	Kit.box(m, "Storefront", Vector3.new(10, 4.5, 0.3), body * CFrame.new(0, 3, -5.15), GLASS, Enum.Material.Glass, { Transparency = 0.25 })
	door(m, body, 5.5, -5, brown, 2.2, 4.5)
	frontSign(m, body, "☕ CAFETERÍA", top - 1.5, -5, 10, brown, Color3.fromRGB(255, 230, 190))
	Kit.awning(m, body * CFrame.new(0, 6.3, -6.4), 13, 2.6, Color3.fromRGB(80, 140, 90), WHITE)
	-- Taza gigante
	local cup = Kit.model(m, "BigCup")
	local cc = body * CFrame.new(0, top + 2.4, 0)
	Kit.cylinder(cup, "Cup", 3.6, 4, cc, WHITE)
	Kit.cylinder(cup, "Coffee", 0.2, 3.5, cc * CFrame.new(0, 1.75, 0), Color3.fromRGB(90, 55, 35))
	local handle = Kit.box(cup, "Handle", Vector3.new(1.2, 2, 0.6), cc * CFrame.new(2.3, 0, 0), WHITE)
	Kit.smoke(handle, Color3.fromRGB(255, 255, 255), 2)
	cup.WorldPivot = cc
	bob(cup, 0.5, 0.8)
	if L >= 2 then
		table_(m, cf * CFrame.new(-5, 0, -6), Color3.fromRGB(80, 140, 90))
		table_(m, cf * CFrame.new(5, 0, -6), Color3.fromRGB(80, 140, 90))
	end
	if L >= 4 then
		for i = -1, 1 do
			Kit.flowerBed(m, body * CFrame.new(i * 4.2, top, 3.5), 3.6, 2.2)
		end
		Kit.tree(m, body * CFrame.new(-5.5, top, 3), "round")
	end
	if L >= 5 then
		local neon = Kit.box(m, "NeonBean", Vector3.new(3, 4, 0.4), body * CFrame.new(-7.3, top - 3, -3) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 160, 60), Enum.Material.Neon)
		pulse(neon, 1.2)
	end
end

builders.toystore = function(m, cf, L, pal, S)
	foundation(m, cf, S - 2, S - 2, Color3.fromRGB(255, 240, 250))
	local rainbow = {
		Color3.fromRGB(255, 90, 90),
		Color3.fromRGB(255, 170, 60),
		Color3.fromRGB(255, 230, 80),
		Color3.fromRGB(110, 210, 110),
		Color3.fromRGB(90, 170, 255),
		Color3.fromRGB(180, 110, 255),
	}
	local floors = L >= 3 and 2 or 1
	local body = cf * CFrame.new(0, 0, 3)
	local h = 7.5 * floors
	local top = block(m, body, 16, 12, h, 0.6, Color3.fromRGB(255, 200, 230), { rows = floors, cols = 4, trim = WHITE })
	for i, c in ipairs(rainbow) do
		Kit.box(m, "Stripe", Vector3.new(16.4, 0.5, 0.2), body * CFrame.new(0, 0.6 + h - i * 0.5 + 0.25, -6.15), c, Enum.Material.SmoothPlastic)
	end
	door(m, body, 0, -6, Color3.fromRGB(255, 90, 140), 3.4, 5)
	frontSign(m, body, "🧸 JUGUETERÍA", top + 1.6, -5.4, 12, Color3.fromRGB(255, 90, 160), WHITE)
	-- Osito gigante
	local bear = Kit.model(m, "Teddy")
	local tc = body * CFrame.new(4, top + 3, 1)
	local fur = Color3.fromRGB(190, 130, 80)
	Kit.ball(bear, "Body", 4.2, tc, fur)
	Kit.ball(bear, "Head", 3.2, tc * CFrame.new(0, 3.2, 0), fur)
	Kit.ball(bear, "EarL", 1.3, tc * CFrame.new(-1.3, 4.6, 0), fur)
	Kit.ball(bear, "EarR", 1.3, tc * CFrame.new(1.3, 4.6, 0), fur)
	Kit.ball(bear, "Snout", 1.3, tc * CFrame.new(0, 2.9, -1.4), Color3.fromRGB(240, 210, 170))
	Kit.ball(bear, "Bow", 1, tc * CFrame.new(0, 1.8, -1.6), Color3.fromRGB(255, 70, 120))
	bear.WorldPivot = tc
	bob(bear, 0.6, 0.9)
	-- Molinillo
	local pin = Kit.model(m, "Pinwheel")
	local pc = body * CFrame.new(-5, top + 4, -2)
	for i = 0, 3 do
		Kit.wedge(pin, "Vane", Vector3.new(0.2, 2.6, 2.6), pc * CFrame.Angles(0, 0, math.rad(i * 90)) * CFrame.new(0, 1.3, 0) * CFrame.Angles(0, math.rad(90), 0), rainbow[i + 1])
	end
	pin.WorldPivot = pc
	spin(pin, 120, "Z")
	Kit.cylinder(m, "PinStick", 4, 0.3, body * CFrame.new(-5, top + 2, -1.8), WHITE)
	if L >= 2 then
		for i = 1, 5 do
			local b = Kit.ball(m, "Balloon", 1.8, cf * CFrame.new(-9 + i * 3, 9 + (i % 2), -9), rainbow[i], Enum.Material.SmoothPlastic, { CanCollide = false })
			bob(b, 0.6, 0.7 + i * 0.1)
		end
	end
	if L >= 4 then
		local car = Kit.model(m, "Carousel")
		local cc = cf * CFrame.new(-8.5, 0.6, -6)
		Kit.cylinder(car, "Base", 0.8, 6, cc * CFrame.new(0, 0.4, 0), Color3.fromRGB(255, 220, 240))
		Kit.cylinder(car, "Pole", 5, 0.5, cc * CFrame.new(0, 3, 0), Color3.fromRGB(255, 215, 0), Enum.Material.Metal)
		Kit.cylinder(car, "Top", 0.8, 6.4, cc * CFrame.new(0, 5.6, 0), Color3.fromRGB(255, 120, 170))
		for i = 0, 3 do
			local a = math.rad(i * 90)
			Kit.ball(car, "Horse", 1.4, cc * CFrame.new(math.cos(a) * 2.2, 2.4, math.sin(a) * 2.2), rainbow[i + 2])
		end
		car.WorldPivot = cc
		spin(car, 40, "Y")
	end
	if L >= 5 then
		local neon = Kit.box(m, "NeonStar", Vector3.new(3, 3, 0.5), body * CFrame.new(-4, top + 3, -3), Color3.fromRGB(255, 240, 80), Enum.Material.Neon)
		spin(neon, 90, "Z")
		Kit.sparkles(neon, Color3.fromRGB(255, 240, 120), 8)
	end
end

builders.workshop = function(m, cf, L, pal, S)
	foundation(m, cf, S - 2, S - 2, Color3.fromRGB(150, 150, 155))
	local body = cf * CFrame.new(0, 0, 3)
	local wall = pal.wall2
	local top = block(m, body, 18, 13, 9, 0.6, wall, { rows = 1, cols = 4, material = Enum.Material.Metal, sideWindows = false })
	-- Tejado en dientes de sierra
	for i = 0, 2 do
		Kit.wedge(m, "SawRoof", Vector3.new(18, 3, 13 / 3), body * CFrame.new(0, top + 1.5, -13 / 2 + 13 / 6 + i * 13 / 3), Color3.fromRGB(90, 95, 105), Enum.Material.Metal)
	end
	Kit.box(m, "RollDoor", Vector3.new(8, 6.5, 0.3), body * CFrame.new(-3, 3.85, -6.65), Color3.fromRGB(200, 205, 210), Enum.Material.DiamondPlate)
	frontSign(m, body, "🔧 TALLER", 8.4, -6.5, 7, pal.accent, WHITE)
	gear(m, body * CFrame.new(5.5, 5.5, -6.9), 4, Color3.fromRGB(255, 190, 40), 70)
	chimney(m, body, 6, 4, 6, top, Color3.fromRGB(100, 100, 110))
	if L >= 2 then
		for _, x in ipairs({ -7, -2 }) do
			Kit.box(m, "Bench", Vector3.new(4, 0.4, 2), cf * CFrame.new(x, 3, -7), Color3.fromRGB(150, 100, 60), Enum.Material.Wood)
			Kit.box(m, "BenchLeg", Vector3.new(3.6, 2.4, 1.6), cf * CFrame.new(x, 1.8, -7), DARK, Enum.Material.Metal)
		end
	end
	if L >= 3 then
		conveyor(m, cf * CFrame.new(5.5, 0.6, -8), 9, Color3.fromRGB(240, 170, 70), 3)
	end
	if L >= 4 then
		chimney(m, body, -6, 4, 7, top, Color3.fromRGB(100, 100, 110))
		gear(m, body * CFrame.new(8, 7, -6.9), 2.6, Color3.fromRGB(200, 200, 210), -110)
	end
	if L >= 5 then
		local crane = Kit.model(m, "Crane")
		local base = body * CFrame.new(-7, top, 2)
		Kit.box(m, "CraneMast", Vector3.new(1.2, 8, 1.2), base * CFrame.new(0, 4, 0), Color3.fromRGB(255, 200, 40), Enum.Material.Metal)
		local pivot = base * CFrame.new(0, 8.4, 0)
		Kit.box(crane, "Jib", Vector3.new(12, 0.8, 0.8), pivot * CFrame.new(4, 0, 0), Color3.fromRGB(255, 200, 40), Enum.Material.Metal)
		Kit.box(crane, "Hook", Vector3.new(0.6, 3, 0.6), pivot * CFrame.new(9, -1.8, 0), DARK, Enum.Material.Metal)
		crane.WorldPivot = pivot
		spin(crane, 15, "Y")
	end
end

local function forklift(m, cf, color)
	local f = Kit.model(m, "Forklift")
	Kit.box(f, "Body", Vector3.new(3, 2, 4), cf * CFrame.new(0, 1.6, 0), color or Color3.fromRGB(255, 190, 40))
	Kit.box(f, "Cage", Vector3.new(3, 2.4, 0.3), cf * CFrame.new(0, 3.8, 1.2), DARK, Enum.Material.Metal)
	Kit.box(f, "Mast", Vector3.new(2.4, 4.5, 0.3), cf * CFrame.new(0, 2.6, -2.2), DARK, Enum.Material.Metal)
	Kit.box(f, "Fork", Vector3.new(2.4, 0.2, 2.4), cf * CFrame.new(0, 0.9, -3.4), DARK, Enum.Material.Metal)
	Kit.box(f, "Load", Vector3.new(2.2, 2, 2.2), cf * CFrame.new(0, 2, -3.4), Color3.fromRGB(190, 140, 80), Enum.Material.Wood)
	f.WorldPivot = cf
	return f
end

builders.warehouse = function(m, cf, L, pal, S)
	foundation(m, cf, S - 2, S - 2, Color3.fromRGB(160, 160, 165))
	local body = cf * CFrame.new(0, 0, 4)
	local w = L >= 4 and 20 or 17
	local top = block(m, body, w, 12, 10, 0.6, Color3.fromRGB(215, 160, 90), { rows = 1, cols = 3, material = Enum.Material.Metal, sideWindows = false, windowColor = Color3.fromRGB(190, 220, 240) })
	Kit.box(m, "Roof", Vector3.new(w + 1, 1, 13), body * CFrame.new(0, top + 0.5, 0), Color3.fromRGB(110, 110, 120), Enum.Material.Metal)
	local docks = L >= 5 and 3 or 2
	for i = 1, docks do
		local x = -w / 2 + i * (w / (docks + 1))
		Kit.box(m, "DockDoor", Vector3.new(4.4, 5.5, 0.3), body * CFrame.new(x, 3.6, -6.15), Color3.fromRGB(230, 230, 235), Enum.Material.DiamondPlate)
		Kit.box(m, "DockStripe", Vector3.new(4.8, 0.6, 0.35), body * CFrame.new(x, 6.7, -6.2), Color3.fromRGB(255, 200, 40))
	end
	frontSign(m, body, "📦 ALMACÉN", top - 1.5, -6.2, 10, Color3.fromRGB(60, 60, 70), Color3.fromRGB(255, 200, 60))
	crates(m, cf * CFrame.new(-9, 0.6, -6), 2, 2)
	local fl = forklift(m, cf * CFrame.new(3, 0.6, -7) * CFrame.Angles(0, math.rad(90), 0))
	slide(fl, Vector3.new(0, 0, -6), 0.18, "pingpong")
	if L >= 2 then
		crates(m, cf * CFrame.new(7, 0.6, -10), 2, 1, Color3.fromRGB(120, 170, 220))
	end
	if L >= 3 then
		local t = Kit.car(m, cf * CFrame.new(-w / 2 - 1, 0.6, 7), Color3.fromRGB(70, 130, 220), "truck")
		t.Name = "Truck"
	end
	if L >= 4 then
		Kit.box(m, "Pallets", Vector3.new(6, 0.5, 4), cf * CFrame.new(0, 0.85, -10), Color3.fromRGB(170, 120, 70), Enum.Material.Wood)
	end
	if L >= 5 then
		local logo = Kit.box(m, "Logo", Vector3.new(8, 3, 0.5), body * CFrame.new(0, top + 2.5, 0), pal.accent, Enum.Material.Neon)
		Kit.surfaceText(logo, "EXPRESS", Enum.NormalId.Front, nil, WHITE)
		pulse(logo, 0.7)
	end
end

builders.factory = function(m, cf, L, pal, S)
	foundation(m, cf, S - 2, S - 2, Color3.fromRGB(130, 130, 135))
	local body = cf * CFrame.new(0, 0, 4)
	local floors = L >= 3 and 2 or 1
	local top = block(m, body, 20, 13, 9 * floors, 0.6, Color3.fromRGB(180, 90, 70), { rows = floors * 2, cols = 5, material = Enum.Material.Brick, windowColor = Color3.fromRGB(255, 220, 150) })
	Kit.box(m, "Roof", Vector3.new(21, 1, 14), body * CFrame.new(0, top + 0.5, 0), Color3.fromRGB(80, 80, 90), Enum.Material.Metal)
	frontSign(m, body, "🏭 FÁBRICA", top - 1.6, -6.6, 11, Color3.fromRGB(40, 40, 50), Color3.fromRGB(255, 170, 60))
	local chimneys = math.min(1 + L // 2, 3)
	for i = 1, chimneys do
		local x = -6 + (i - 1) * 6
		Kit.cylinder(m, "Stack", 12, 2.6, body * CFrame.new(x, top + 6.5, 3), Color3.fromRGB(170, 170, 175), Enum.Material.Concrete)
		local ring = Kit.cylinder(m, "StackRing", 1, 2.8, body * CFrame.new(x, top + 11, 3), Color3.fromRGB(230, 70, 60))
		Kit.smoke(ring, Color3.fromRGB(220, 220, 225), 5)
	end
	conveyor(m, cf * CFrame.new(0, 0.6, -9.5), 20, Color3.fromRGB(255, 120, 80), 5)
	-- Ventilador
	local fan = Kit.model(m, "Fan")
	local fc = body * CFrame.new(10.2, 5, 0) * CFrame.Angles(0, math.rad(-90), 0)
	for i = 0, 2 do
		Kit.box(fan, "Blade", Vector3.new(0.9, 3.2, 0.2), fc * CFrame.Angles(0, 0, math.rad(i * 120)) * CFrame.new(0, 1.5, -0.3), DARK, Enum.Material.Metal)
	end
	fan.WorldPivot = fc
	spin(fan, 240, "Z")
	if L >= 2 then
		for i = 0, 1 do
			Kit.cylinder(m, "Tank", 6, 3.6, cf * CFrame.new(-9 + i * 4.4, 3.6, -4.8), Color3.fromRGB(220, 225, 235), Enum.Material.Metal)
		end
	end
	if L >= 4 then
		Kit.box(m, "Pipe", Vector3.new(0.8, 0.8, 12), body * CFrame.new(10.6, top - 2, 0), Color3.fromRGB(80, 160, 210), Enum.Material.Metal)
		Kit.box(m, "Pipe", Vector3.new(0.8, 0.8, 12), body * CFrame.new(10.6, top - 4, 0), Color3.fromRGB(230, 200, 60), Enum.Material.Metal)
	end
	if L >= 5 then
		local neon = Kit.box(m, "NeonBand", Vector3.new(20.4, 0.6, 13.4), body * CFrame.new(0, top - 0.2, 0), pal.accent, Enum.Material.Neon)
		pulse(neon, 0.6)
	end
end

builders.techlab = function(m, cf, L, pal, S)
	foundation(m, cf, S - 2, S - 2, Color3.fromRGB(230, 235, 240))
	local cyan = Color3.fromRGB(80, 230, 230)
	local floors = 2 + math.floor((L - 1) / 2)
	local body = cf * CFrame.new(0, 0, 3)
	local top = block(m, body, 16, 14, 6 * floors, 0.6, Color3.fromRGB(235, 240, 245), { rows = floors, cols = 4, windowColor = Color3.fromRGB(120, 210, 240), trim = cyan })
	Kit.box(m, "Entrance", Vector3.new(6, 5, 3), body * CFrame.new(0, 3.1, -8.5), GLASS, Enum.Material.Glass, { Transparency = 0.3 })
	Kit.box(m, "Canopy", Vector3.new(8, 0.5, 4), body * CFrame.new(0, 5.8, -8.5), WHITE)
	frontSign(m, body, "🔬 TECH LAB", top - 1.6, -7.2, 10, Color3.fromRGB(20, 30, 50), cyan)
	-- Radar
	local radar = Kit.model(m, "Radar")
	local rc = body * CFrame.new(-4, top + 2.5, 2)
	Kit.cylinder(m, "RadarMast", 2.5, 0.6, body * CFrame.new(-4, top + 1.25, 2), METAL, Enum.Material.Metal)
	Kit.box(radar, "Dish", Vector3.new(5, 3, 0.4), rc * CFrame.new(0, 0.5, 0) * CFrame.Angles(math.rad(-25), 0, 0), WHITE, Enum.Material.Metal)
	Kit.cylinderX(radar, "Emitter", 2, 0.3, rc * CFrame.new(0, 0.8, -1) * CFrame.Angles(0, math.rad(90), 0), DARK)
	radar.WorldPivot = rc
	spin(radar, 35, "Y")
	-- Holograma
	local holo = Kit.ball(m, "Hologram", 3, cf * CFrame.new(-7, 5, -7), cyan, Enum.Material.Neon, { Transparency = 0.35, CanCollide = false })
	bob(holo, 1, 1.1)
	spin(holo, 80, "Y")
	Kit.cylinder(m, "Projector", 1.2, 2.4, cf * CFrame.new(-7, 1.2, -7), DARK, Enum.Material.Metal)
	if L >= 2 then
		local ant = Kit.cylinder(m, "Antenna", 6, 0.3, body * CFrame.new(5, top + 3, 3), METAL, Enum.Material.Metal)
		local tip = Kit.ball(m, "AntennaTip", 0.8, body * CFrame.new(5, top + 6.2, 3), Color3.fromRGB(255, 60, 60), Enum.Material.Neon)
		pulse(tip, 1.5)
		ant.CastShadow = false
	end
	if L >= 4 then
		Kit.ball(m, "Dome", 6, body * CFrame.new(3, top, -2), Color3.fromRGB(200, 240, 255), Enum.Material.Glass, { Transparency = 0.35 })
	end
	if L >= 5 then
		local ring = Kit.model(m, "Ring")
		local c = body * CFrame.new(3, top + 5, -2)
		for i = 0, 11 do
			local a = math.rad(i * 30)
			Kit.box(ring, "Seg", Vector3.new(1.2, 0.4, 0.6), c * CFrame.new(math.cos(a) * 4, 0, math.sin(a) * 4) * CFrame.Angles(0, -a, 0), cyan, Enum.Material.Neon, { CanCollide = false })
		end
		ring.WorldPivot = c
		spin(ring, 60, "Y")
	end
end

builders.tower = function(m, cf, L, pal, S)
	foundation(m, cf, S - 2, S - 2, Color3.fromRGB(220, 225, 235))
	local blue = Color3.fromRGB(110, 120, 255)
	local floors = 5 + L * 3
	local fh = 4
	local body = cf * CFrame.new(0, 0, 2)
	-- Vestibulo
	Kit.box(m, "Lobby", Vector3.new(18, 6, 16), body * CFrame.new(0, 3.6, 0), Color3.fromRGB(230, 235, 245))
	Kit.box(m, "LobbyGlass", Vector3.new(14, 5, 0.3), body * CFrame.new(0, 3.4, -8.1), GLASS, Enum.Material.Glass, { Transparency = 0.25 })
	-- Torre
	local towerH = floors * fh
	local tw, td = 13, 12
	Kit.box(m, "Tower", Vector3.new(tw, towerH, td), body * CFrame.new(0, 6.6 + towerH / 2, 1), Color3.fromRGB(70, 90, 140), Enum.Material.Glass, { Reflectance = 0.25 })
	for f = 1, floors do
		local y = 6.6 + (f - 1) * fh
		local band = Kit.box(m, "FloorBand", Vector3.new(tw + 0.3, 0.5, td + 0.3), body * CFrame.new(0, y, 1), Color3.fromRGB(235, 240, 250))
		band.CastShadow = false
		for side = -1, 1, 2 do
			local win = Kit.box(m, "Window", Vector3.new(tw - 1, fh - 1.2, 0.2), body * CFrame.new(0, y + fh / 2, 1 + side * (td / 2 + 0.15)), Color3.fromRGB(150, 200, 255), Enum.Material.Glass, { Transparency = 0.1, CastShadow = false })
			win:AddTag("TE_Window")
			local sideWin = Kit.box(m, "Window", Vector3.new(0.2, fh - 1.2, td - 1), body * CFrame.new(side * (tw / 2 + 0.15), y + fh / 2, 1), Color3.fromRGB(150, 200, 255), Enum.Material.Glass, { Transparency = 0.1, CastShadow = false })
			sideWin:AddTag("TE_Window")
		end
	end
	local roofY = 6.6 + towerH
	local logo = Kit.box(m, "Logo", Vector3.new(10, 3.4, 0.5), body * CFrame.new(0, roofY - 2.5, 1 - td / 2 - 0.4), blue, Enum.Material.Neon)
	Kit.surfaceText(logo, "TINY EMPIRE", Enum.NormalId.Front, nil, WHITE)
	pulse(logo, 0.5)
	local sign = frontSign(m, body, "🏢 TORRE CORPORATIVA", 7.5, -8.2, 14, Color3.fromRGB(30, 35, 60), Color3.fromRGB(200, 210, 255))
	sign.Name = "LobbySign"
	-- Ascensor exterior
	Kit.box(m, "ElevatorShaft", Vector3.new(3, towerH, 0.3), body * CFrame.new(tw / 2 + 1.6, 6.6 + towerH / 2, -1.5) * CFrame.Angles(0, math.rad(90), 0), GLASS, Enum.Material.Glass, { Transparency = 0.6, CanCollide = false })
	local cab = Kit.box(m, "ElevatorCab", Vector3.new(2.6, 3.4, 2.6), body * CFrame.new(tw / 2 + 1.6, 8.4, -1.5), Color3.fromRGB(255, 210, 80), Enum.Material.Neon, { CanCollide = false })
	slide(cab, Vector3.new(0, towerH - 4, 0), 0.06, "pingpong")
	-- Antena
	Kit.cylinder(m, "Spire", 10, 0.6, body * CFrame.new(0, roofY + 5, 1), METAL, Enum.Material.Metal)
	local beacon = Kit.ball(m, "Beacon", 1.4, body * CFrame.new(0, roofY + 10.5, 1), Color3.fromRGB(255, 60, 60), Enum.Material.Neon)
	pulse(beacon, 1.2)
	Kit.light(beacon, Color3.fromRGB(255, 80, 80), 20, 2)
	if L >= 3 then
		Kit.box(m, "RoofDeck", Vector3.new(tw + 2, 1, td + 2), body * CFrame.new(0, roofY + 0.5, 1), Color3.fromRGB(60, 65, 80), Enum.Material.Metal)
	end
	if L >= 5 then
		local pad = Kit.cylinder(m, "Helipad", 0.4, 9, body * CFrame.new(-3, roofY + 1.2, 3), Color3.fromRGB(50, 55, 65))
		Kit.surfaceText(pad, "H", Enum.NormalId.Right, nil, Color3.fromRGB(255, 220, 60))
		Kit.sparkles(beacon, Color3.fromRGB(180, 200, 255), 6)
	end
end

------------------------------------------------------------------------------

-- Construye el negocio `id` a nivel `level`. `cf` es el centro del solar.
function Buildings.build(parent, id, cf, level, palette, footprint)
	local m = Instance.new("Model")
	m.Name = id
	local builder = builders[id]
	if builder then
		builder(m, cf, level, palette, footprint)
	end
	-- Clientes en la puerta: mas negocio, mas gente
	local seed = level * 97
	for i = 1, #id do
		seed += string.byte(id, i) * i
	end
	Details.customers(m, cf, level, footprint, seed)
	if palette.premium then
		-- Tema dorado: bordes dorados y luces violetas
		local f = footprint - 2
		for _, side in ipairs({ -1, 1 }) do
			Kit.box(m, "GoldTrim", Vector3.new(f, 0.35, 0.5), cf * CFrame.new(0, 0.75, side * (f / 2 - 0.25)), palette.trim, Enum.Material.Neon, { CanCollide = false })
			Kit.box(m, "GoldTrim", Vector3.new(0.5, 0.35, f), cf * CFrame.new(side * (f / 2 - 0.25), 0.75, 0), palette.trim, Enum.Material.Neon, { CanCollide = false })
		end
		for _, x in ipairs({ -1, 1 }) do
			for _, z in ipairs({ -1, 1 }) do
				local post = Kit.box(m, "GoldPost", Vector3.new(0.8, 3, 0.8), cf * CFrame.new(x * (f / 2 - 0.4), 1.9, z * (f / 2 - 0.4)), palette.trim, Enum.Material.Foil, { CanCollide = false })
				local orb = Kit.ball(m, "GoldOrb", 1.1, cf * CFrame.new(x * (f / 2 - 0.4), 3.7, z * (f / 2 - 0.4)), palette.accent2, Enum.Material.Neon, { CanCollide = false })
				local _ = post
				Kit.light(orb, palette.accent2, 10, 1)
			end
		end
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and (d.Name == "Wall" or d.Name == "Trim" or d.Name == "Roof" or d.Name == "SawRoof") then
				if d.Name == "Wall" then
					d.Color = palette.wall
					d.Material = Enum.Material.Marble
				elseif d.Name == "Roof" or d.Name == "SawRoof" then
					d.Color = palette.roof
				else
					d.Color = palette.trim
					d.Material = Enum.Material.Foil
				end
			end
		end
	end
	m:SetAttribute("Business", id)
	m:SetAttribute("Level", level)
	m.WorldPivot = cf
	m.Parent = parent
	return m
end

return Buildings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Details</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Detalles urbanos: peatones, clientes, pasos de cebra, semaforos, mobiliario,
-- parada de autobus, banderas y nubes. Todo lo que se mueve lo anima el cliente.
--   TE_Walker        peaton (WalkMode "circle" | "line")
--   TE_TrafficLight  semaforo (luces Red / Yellow / Green)
--   TE_Sway          balanceo suave (banderas)
--   TE_Cloud         nube a la deriva

local Kit = require(script.Parent.Kit)

local Details = {}

local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(45, 48, 58)

local SKIN = {
	Color3.fromRGB(255, 220, 180),
	Color3.fromRGB(235, 185, 140),
	Color3.fromRGB(190, 135, 95),
	Color3.fromRGB(140, 95, 65),
	Color3.fromRGB(95, 65, 45),
}
local CLOTHES = {
	Color3.fromRGB(240, 80, 80),
	Color3.fromRGB(80, 150, 240),
	Color3.fromRGB(250, 200, 60),
	Color3.fromRGB(90, 200, 120),
	Color3.fromRGB(180, 110, 240),
	Color3.fromRGB(255, 140, 60),
	Color3.fromRGB(240, 240, 245),
	Color3.fromRGB(60, 200, 210),
	Color3.fromRGB(255, 120, 180),
}
local PANTS = {
	Color3.fromRGB(50, 70, 130),
	Color3.fromRGB(40, 40, 50),
	Color3.fromRGB(120, 90, 60),
	Color3.fromRGB(90, 95, 105),
	Color3.fromRGB(30, 60, 90),
}
local HAIR = {
	Color3.fromRGB(40, 30, 25),
	Color3.fromRGB(110, 70, 40),
	Color3.fromRGB(230, 190, 100),
	Color3.fromRGB(180, 60, 40),
	Color3.fromRGB(20, 20, 25),
}

-- Persona estilo bloque (mirando a -Z, pivote en los pies)
function Details.person(parent, cf, rng, opts)
	opts = opts or {}
	local m = Kit.model(parent, "Person")
	local skin = SKIN[rng:NextInteger(1, #SKIN)]
	local shirt = opts.shirt or CLOTHES[rng:NextInteger(1, #CLOTHES)]
	local pants = PANTS[rng:NextInteger(1, #PANTS)]
	local hair = HAIR[rng:NextInteger(1, #HAIR)]
	local s = opts.scale or 1
	local function p(name, size, offset, color, material)
		local part = Kit.box(m, name, size * s, cf * CFrame.new(offset * s), color, material or Enum.Material.SmoothPlastic, { CanCollide = false, CastShadow = true })
		return part
	end
	p("LegL", Vector3.new(0.9, 2, 0.9), Vector3.new(-0.5, 1, 0), pants)
	p("LegR", Vector3.new(0.9, 2, 0.9), Vector3.new(0.5, 1, 0), pants)
	p("Shoe", Vector3.new(0.95, 0.35, 1.1), Vector3.new(-0.5, 0.17, -0.1), DARK)
	p("Shoe", Vector3.new(0.95, 0.35, 1.1), Vector3.new(0.5, 0.17, -0.1), DARK)
	p("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), shirt)
	p("ArmL", Vector3.new(0.8, 1.9, 0.8), Vector3.new(-1.4, 3.05, 0), shirt:Lerp(skin, 0.15))
	p("ArmR", Vector3.new(0.8, 1.9, 0.8), Vector3.new(1.4, 3.05, 0), shirt:Lerp(skin, 0.15))
	p("Head", Vector3.new(1.25, 1.25, 1.25), Vector3.new(0, 4.65, 0), skin)
	p("Hair", Vector3.new(1.35, 0.45, 1.35), Vector3.new(0, 5.35, 0.05), hair)
	p("EyeL", Vector3.new(0.18, 0.22, 0.05), Vector3.new(-0.28, 4.75, -0.63), DARK)
	p("EyeR", Vector3.new(0.18, 0.22, 0.05), Vector3.new(0.28, 4.75, -0.63), DARK)
	if rng:NextNumber() < 0.35 then
		-- Gorra o sombrero
		p("Cap", Vector3.new(1.4, 0.35, 1.4), Vector3.new(0, 5.45, 0), CLOTHES[rng:NextInteger(1, #CLOTHES)])
		p("Visor", Vector3.new(1.2, 0.15, 0.7), Vector3.new(0, 5.3, -0.9), CLOTHES[rng:NextInteger(1, #CLOTHES)])
	elseif rng:NextNumber() < 0.3 then
		p("Bag", Vector3.new(0.4, 1.2, 0.9), Vector3.new(1.85, 2.4, 0), Color3.fromRGB(150, 100, 60))
	end
	m.WorldPivot = cf
	return m
end

------------------------------------------------------------------------------
-- Peatones
------------------------------------------------------------------------------

local function walker(parent, rng, attrs)
	-- Posicion inicial = punto del recorrido en t = 0 (igual que el cliente)
	local pos, dir
	if attrs.WalkMode == "line" then
		local delta = attrs.B - attrs.A
		local len = delta.Magnitude
		local s = (attrs.Phase * 2 * len) % (2 * len)
		if s < len then
			pos, dir = attrs.A + delta * (s / len), delta.Unit
		else
			pos, dir = attrs.B - delta * ((s - len) / len), -delta.Unit
		end
	else
		local ang = attrs.Phase * math.pi * 2
		pos = Vector3.new(attrs.CenterX + math.cos(ang) * attrs.Radius, 0, attrs.CenterZ + math.sin(ang) * attrs.Radius)
		dir = Vector3.new(-math.sin(ang), 0, math.cos(ang)) * (attrs.Speed >= 0 and 1 or -1)
	end
	pos = Vector3.new(pos.X, attrs.BaseY, pos.Z)
	local m = Details.person(parent, CFrame.lookAt(pos, pos + dir), rng)
	m.Name = "Pedestrian"
	for k, v in pairs(attrs) do
		m:SetAttribute(k, v)
	end
	m:AddTag("TE_Walker")
	return m
end

function Details.pedestrians(map)
	local folder = Instance.new("Folder")
	folder.Name = "Pedestrians"
	folder.Parent = map
	local rng = Random.new(77)
	-- Paseando por la plaza
	for i = 1, 12 do
		walker(folder, rng, {
			WalkMode = "circle",
			CenterX = 0,
			CenterZ = 0,
			Radius = 22 + (i % 4) * 7 + rng:NextNumber(-1.5, 1.5),
			Speed = (i % 2 == 0 and 1 or -1) * rng:NextNumber(3.5, 5.5),
			Phase = rng:NextNumber(0, 1),
			BaseY = 0.6,
		})
	end
	-- Por las aceras de las avenidas
	for i = 1, 16 do
		local sx = (i % 2 == 0) and 1 or -1
		local sz = (i % 4 < 2) and 1 or -1
		local a, b
		if i <= 8 then
			a = Vector3.new(sx * 66, 0.5, sz * 14)
			b = Vector3.new(sx * 315, 0.5, sz * 14)
		else
			a = Vector3.new(sx * 14, 0.5, sz * 66)
			b = Vector3.new(sx * 14, 0.5, sz * 175)
		end
		walker(folder, rng, {
			WalkMode = "line",
			A = a + Vector3.new(0, 0, rng:NextNumber(-0.8, 0.8)),
			B = b,
			Speed = rng:NextNumber(4, 6),
			Phase = rng:NextNumber(0, 1),
			BaseY = 0.5,
		})
	end
	return folder
end

-- Clientes delante de un negocio (cantidad segun nivel)
function Details.customers(parent, cf, level, size, seed)
	local rng = Random.new(seed)
	local count = math.min(3, 1 + math.floor((level - 1) / 2))
	local spots = {
		Vector3.new(-(size / 2 - 2.2), 0, -(size / 2 - 1.6)),
		Vector3.new(size / 2 - 2.2, 0, -(size / 2 - 1.6)),
		Vector3.new(-(size / 2 - 4.6), 0, -(size / 2 - 1.2)),
	}
	for i = 1, count do
		local spot = spots[i]
		local yaw = math.rad(180 + rng:NextNumber(-25, 25))
		local person = Details.person(parent, cf * CFrame.new(spot + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, yaw, 0), rng)
		person.Name = "Customer"
		if i == 1 then
			-- Saluda / celebra: brazo arriba
			local arm = person:FindFirstChild("ArmR")
			if arm then
				arm.CFrame = arm.CFrame * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.rad(160))
			end
		end
	end
end

------------------------------------------------------------------------------
-- Calles
------------------------------------------------------------------------------

-- Paso de cebra: `cf` en el centro, rayas a lo largo de X local
function Details.crosswalk(parent, cf, width, depth)
	local n = math.floor(width / 2.4)
	for i = 0, n - 1 do
		local x = -width / 2 + 1.2 + i * 2.4
		Kit.box(parent, "Zebra", Vector3.new(1.3, 0.06, depth), cf * CFrame.new(x, 0, 0), WHITE, Enum.Material.SmoothPlastic, { CanCollide = false, CastShadow = false })
	end
end

function Details.trafficLight(parent, cf, phase)
	local m = Kit.model(parent, "TrafficLight")
	Kit.cylinder(m, "Pole", 9, 0.5, cf * CFrame.new(0, 4.5, 0), DARK, Enum.Material.Metal)
	Kit.box(m, "Arm", Vector3.new(0.35, 0.35, 6), cf * CFrame.new(0, 8.8, -3), DARK, Enum.Material.Metal)
	local head = cf * CFrame.new(0, 7.8, -5.6)
	Kit.box(m, "Housing", Vector3.new(1.3, 3.6, 1.1), head, Color3.fromRGB(30, 30, 35))
	local lamps = { { "Red", 1.1, Color3.fromRGB(255, 60, 60) }, { "Yellow", 0, Color3.fromRGB(255, 200, 40) }, { "Green", -1.1, Color3.fromRGB(70, 230, 100) } }
	for _, l in ipairs(lamps) do
		local lamp = Kit.box(m, l[1], Vector3.new(0.8, 0.8, 0.2), head * CFrame.new(0, l[2], -0.6), l[3], Enum.Material.SmoothPlastic, { CastShadow = false })
		lamp:SetAttribute("OnColor", l[3])
		Kit.box(m, "Visor", Vector3.new(0.9, 0.12, 0.5), head * CFrame.new(0, l[2] + 0.45, -0.8), Color3.fromRGB(30, 30, 35))
	end
	m:SetAttribute("Phase", phase or 0)
	m:AddTag("TE_TrafficLight")
	return m
end

local function hydrant(parent, cf)
	local m = Kit.model(parent, "Hydrant")
	local red = Color3.fromRGB(220, 50, 45)
	Kit.cylinder(m, "Body", 2, 0.9, cf * CFrame.new(0, 1, 0), red)
	Kit.ball(m, "Cap", 0.9, cf * CFrame.new(0, 2, 0), red)
	Kit.cylinderX(m, "Nozzle", 1.3, 0.4, cf * CFrame.new(0, 1.3, 0), Color3.fromRGB(240, 200, 60))
	return m
end

local function trashBin(parent, cf, color)
	local m = Kit.model(parent, "TrashBin")
	Kit.cylinder(m, "Bin", 2.4, 1.6, cf * CFrame.new(0, 1.2, 0), color or Color3.fromRGB(60, 140, 90), Enum.Material.Metal)
	Kit.cylinder(m, "Lid", 0.25, 1.8, cf * CFrame.new(0, 2.5, 0), DARK, Enum.Material.Metal)
	return m
end

local function mailbox(parent, cf)
	local m = Kit.model(parent, "Mailbox")
	local blue = Color3.fromRGB(50, 90, 200)
	Kit.box(m, "Box", Vector3.new(1.6, 2.4, 1.4), cf * CFrame.new(0, 1.5, 0), blue, Enum.Material.Metal)
	Kit.cylinderX(m, "Top", 1.6, 1.4, cf * CFrame.new(0, 2.7, 0) * CFrame.Angles(0, math.rad(90), 0), blue, Enum.Material.Metal)
	Kit.box(m, "Slot", Vector3.new(0.9, 0.12, 0.05), cf * CFrame.new(0, 2.2, -0.72), DARK)
	return m
end

local function planter(parent, cf, color)
	local m = Kit.model(parent, "Planter")
	Kit.box(m, "Pot", Vector3.new(2.4, 1.4, 2.4), cf * CFrame.new(0, 0.7, 0), Color3.fromRGB(190, 120, 80), Enum.Material.Brick)
	Kit.ball(m, "Plant", 2.6, cf * CFrame.new(0, 2, 0), color or Color3.fromRGB(80, 170, 80), Enum.Material.Grass, { CanCollide = false })
	return m
end

function Details.streetFurniture(map)
	local folder = Kit.model(map, "StreetFurniture")
	local items = { hydrant, trashBin, planter, mailbox }
	local n = 0
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			for i = 0, 5 do
				n += 1
				local x = sx * (84 + i * 44)
				local cf = CFrame.lookAt(Vector3.new(x, 0.5, sz * 15.3), Vector3.new(x, 0.5, 0))
				items[(n % #items) + 1](folder, cf)
			end
			for i = 0, 2 do
				n += 1
				local z = sz * (84 + i * 40)
				local cf = CFrame.lookAt(Vector3.new(sx * 15.3, 0.5, z), Vector3.new(0, 0.5, z))
				items[(n % #items) + 1](folder, cf)
			end
		end
	end
	return folder
end

function Details.crossings(map, ringX, ringZ)
	local folder = Kit.model(map, "Crossings")
	-- Salidas de la plaza
	for _, s in ipairs({ -1, 1 }) do
		Details.crosswalk(folder, CFrame.new(0, 0.33, s * 64), 22, 4)
		Details.crosswalk(folder, CFrame.new(s * 64, 0.33, 0) * CFrame.Angles(0, math.rad(90), 0), 22, 4)
		-- Cruces con el anillo exterior
		Details.crosswalk(folder, CFrame.new(0, 0.33, s * (ringZ - 16)), 22, 4)
		Details.crosswalk(folder, CFrame.new(s * (ringX - 16), 0.33, 0) * CFrame.Angles(0, math.rad(90), 0), 22, 4)
		-- Calles laterales
		for _, sz in ipairs({ -1, 1 }) do
			Details.crosswalk(folder, CFrame.new(s * 175, 0.33, sz * 16), 16, 3.5)
		end
	end
	-- Semaforos: en cada cruce de una avenida con el anillo hay luces para la
	-- avenida y luces (en fase opuesta) para el trafico del anillo, que se detiene en rojo.
	local function at(x, z, yaw)
		-- El brazo del semaforo (-Z local) apunta hacia el centro de la calzada
		return CFrame.new(x, 0.5, z) * CFrame.Angles(0, math.rad(yaw), 0)
	end
	local function light(cf, phase, road, cx, cz)
		local m = Details.trafficLight(folder, cf, phase)
		m:SetAttribute("Road", road)
		m:SetAttribute("CenterX", cx)
		m:SetAttribute("CenterZ", cz)
	end
	local phase = 0
	for _, s in ipairs({ -1, 1 }) do
		-- Cruce de la avenida norte-sur con el anillo en (0, s * ringZ)
		phase += 0.25
		light(at(15, s * (ringZ - 20), 90), phase, "main", 0, s * ringZ)
		light(at(-15, s * (ringZ - 20), -90), phase, "main", 0, s * ringZ)
		light(at(14, s * (ringZ + 13), s > 0 and 0 or 180), phase + 0.5, "ring", 0, s * ringZ)
		light(at(-14, s * (ringZ + 13), s > 0 and 0 or 180), phase + 0.5, "ring", 0, s * ringZ)
		-- Cruce de la avenida este-oeste con el anillo en (s * ringX, 0)
		phase += 0.25
		light(at(s * (ringX - 20), 15, 0), phase, "main", s * ringX, 0)
		light(at(s * (ringX - 20), -15, 180), phase, "main", s * ringX, 0)
		light(at(s * (ringX + 13), 14, s > 0 and 90 or -90), phase + 0.5, "ring", s * ringX, 0)
		light(at(s * (ringX + 13), -14, s > 0 and 90 or -90), phase + 0.5, "ring", s * ringX, 0)
	end
	return folder
end

function Details.busStop(parent, cf)
	local m = Kit.model(parent, "BusStop")
	local frame = Color3.fromRGB(60, 65, 80)
	for _, z in ipairs({ -4, 4 }) do
		Kit.box(m, "Post", Vector3.new(0.4, 7, 0.4), cf * CFrame.new(-1.3, 3.5, z), frame, Enum.Material.Metal)
		Kit.box(m, "Post", Vector3.new(0.4, 7, 0.4), cf * CFrame.new(1.3, 3.5, z), frame, Enum.Material.Metal)
	end
	Kit.box(m, "Roof", Vector3.new(4.2, 0.4, 9.4), cf * CFrame.new(0, 7.2, 0), Color3.fromRGB(240, 110, 60))
	Kit.box(m, "BackGlass", Vector3.new(0.2, 5, 8), cf * CFrame.new(1.4, 3.6, 0), Color3.fromRGB(180, 220, 245), Enum.Material.Glass, { Transparency = 0.45 })
	local ad = Kit.box(m, "Ad", Vector3.new(0.3, 4, 2.6), cf * CFrame.new(1.3, 3.6, 5.5), Color3.fromRGB(255, 200, 60), Enum.Material.Neon)
	Kit.surfaceText(ad, "🍋 ¡Limonada fresca!", Enum.NormalId.Left, Color3.fromRGB(255, 200, 60), Color3.fromRGB(60, 40, 20))
	Kit.box(m, "Seat", Vector3.new(1.4, 0.4, 7), cf * CFrame.new(0.5, 1.8, 0), Color3.fromRGB(150, 100, 60), Enum.Material.Wood)
	local sign = Kit.box(m, "Sign", Vector3.new(0.2, 1.6, 1.6), cf * CFrame.new(-1.6, 8.4, -4), Color3.fromRGB(40, 120, 220))
	Kit.surfaceText(sign, "🚌", Enum.NormalId.Left, Color3.fromRGB(40, 120, 220), WHITE)
	Kit.surfaceText(sign, "🚌", Enum.NormalId.Right, Color3.fromRGB(40, 120, 220), WHITE)
	return m
end

function Details.flag(parent, cf, color, text)
	local m = Kit.model(parent, "FlagPole")
	Kit.cylinder(m, "Pole", 16, 0.4, cf * CFrame.new(0, 8, 0), Color3.fromRGB(220, 220, 225), Enum.Material.Metal)
	Kit.ball(m, "Finial", 0.8, cf * CFrame.new(0, 16.2, 0), Color3.fromRGB(255, 200, 60), Enum.Material.Foil)
	-- Tela dividida en segmentos: el cliente los encadena para que ondee (TE_Flag)
	local flagModel = Kit.model(m, "Flag")
	local hinge = cf * CFrame.new(0, 14, 0)
	local segments = 5
	local segW = 5.4 / segments
	for i = 1, segments do
		local segColor = (i % 2 == 0) and color:Lerp(WHITE, 0.35) or color
		Kit.box(flagModel, "Seg" .. i, Vector3.new(segW + 0.05, 3, 0.15), hinge * CFrame.new(segW * (i - 0.5) + 0.2, 0, 0), segColor, Enum.Material.Fabric, { CanCollide = false, CastShadow = false })
	end
	if text then
		-- El texto va en un estandarte fijo bajo la bandera
		local banner = Kit.box(m, "Banner", Vector3.new(3.4, 1, 0.2), cf * CFrame.new(1.9, 10.5, 0), color, Enum.Material.SmoothPlastic, { CanCollide = false })
		Kit.box(m, "BannerArm", Vector3.new(3.6, 0.15, 0.15), cf * CFrame.new(1.9, 11.1, 0), Color3.fromRGB(220, 220, 225), Enum.Material.Metal)
		Kit.surfaceText(banner, text, Enum.NormalId.Front, nil, WHITE)
		Kit.surfaceText(banner, text, Enum.NormalId.Back, nil, WHITE)
	end
	flagModel.WorldPivot = hinge
	flagModel:SetAttribute("Segments", segments)
	flagModel:SetAttribute("SegmentWidth", segW)
	flagModel:AddTag("TE_Flag")
	return m
end

------------------------------------------------------------------------------
-- Trampolin (el cliente aplica el impulso al personaje local: fisica fluida)
------------------------------------------------------------------------------

function Details.trampoline(parent, cf, color)
	local m = Kit.model(parent, "Trampoline")
	local frame = Color3.fromRGB(60, 90, 200)
	for i = 0, 5 do
		local a = math.rad(i * 60 + 30)
		Kit.box(m, "Leg", Vector3.new(0.5, 2.2, 0.5), cf * CFrame.new(math.cos(a) * 5.2, 1.1, math.sin(a) * 5.2), DARK, Enum.Material.Metal)
	end
	Kit.cylinder(m, "Rim", 0.8, 12, cf * CFrame.new(0, 2.4, 0), frame, Enum.Material.Metal)
	for i = 0, 11 do
		local a = math.rad(i * 30)
		Kit.box(m, "Spring", Vector3.new(0.9, 0.25, 0.25), cf * CFrame.new(math.cos(a) * 5.2, 2.85, math.sin(a) * 5.2) * CFrame.Angles(0, -a, 0), Color3.fromRGB(200, 200, 210), Enum.Material.Metal)
	end
	local mat = Kit.cylinder(m, "Mat", 0.3, 9.6, cf * CFrame.new(0, 2.95, 0), color or Color3.fromRGB(255, 90, 160), Enum.Material.Fabric)
	Kit.cylinder(m, "Ring", 0.32, 4, cf * CFrame.new(0, 2.96, 0), Color3.fromRGB(255, 230, 90), Enum.Material.Neon, { CanCollide = false })
	mat:AddTag("TE_Trampoline")
	mat:SetAttribute("Power", 115)
	local sign = Kit.box(m, "Sign", Vector3.new(4, 1.2, 0.2), cf * CFrame.new(0, 4.6, 6.2), Color3.fromRGB(255, 220, 90))
	Kit.surfaceText(sign, "¡SALTA!", Enum.NormalId.Front, Color3.fromRGB(255, 220, 90), DARK)
	Kit.surfaceText(sign, "¡SALTA!", Enum.NormalId.Back, Color3.fromRGB(255, 220, 90), DARK)
	Kit.box(m, "SignPost", Vector3.new(0.3, 3.6, 0.3), cf * CFrame.new(0, 2, 6.2), DARK, Enum.Material.Metal)
	return m
end

------------------------------------------------------------------------------
-- Cielo
------------------------------------------------------------------------------

function Details.clouds(map)
	local folder = Instance.new("Folder")
	folder.Name = "Clouds"
	folder.Parent = map
	local rng = Random.new(31)
	for i = 1, 16 do
		local m = Kit.model(folder, "Cloud")
		local c = CFrame.new(rng:NextNumber(-650, 650), rng:NextNumber(150, 210), rng:NextNumber(-420, 420))
		local puffs = rng:NextInteger(4, 7)
		for j = 1, puffs do
			local d = rng:NextNumber(18, 34)
			Kit.ball(m, "Puff", d, c * CFrame.new((j - puffs / 2) * 13 + rng:NextNumber(-4, 4), rng:NextNumber(-3, 5), rng:NextNumber(-8, 8)), WHITE, Enum.Material.SmoothPlastic, {
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Transparency = 0.08,
			})
		end
		m.WorldPivot = c
		m:SetAttribute("Speed", rng:NextNumber(2, 5))
		m:AddTag("TE_Cloud")
		local _ = i
	end
	return folder
end

------------------------------------------------------------------------------
-- Detalles de azotea para las tiendas
------------------------------------------------------------------------------

function Details.rooftop(parent, cf, w, d, rng)
	local roll = rng:NextNumber()
	if roll < 0.45 then
		Kit.box(parent, "ACUnit", Vector3.new(3, 1.6, 2.4), cf * CFrame.new(-w / 4, 0.8, d / 6), Color3.fromRGB(200, 205, 210), Enum.Material.Metal)
		Kit.cylinderX(parent, "Fan", 0.2, 1.4, cf * CFrame.new(-w / 4, 1.65, d / 6) * CFrame.Angles(0, 0, math.rad(90)), DARK)
		Kit.box(parent, "Vent", Vector3.new(1, 1.8, 1), cf * CFrame.new(w / 4, 0.9, -d / 6), Color3.fromRGB(170, 170, 175), Enum.Material.Metal)
	elseif roll < 0.75 then
		local tank = cf * CFrame.new(w / 5, 0, d / 6)
		for _, x in ipairs({ -1.2, 1.2 }) do
			for _, z in ipairs({ -1.2, 1.2 }) do
				Kit.box(parent, "TankLeg", Vector3.new(0.3, 2.4, 0.3), tank * CFrame.new(x, 1.2, z), Color3.fromRGB(110, 80, 60), Enum.Material.Wood)
			end
		end
		Kit.cylinder(parent, "WaterTank", 3, 3.4, tank * CFrame.new(0, 3.9, 0), Color3.fromRGB(140, 100, 70), Enum.Material.WoodPlanks)
		Kit.cylinder(parent, "TankRoof", 0.6, 3.8, tank * CFrame.new(0, 5.6, 0), Color3.fromRGB(90, 90, 100), Enum.Material.Metal)
	else
		Kit.cylinder(parent, "Antenna", 5, 0.25, cf * CFrame.new(w / 4, 2.5, 0), Color3.fromRGB(170, 170, 180), Enum.Material.Metal)
		local dish = Kit.cylinder(parent, "Dish", 0.3, 2.2, cf * CFrame.new(-w / 4, 1.3, 0) * CFrame.Angles(math.rad(35), 0, 0), WHITE)
		local _ = dish
		Kit.flowerBed(parent, cf * CFrame.new(0, 0, d / 4), w * 0.5, 2)
	end
end

return Details
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Kit de construccion: piezas basicas para levantar el mundo por codigo.

local Kit = {}

local DEFAULTS = {
	Anchored = true,
	CanCollide = true,
	TopSurface = Enum.SurfaceType.Smooth,
	BottomSurface = Enum.SurfaceType.Smooth,
	Material = Enum.Material.SmoothPlastic,
	CastShadow = true,
}

function Kit.apply(inst, props)
	if props then
		for k, v in pairs(props) do
			inst[k] = v
		end
	end
	return inst
end

function Kit.part(parent, props, className)
	local p = Instance.new(className or "Part")
	for k, v in pairs(DEFAULTS) do
		p[k] = v
	end
	Kit.apply(p, props)
	p.Parent = parent
	return p
end

-- Caja: tamano, CFrame, color, material
function Kit.box(parent, name, size, cf, color, material, extra)
	local p = Kit.part(parent, {
		Name = name or "Part",
		Size = size,
		CFrame = cf,
		Color = color or Color3.new(1, 1, 1),
		Material = material or Enum.Material.SmoothPlastic,
	})
	Kit.apply(p, extra)
	return p
end

function Kit.wedge(parent, name, size, cf, color, material)
	return Kit.part(parent, {
		Name = name or "Wedge",
		Size = size,
		CFrame = cf,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	}, "WedgePart")
end

-- Cilindro vertical (el eje del cilindro de Roblox es X, se rota para ponerlo en Y)
function Kit.cylinder(parent, name, height, diameter, cf, color, material, extra)
	local p = Kit.part(parent, {
		Name = name or "Cylinder",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = cf * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
	Kit.apply(p, extra)
	return p
end

-- Cilindro horizontal a lo largo del eje X local
function Kit.cylinderX(parent, name, length, diameter, cf, color, material)
	return Kit.part(parent, {
		Name = name or "Cylinder",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, diameter, diameter),
		CFrame = cf,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

function Kit.ball(parent, name, diameter, cf, color, material, extra)
	local p = Kit.part(parent, {
		Name = name or "Ball",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(diameter, diameter, diameter),
		CFrame = cf,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
	Kit.apply(p, extra)
	return p
end

function Kit.model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Kit.tag(inst, tag)
	inst:AddTag(tag)
	return inst
end

-- Luz que se enciende de noche (DayNightService busca la etiqueta TE_Lamp)
function Kit.light(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color or Color3.fromRGB(255, 220, 160)
	l.Range = range or 16
	l.Brightness = brightness or 1.5
	l.Shadows = false
	l.Enabled = false
	l.Parent = part
	part:AddTag("TE_Lamp")
	return l
end

-- Texto en una cara de una pieza
function Kit.surfaceText(part, text, face, bg, fg, props)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = bg or Color3.new(0, 0, 0)
	label.BackgroundTransparency = bg and 0 or 1
	label.TextColor3 = fg or Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(30, 30, 40)
	stroke.Transparency = 0.3
	stroke.Parent = label
	Kit.apply(label, props)
	return gui, label
end

-- Letrero: tablero con texto a ambos lados
function Kit.sign(parent, name, size, cf, text, bg, fg, frameColor)
	local board = Kit.box(parent, name or "Sign", size, cf, frameColor or Color3.fromRGB(60, 50, 45), Enum.Material.Wood)
	Kit.surfaceText(board, text, Enum.NormalId.Front, bg, fg)
	Kit.surfaceText(board, text, Enum.NormalId.Back, bg, fg)
	return board
end

function Kit.billboard(adornee, text, size, offset, color, maxDistance)
	local bb = Instance.new("BillboardGui")
	bb.Size = size or UDim2.fromOffset(200, 50)
	bb.StudsOffset = offset or Vector3.new(0, 4, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = maxDistance or 120
	bb.LightInfluence = 0
	bb.Adornee = adornee
	bb.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Text = text
	label.Parent = bb
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(25, 25, 35)
	stroke.Parent = label
	return bb, label
end

-- Ventanas en una fachada. `faceCF` mira hacia fuera (LookVector = normal)
function Kit.windows(parent, faceCF, width, height, rows, cols, color, frameColor)
	local wW = width / cols
	local wH = height / rows
	for r = 1, rows do
		for c = 1, cols do
			local x = -width / 2 + wW * (c - 0.5)
			local y = -height / 2 + wH * (r - 0.5)
			local cf = faceCF * CFrame.new(x, y, 0)
			local win = Kit.box(parent, "Window", Vector3.new(wW * 0.7, wH * 0.65, 0.3), cf, color or Color3.fromRGB(170, 220, 255), Enum.Material.Glass, {
				Transparency = 0.15,
				Reflectance = 0.2,
				CastShadow = false,
			})
			win:AddTag("TE_Window")
			if frameColor then
				Kit.box(parent, "Sill", Vector3.new(wW * 0.8, 0.25, 0.6), cf * CFrame.new(0, -wH * 0.35, 0.1), frameColor)
			end
		end
	end
end

-- Toldo de rayas
function Kit.awning(parent, cf, width, depth, colorA, colorB)
	local stripes = math.max(2, math.floor(width / 1.5))
	local sw = width / stripes
	for i = 1, stripes do
		local x = -width / 2 + sw * (i - 0.5)
		Kit.wedge(parent, "Awning", Vector3.new(sw, 1.2, depth), cf * CFrame.new(x, 0, 0), (i % 2 == 0) and colorA or colorB)
	end
end

-- Particulas de humo / chispas
function Kit.smoke(part, color, rate)
	local p = Instance.new("ParticleEmitter")
	p.Texture = "rbxasset://textures/particles/smoke_main.dds"
	p.Color = ColorSequence.new(color or Color3.fromRGB(230, 230, 235))
	p.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 5) })
	p.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	p.Lifetime = NumberRange.new(2, 3.5)
	p.Rate = rate or 4
	p.Speed = NumberRange.new(3, 5)
	p.SpreadAngle = Vector2.new(10, 10)
	p.EmissionDirection = Enum.NormalId.Top
	p.LightInfluence = 0.6
	p.Parent = part
	return p
end

function Kit.sparkles(part, color, rate)
	local p = Instance.new("ParticleEmitter")
	p.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	p.Color = ColorSequence.new(color or Color3.fromRGB(255, 240, 150))
	p.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	p.Lifetime = NumberRange.new(0.8, 1.4)
	p.Rate = rate or 6
	p.Speed = NumberRange.new(1, 3)
	p.SpreadAngle = Vector2.new(180, 180)
	p.LightEmission = 1
	p.Parent = part
	return p
end

------------------------------------------------------------------------------
-- DECORACION REUTILIZABLE
------------------------------------------------------------------------------

local TRUNK = Color3.fromRGB(110, 75, 50)

function Kit.tree(parent, cf, style, color)
	local m = Kit.model(parent, "Tree")
	if style == "pine" then
		Kit.cylinder(m, "Trunk", 4, 1.4, cf * CFrame.new(0, 2, 0), TRUNK, Enum.Material.Wood)
		local c = color or Color3.fromRGB(45, 125, 70)
		for i = 0, 3 do
			local s = 8.5 - i * 2
			Kit.box(m, "Leaves", Vector3.new(s, 3, s), cf * CFrame.new(0, 4.5 + i * 2.6, 0) * CFrame.Angles(0, math.rad(45 * i), 0), c:Lerp(Color3.new(0.2, 0.5, 0.3), i * 0.08), Enum.Material.Grass)
		end
	elseif style == "palm" then
		local h = 12
		for i = 0, 5 do
			Kit.cylinder(m, "Trunk", 2.2, 1.3 - i * 0.08, cf * CFrame.new(i * 0.25, 1.1 + i * 2, 0) * CFrame.Angles(0, 0, math.rad(-4)), Color3.fromRGB(160, 120, 75), Enum.Material.Wood)
		end
		local top = cf * CFrame.new(1.5, h, 0)
		for i = 0, 5 do
			local leaf = top * CFrame.Angles(0, math.rad(i * 60), 0) * CFrame.new(0, 0, -3.5) * CFrame.Angles(math.rad(-20), 0, 0)
			Kit.box(m, "Frond", Vector3.new(1.6, 0.4, 7), leaf, color or Color3.fromRGB(60, 170, 70), Enum.Material.Grass)
		end
		Kit.ball(m, "Coconut", 1.1, top * CFrame.new(0.5, -0.6, 0.3), Color3.fromRGB(110, 80, 40))
		Kit.ball(m, "Coconut", 1.1, top * CFrame.new(-0.4, -0.6, -0.4), Color3.fromRGB(110, 80, 40))
	elseif style == "blossom" then
		Kit.cylinder(m, "Trunk", 6, 1.3, cf * CFrame.new(0, 3, 0), Color3.fromRGB(95, 60, 55), Enum.Material.Wood)
		local c = color or Color3.fromRGB(255, 170, 200)
		Kit.ball(m, "Leaves", 8, cf * CFrame.new(0, 8, 0), c, Enum.Material.Grass)
		Kit.ball(m, "Leaves", 5.5, cf * CFrame.new(2.6, 7, 1), c:Lerp(Color3.new(1, 1, 1), 0.2), Enum.Material.Grass)
		Kit.ball(m, "Leaves", 5, cf * CFrame.new(-2.5, 7.5, -1.2), c:Lerp(Color3.new(1, 0.6, 0.8), 0.2), Enum.Material.Grass)
	else
		Kit.cylinder(m, "Trunk", 5, 1.3, cf * CFrame.new(0, 2.5, 0), TRUNK, Enum.Material.Wood)
		local c = color or Color3.fromRGB(80, 175, 80)
		Kit.ball(m, "Leaves", 7, cf * CFrame.new(0, 7, 0), c, Enum.Material.Grass)
		Kit.ball(m, "Leaves", 5, cf * CFrame.new(2.2, 6, 0.8), c:Lerp(Color3.new(0, 0.4, 0), 0.15), Enum.Material.Grass)
		Kit.ball(m, "Leaves", 4.5, cf * CFrame.new(-2, 6.2, -1), c:Lerp(Color3.new(1, 1, 0.5), 0.12), Enum.Material.Grass)
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = d.Name == "Trunk"
		end
	end
	-- Balanceo suave con el viento (lo anima el cliente desde la base del tronco)
	m.WorldPivot = cf
	m:AddTag("TE_Sway")
	m:SetAttribute("SwayMode", "tilt")
	m:SetAttribute("SwayAngle", style == "palm" and 3.5 or 2)
	m:SetAttribute("SwaySpeed", 0.25 + (math.abs(cf.Position.X * 7 + cf.Position.Z * 13) % 10) / 60)
	return m
end

function Kit.lamp(parent, cf, poleColor, lightColor)
	local m = Kit.model(parent, "StreetLamp")
	poleColor = poleColor or Color3.fromRGB(45, 50, 60)
	Kit.cylinder(m, "Base", 0.6, 1.6, cf * CFrame.new(0, 0.3, 0), poleColor, Enum.Material.Metal)
	Kit.cylinder(m, "Pole", 11, 0.5, cf * CFrame.new(0, 5.8, 0), poleColor, Enum.Material.Metal)
	Kit.box(m, "Arm", Vector3.new(0.4, 0.4, 2.4), cf * CFrame.new(0, 11.2, -1), poleColor, Enum.Material.Metal)
	local bulb = Kit.box(m, "Bulb", Vector3.new(1.4, 0.6, 1.4), cf * CFrame.new(0, 10.9, -2), lightColor or Color3.fromRGB(255, 240, 200), Enum.Material.Neon, { CastShadow = false })
	Kit.light(bulb, lightColor or Color3.fromRGB(255, 220, 160), 24, 2)
	return m
end

function Kit.bench(parent, cf, color)
	local m = Kit.model(parent, "Bench")
	color = color or Color3.fromRGB(150, 100, 60)
	local metal = Color3.fromRGB(50, 50, 60)
	Kit.box(m, "Seat", Vector3.new(5, 0.4, 1.6), cf * CFrame.new(0, 1.6, 0), color, Enum.Material.Wood)
	Kit.box(m, "Back", Vector3.new(5, 1.4, 0.3), cf * CFrame.new(0, 2.6, 0.75) * CFrame.Angles(math.rad(-10), 0, 0), color, Enum.Material.Wood)
	Kit.box(m, "Leg", Vector3.new(0.3, 1.5, 1.6), cf * CFrame.new(-2.2, 0.75, 0), metal, Enum.Material.Metal)
	Kit.box(m, "Leg", Vector3.new(0.3, 1.5, 1.6), cf * CFrame.new(2.2, 0.75, 0), metal, Enum.Material.Metal)
	local seat = Instance.new("Seat")
	seat.Name = "SitHere"
	seat.Size = Vector3.new(4, 0.3, 1.4)
	seat.CFrame = cf * CFrame.new(0, 1.85, 0)
	seat.Anchored = true
	seat.Transparency = 1
	seat.CanCollide = false
	seat.Parent = m
	return m
end

function Kit.flowerBed(parent, cf, w, d, colors)
	local m = Kit.model(parent, "FlowerBed")
	Kit.box(m, "Border", Vector3.new(w, 0.8, d), cf * CFrame.new(0, 0.4, 0), Color3.fromRGB(150, 140, 130), Enum.Material.Brick)
	Kit.box(m, "Soil", Vector3.new(w - 0.6, 0.85, d - 0.6), cf * CFrame.new(0, 0.45, 0), Color3.fromRGB(90, 60, 40), Enum.Material.Ground)
	colors = colors or { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 220, 80), Color3.fromRGB(180, 120, 255) }
	local n = math.floor(w / 1.4)
	local rows = math.max(1, math.floor(d / 1.4))
	for i = 1, n do
		for j = 1, rows do
			local x = -w / 2 + (i - 0.5) * (w / n)
			local z = -d / 2 + (j - 0.5) * (d / rows)
			Kit.ball(m, "Flower", 0.9, cf * CFrame.new(x, 1.1, z), colors[((i + j) % #colors) + 1], Enum.Material.SmoothPlastic, { CanCollide = false, CastShadow = false })
		end
	end
	return m
end

function Kit.bush(parent, cf, color)
	local c = color or Color3.fromRGB(70, 150, 70)
	local m = Kit.model(parent, "Bush")
	Kit.ball(m, "Leaves", 3, cf * CFrame.new(0, 1.2, 0), c, Enum.Material.Grass, { CanCollide = false })
	Kit.ball(m, "Leaves", 2.4, cf * CFrame.new(1.2, 1, 0.5), c:Lerp(Color3.new(0, 0.3, 0), 0.2), Enum.Material.Grass, { CanCollide = false })
	return m
end

function Kit.fence(parent, fromPos, toPos, color, height)
	local m = Kit.model(parent, "Fence")
	height = height or 3
	local dir = toPos - fromPos
	local len = dir.Magnitude
	local cf = CFrame.lookAt(fromPos, toPos)
	local posts = math.max(1, math.floor(len / 4))
	for i = 0, posts do
		Kit.box(m, "Post", Vector3.new(0.5, height, 0.5), cf * CFrame.new(0, height / 2, -len * i / posts), color, Enum.Material.Wood)
	end
	Kit.box(m, "Rail", Vector3.new(0.25, 0.4, len), cf * CFrame.new(0, height * 0.75, -len / 2), color, Enum.Material.Wood)
	Kit.box(m, "Rail", Vector3.new(0.25, 0.4, len), cf * CFrame.new(0, height * 0.35, -len / 2), color, Enum.Material.Wood)
	return m
end

-- Coche decorativo (el cliente lo mueve por la carretera)
function Kit.car(parent, cf, bodyColor, kind)
	local m = Kit.model(parent, "Car")
	local dark = Color3.fromRGB(35, 35, 40)
	if kind == "van" then
		Kit.box(m, "Body", Vector3.new(4.6, 4, 9), cf * CFrame.new(0, 2.8, 0), bodyColor)
		Kit.box(m, "Windshield", Vector3.new(4.2, 1.6, 0.3), cf * CFrame.new(0, 3.6, -4.5), Color3.fromRGB(160, 210, 240), Enum.Material.Glass, { Transparency = 0.2 })
		Kit.box(m, "Stripe", Vector3.new(4.7, 0.6, 7), cf * CFrame.new(0, 2.4, 0.5), Color3.new(1, 1, 1))
	elseif kind == "truck" then
		Kit.box(m, "Cab", Vector3.new(4.6, 4, 3.6), cf * CFrame.new(0, 2.8, -4), bodyColor)
		Kit.box(m, "Windshield", Vector3.new(4.2, 1.6, 0.3), cf * CFrame.new(0, 3.8, -5.85), Color3.fromRGB(160, 210, 240), Enum.Material.Glass, { Transparency = 0.2 })
		Kit.box(m, "Cargo", Vector3.new(4.8, 5, 8), cf * CFrame.new(0, 3.5, 2.2), Color3.fromRGB(235, 235, 240), Enum.Material.Metal)
	else
		Kit.box(m, "Body", Vector3.new(4.4, 1.6, 8), cf * CFrame.new(0, 1.6, 0), bodyColor)
		Kit.box(m, "Cabin", Vector3.new(4, 1.6, 4.4), cf * CFrame.new(0, 3.2, 0.4), bodyColor:Lerp(Color3.new(1, 1, 1), 0.15))
		Kit.box(m, "Glass", Vector3.new(4.1, 1.2, 4.5), cf * CFrame.new(0, 3.2, 0.4), Color3.fromRGB(160, 210, 240), Enum.Material.Glass, { Transparency = 0.3 })
	end
	for _, x in ipairs({ -2.1, 2.1 }) do
		for _, z in ipairs({ -2.7, 2.7 }) do
			local w = Kit.cylinderX(m, "Wheel", 0.8, 1.8, cf * CFrame.new(x, 0.9, z), dark, Enum.Material.SmoothPlastic)
			w.CanCollide = false
		end
	end
	Kit.box(m, "Headlight", Vector3.new(0.8, 0.5, 0.2), cf * CFrame.new(-1.5, 1.8, -4.05), Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
	Kit.box(m, "Headlight", Vector3.new(0.8, 0.5, 0.2), cf * CFrame.new(1.5, 1.8, -4.05), Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
	Kit.box(m, "Taillight", Vector3.new(0.8, 0.5, 0.2), cf * CFrame.new(-1.5, 1.8, 4.05), Color3.fromRGB(255, 60, 60), Enum.Material.Neon)
	Kit.box(m, "Taillight", Vector3.new(0.8, 0.5, 0.2), cf * CFrame.new(1.5, 1.8, 4.05), Color3.fromRGB(255, 60, 60), Enum.Material.Neon)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CastShadow = false
		end
	end
	m.WorldPivot = cf
	return m
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Palettes</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Paletas de los 4 barrios y del tema premium.

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local Palettes = {}

Palettes.Neighborhoods = {
	{
		id = "pastel",
		name = "Barrio Pastel",
		ground = rgb(140, 210, 120),
		path = rgb(245, 215, 220),
		curb = rgb(255, 255, 255),
		wall = rgb(255, 210, 225),
		wall2 = rgb(200, 230, 255),
		roof = rgb(235, 110, 140),
		trim = rgb(255, 255, 255),
		accent = rgb(255, 140, 180),
		accent2 = rgb(140, 200, 255),
		tree = "blossom",
		treeColor = rgb(255, 175, 205),
		fence = rgb(255, 255, 255),
		lamp = rgb(255, 200, 230),
		groundMaterial = Enum.Material.Grass,
		pathMaterial = Enum.Material.Pebble,
	},
	{
		id = "green",
		name = "Distrito Verde",
		ground = rgb(95, 165, 85),
		path = rgb(190, 165, 120),
		curb = rgb(130, 105, 80),
		wall = rgb(235, 225, 195),
		wall2 = rgb(170, 200, 150),
		roof = rgb(70, 120, 80),
		trim = rgb(120, 85, 60),
		accent = rgb(110, 190, 90),
		accent2 = rgb(250, 210, 90),
		tree = "pine",
		treeColor = rgb(50, 130, 75),
		fence = rgb(140, 100, 65),
		lamp = rgb(255, 230, 160),
		groundMaterial = Enum.Material.Grass,
		pathMaterial = Enum.Material.Cobblestone,
	},
	{
		id = "industrial",
		name = "Puerto Industrial",
		ground = rgb(120, 150, 110),
		path = rgb(165, 165, 170),
		curb = rgb(90, 90, 95),
		wall = rgb(200, 120, 90),
		wall2 = rgb(150, 170, 190),
		roof = rgb(70, 75, 85),
		trim = rgb(240, 190, 60),
		accent = rgb(255, 170, 40),
		accent2 = rgb(80, 150, 220),
		tree = "round",
		treeColor = rgb(85, 150, 85),
		fence = rgb(110, 110, 120),
		lamp = rgb(255, 210, 140),
		groundMaterial = Enum.Material.Grass,
		pathMaterial = Enum.Material.Concrete,
	},
	{
		id = "coast",
		name = "Costa Sol",
		ground = rgb(150, 205, 110),
		path = rgb(240, 220, 170),
		curb = rgb(255, 245, 225),
		wall = rgb(255, 245, 220),
		wall2 = rgb(130, 220, 215),
		roof = rgb(240, 130, 70),
		trim = rgb(40, 170, 190),
		accent = rgb(40, 190, 200),
		accent2 = rgb(255, 150, 90),
		tree = "palm",
		treeColor = rgb(70, 175, 80),
		fence = rgb(240, 230, 210),
		lamp = rgb(200, 255, 250),
		groundMaterial = Enum.Material.Grass,
		pathMaterial = Enum.Material.Sand,
	},
}

-- Tema premium "Ciudad Dorada" (solo cambia el aspecto de TU parcela)
Palettes.Premium = {
	id = "gold",
	name = "Ciudad Dorada",
	wall = rgb(255, 240, 200),
	wall2 = rgb(40, 35, 60),
	roof = rgb(30, 25, 45),
	trim = rgb(255, 200, 60),
	accent = rgb(255, 200, 60),
	accent2 = rgb(190, 90, 255),
	glow = rgb(255, 210, 90),
}

function Palettes.forPlot(neighborhood, premium: boolean)
	local p = table.clone(neighborhood)
	if premium then
		for k, v in pairs(Palettes.Premium) do
			if k ~= "id" and k ~= "name" then
				p[k] = v
			end
		end
		p.premium = true
	end
	return p
end

return Palettes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">PlotBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Estructura fisica de una parcela: base, zonas, entrada, botones y extras.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.Kit)
local Buildings = require(script.Parent.Buildings)
local Config = require(ReplicatedStorage.TinyEmpireShared.Config)

local PlotBuilder = {}

local WHITE = Color3.new(1, 1, 1)
local SIZE = 120

-- Posicion local (x, z) y tamano de cada solar
PlotBuilder.Slots = {
	{ x = -39, z = -28, size = 20, padZ = -42.5 },
	{ x = -13, z = -28, size = 20, padZ = -42.5 },
	{ x = 13, z = -28, size = 20, padZ = -42.5 },
	{ x = 39, z = -28, size = 20, padZ = -42.5 },
	{ x = -34, z = 6, size = 24, padZ = -11.5 },
	{ x = 0, z = 6, size = 24, padZ = -11.5 },
	{ x = 34, z = 6, size = 24, padZ = -11.5 },
	{ x = -36, z = 40, size = 26, padZ = 22.5 },
	{ x = 0, z = 40, size = 26, padZ = 22.5 },
	{ x = 36, z = 40, size = 26, padZ = 22.5 },
}

-- Zonas: rango Z local
PlotBuilder.Zones = {
	{ z1 = -60, z2 = -17 },
	{ z1 = -17, z2 = 19.5 },
	{ z1 = 19.5, z2 = 60 },
}

PlotBuilder.SpawnOffset = CFrame.new(0, 3, -52) * CFrame.Angles(0, math.pi, 0)

function PlotBuilder.local_(plotCF, x, y, z)
	return plotCF * CFrame.new(x, y, z)
end

local function zoneCF(plotCF, zone)
	local z = PlotBuilder.Zones[zone]
	return plotCF * CFrame.new(0, 0, (z.z1 + z.z2) / 2), z.z2 - z.z1
end

-- Crea un boton de compra (pad). Devuelve el modelo y la parte pisable.
local function makePad(parent, name, cf)
	local m = Kit.model(parent, name)
	Kit.cylinder(m, "Ring", 0.4, 6.6, cf * CFrame.new(0, 0.2, 0), Color3.fromRGB(40, 40, 50), Enum.Material.Metal)
	local button = Kit.cylinder(m, "Button", 0.5, 5.4, cf * CFrame.new(0, 0.45, 0), Color3.fromRGB(80, 230, 110), Enum.Material.Neon)
	button.CanCollide = false
	local touch = Kit.box(m, "Touch", Vector3.new(5, 3, 5), cf * CFrame.new(0, 1.6, 0), WHITE, Enum.Material.SmoothPlastic, {
		Transparency = 1,
		CanCollide = false,
		CanTouch = true,
		CastShadow = false,
	})
	local bb = Instance.new("BillboardGui")
	bb.Name = "Info"
	bb.Size = UDim2.fromOffset(230, 92)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 5.5, 0)
	bb.MaxDistance = 80
	bb.LightInfluence = 0
	bb.Adornee = button
	bb.Parent = button
	local frame = Instance.new("Frame")
	frame.Name = "Card"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(30, 34, 48)
	frame.BackgroundTransparency = 0.15
	frame.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Stroke"
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(80, 230, 110)
	stroke.Parent = frame
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromScale(0.05, 0.06)
	title.Size = UDim2.fromScale(0.9, 0.45)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = WHITE
	title.Text = ""
	title.Parent = frame
	local price = Instance.new("TextLabel")
	price.Name = "Price"
	price.BackgroundTransparency = 1
	price.Position = UDim2.fromScale(0.05, 0.52)
	price.Size = UDim2.fromScale(0.9, 0.42)
	price.Font = Enum.Font.FredokaOne
	price.TextScaled = true
	price.TextColor3 = Color3.fromRGB(120, 255, 140)
	price.Text = ""
	price.Parent = frame
	m:SetAttribute("Visible", true)
	return m, touch, button
end

-- Muestra / oculta un pad sin destruirlo
function PlotBuilder.setPadVisible(pad, visible)
	if pad:GetAttribute("Visible") == visible then
		return
	end
	pad:SetAttribute("Visible", visible)
	for _, d in ipairs(pad:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "Touch" then
			d.Transparency = visible and 0 or 1
		elseif d:IsA("BillboardGui") or d:IsA("ParticleEmitter") then
			d.Enabled = visible
		end
	end
	local touch = pad:FindFirstChild("Touch")
	if touch then
		touch.CanTouch = visible
	end
end

function PlotBuilder.setPadStyle(pad, title, priceText, color)
	local button = pad:FindFirstChild("Button")
	if not button then
		return
	end
	if button.Color ~= color then
		button.Color = color
	end
	local card = button.Info.Card
	if card.Title.Text ~= title then
		card.Title.Text = title
	end
	if card.Price.Text ~= priceText then
		card.Price.Text = priceText
	end
	card.Price.TextColor3 = color:Lerp(WHITE, 0.35)
	card.Stroke.Color = color
end

-- Estructura base de la parcela (se construye una vez al iniciar el servidor)
function PlotBuilder.create(parent, def)
	local cf = def.cframe
	local pal = def.neighborhood
	local plot = Kit.model(parent, "Plot" .. def.index)
	plot:SetAttribute("Index", def.index)
	plot:SetAttribute("Owner", 0)
	plot:SetAttribute("Neighborhood", pal.name)
	plot.WorldPivot = cf

	local static = Kit.model(plot, "Static")
	Kit.box(static, "Base", Vector3.new(SIZE, 1, SIZE), cf * CFrame.new(0, -0.5, 0), pal.ground:Lerp(Color3.new(1, 1, 1), 0.08), pal.groundMaterial)
	-- Bordillo con hueco de entrada
	local curb = pal.curb
	Kit.box(static, "CurbBack", Vector3.new(SIZE, 1, 1), cf * CFrame.new(0, 0.5, SIZE / 2 - 0.5), curb, Enum.Material.Concrete)
	Kit.box(static, "CurbL", Vector3.new(1, 1, SIZE), cf * CFrame.new(-SIZE / 2 + 0.5, 0.5, 0), curb, Enum.Material.Concrete)
	Kit.box(static, "CurbR", Vector3.new(1, 1, SIZE), cf * CFrame.new(SIZE / 2 - 0.5, 0.5, 0), curb, Enum.Material.Concrete)
	Kit.box(static, "CurbFL", Vector3.new(SIZE / 2 - 9, 1, 1), cf * CFrame.new(-(SIZE / 4 + 4.5), 0.5, -SIZE / 2 + 0.5), curb, Enum.Material.Concrete)
	Kit.box(static, "CurbFR", Vector3.new(SIZE / 2 - 9, 1, 1), cf * CFrame.new(SIZE / 4 + 4.5, 0.5, -SIZE / 2 + 0.5), curb, Enum.Material.Concrete)
	-- Calzadas interiores
	Kit.box(static, "FrontWalk", Vector3.new(SIZE - 2, 0.1, 14), cf * CFrame.new(0, 0.05, -52), pal.path, pal.pathMaterial)
	-- Entrada
	local gate = Kit.model(static, "Gate")
	for _, x in ipairs({ -9.5, 9.5 }) do
		Kit.box(gate, "Pillar", Vector3.new(2, 14, 2), cf * CFrame.new(x, 7, -59), pal.trim)
		Kit.box(gate, "Cap", Vector3.new(2.6, 0.8, 2.6), cf * CFrame.new(x, 14.4, -59), pal.accent)
	end
	local sign = Kit.box(gate, "OwnerSign", Vector3.new(20, 4, 0.8), cf * CFrame.new(0, 12.5, -59), pal.accent)
	local _, label = Kit.surfaceText(sign, "🏗️ PARCELA LIBRE", Enum.NormalId.Front, pal.accent, WHITE)
	label.Name = "OwnerLabel"
	local _, backLabel = Kit.surfaceText(sign, "🏗️ PARCELA LIBRE", Enum.NormalId.Back, pal.accent, WHITE)
	backLabel.Name = "OwnerLabel"
	local glow = Kit.box(gate, "Glow", Vector3.new(20.4, 0.3, 1), cf * CFrame.new(0, 10.3, -59), pal.lamp, Enum.Material.Neon)
	Kit.light(glow, pal.lamp, 20, 1.5)

	-- Panel de ingresos junto a la entrada
	local stats = Kit.box(gate, "StatsBoard", Vector3.new(8, 4.5, 0.5), cf * CFrame.new(-17, 4.5, -58), Color3.fromRGB(35, 40, 55))
	Kit.box(gate, "StatsLeg", Vector3.new(0.5, 2.5, 0.5), cf * CFrame.new(-17, 1.25, -58), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	local _, statsLabel = Kit.surfaceText(stats, "$0/s", Enum.NormalId.Front, Color3.fromRGB(35, 40, 55), Color3.fromRGB(120, 255, 140))
	statsLabel.Name = "StatsLabel"

	-- Punto de aparicion
	local spawnPad = Kit.cylinder(static, "SpawnPad", 0.3, 9, cf * CFrame.new(0, 0.15, -52), pal.accent, Enum.Material.SmoothPlastic)
	Kit.cylinder(static, "SpawnInner", 0.32, 6, cf * CFrame.new(0, 0.16, -52), WHITE, Enum.Material.SmoothPlastic)
	spawnPad.CanCollide = true

	-- Cartel flotante visible desde lejos
	local beacon = Kit.box(static, "Beacon", Vector3.new(1, 1, 1), cf * CFrame.new(0, 34, 0), WHITE, Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false })
	local bb, bbLabel = Kit.billboard(beacon, "Parcela libre", UDim2.fromOffset(320, 60), Vector3.new(0, 0, 0), WHITE, 600)
	bb.Name = "OwnerBillboard"
	bbLabel.Name = "OwnerLabel"

	-- Seto trasero y laterales, buzon con el nombre del dueno
	local hedgeColor = Color3.fromRGB(60, 140, 70)
	for i = 0, 4 do
		Kit.box(static, "Hedge", Vector3.new(18, 2.4, 2), cf * CFrame.new(-44 + i * 22, 1.2, 57.5), hedgeColor, Enum.Material.Grass)
	end
	for _, x in ipairs({ -57.5, 57.5 }) do
		Kit.box(static, "Hedge", Vector3.new(2, 2.4, 16), cf * CFrame.new(x, 1.2, 46), hedgeColor, Enum.Material.Grass)
	end
	local mail = cf * CFrame.new(-25, 0, -58)
	Kit.box(static, "MailPost", Vector3.new(0.4, 3, 0.4), mail * CFrame.new(0, 1.5, 0), Color3.fromRGB(110, 80, 60), Enum.Material.Wood)
	Kit.box(static, "Mailbox", Vector3.new(1.4, 1.2, 2), mail * CFrame.new(0, 3.4, 0), pal.accent, Enum.Material.Metal)
	Kit.box(static, "MailFlag", Vector3.new(0.15, 0.9, 0.3), mail * CFrame.new(0.78, 3.7, 0.4), Color3.fromRGB(230, 50, 50))

	-- Arboles de la esquina trasera (decoracion fija)
	Kit.tree(static, cf * CFrame.new(-55, 0, 56), pal.tree, pal.treeColor)
	Kit.tree(static, cf * CFrame.new(55, 0, 56), pal.tree, pal.treeColor)
	Kit.lamp(static, cf * CFrame.new(-56, 0, -56) * CFrame.Angles(0, math.rad(180), 0), nil, pal.lamp)
	Kit.lamp(static, cf * CFrame.new(56, 0, -56) * CFrame.Angles(0, math.rad(180), 0), nil, pal.lamp)

	-- Carpetas dinamicas
	local zones = Kit.model(plot, "Zones")
	local buildings = Kit.model(plot, "Buildings")
	local pads = Kit.model(plot, "Pads")
	local extras = Kit.model(plot, "Extras")
	local _ = { zones, buildings, extras }

	-- Pads de negocios
	local padMap = {}
	for _, b in ipairs(Config.Businesses) do
		local slot = PlotBuilder.Slots[b.slot]
		local pad, touch = makePad(pads, "Pad_" .. b.id, cf * CFrame.new(slot.x, 0, slot.padZ))
		pad:SetAttribute("Kind", "business")
		pad:SetAttribute("Target", b.id)
		padMap[b.id] = { model = pad, touch = touch }
	end
	-- Pads de expansion
	for i, exp in ipairs(Config.Expansions) do
		local zone = PlotBuilder.Zones[i + 1]
		local pad, touch = makePad(pads, "Pad_exp" .. i, cf * CFrame.new(0, 0, zone.z1 + 3.5))
		pad:SetAttribute("Kind", "expansion")
		pad:SetAttribute("Target", i)
		padMap["exp" .. i] = { model = pad, touch = touch }
		local _ = exp
	end

	return plot, padMap
end

-- Dibuja el estado de las zonas (bloqueada = obra; desbloqueada = cesped)
function PlotBuilder.buildZones(plot, def, expansions)
	local cf = def.cframe
	local pal = def.neighborhood
	local zones = plot.Zones
	zones:ClearAllChildren()
	for zone = 2, 3 do
		local zcf, depth = zoneCF(cf, zone)
		local z = PlotBuilder.Zones[zone]
		local unlocked = zone <= expansions + 1
		if unlocked then
			-- Caminos delante de los pads
			local padZ = (zone == 2) and -11.5 or 22.5
			Kit.box(zones, "PadWalk", Vector3.new(SIZE - 2, 0.1, 6), cf * CFrame.new(0, 0.05, padZ), pal.path, pal.pathMaterial)
		else
			Kit.box(zones, "Dirt", Vector3.new(SIZE - 2, 0.12, depth), zcf * CFrame.new(0, 0.06, 0), Color3.fromRGB(150, 115, 80), Enum.Material.Ground)
			-- Valla de obra
			local fz = z.z1 + 1
			Kit.fence(zones, (cf * CFrame.new(-58, 0, fz)).Position, (cf * CFrame.new(-6, 0, fz)).Position, Color3.fromRGB(255, 190, 60), 2.5)
			Kit.fence(zones, (cf * CFrame.new(6, 0, fz)).Position, (cf * CFrame.new(58, 0, fz)).Position, Color3.fromRGB(255, 190, 60), 2.5)
			for i = -2, 2 do
				if i ~= 0 then
					local cone = Kit.model(zones, "Cone")
					local c = cf * CFrame.new(i * 18, 0, z.z1 + 8)
					Kit.box(cone, "Base", Vector3.new(1.6, 0.3, 1.6), c * CFrame.new(0, 0.15, 0), Color3.fromRGB(255, 120, 30))
					Kit.cylinder(cone, "Cone", 2, 0.9, c * CFrame.new(0, 1.2, 0), Color3.fromRGB(255, 120, 30))
					Kit.cylinder(cone, "Stripe", 0.4, 1, c * CFrame.new(0, 1.3, 0), WHITE)
				end
			end
			local exp = Config.Expansions[zone - 1]
			local sign = Kit.sign(zones, "ForSale", Vector3.new(14, 5, 0.5), zcf * CFrame.new(0, 7, 0), "🚧 " .. exp.name .. "\n¡Expándete aquí!", Color3.fromRGB(255, 200, 60), Color3.fromRGB(40, 35, 30), Color3.fromRGB(100, 80, 60))
			Kit.box(zones, "SignLeg", Vector3.new(0.6, 4.5, 0.6), zcf * CFrame.new(-5, 2.25, 0), Color3.fromRGB(100, 80, 60), Enum.Material.Wood)
			Kit.box(zones, "SignLeg", Vector3.new(0.6, 4.5, 0.6), zcf * CFrame.new(5, 2.25, 0), Color3.fromRGB(100, 80, 60), Enum.Material.Wood)
			local _ = sign
		end
	end
end

-- Construye un negocio en su solar
function PlotBuilder.buildBusiness(plot, def, id, level, palette)
	local b = Config.BusinessById[id]
	local slot = PlotBuilder.Slots[b.slot]
	local existing = plot.Buildings:FindFirstChild(id)
	if existing then
		existing:Destroy()
	end
	local cf = def.cframe * CFrame.new(slot.x, 0, slot.z)
	local m = Buildings.build(plot.Buildings, id, cf, level, palette, slot.size)
	return m
end

-- Elementos extra: mejoras visuales y decoracion premium
function PlotBuilder.buildExtras(plot, def, data, palette, hasDecor)
	local cf = def.cframe
	local extras = plot.Extras
	extras:ClearAllChildren()
	local up = data.upgrades or {}

	if up["u_vans"] then
		for i, x in ipairs({ -44, -34 }) do
			local van = Kit.car(extras, cf * CFrame.new(x, 0, -52), (i == 1) and palette.accent or palette.accent2, "van")
			van.Name = "DeliveryVan"
			local logo = Kit.box(van, "Logo", Vector3.new(0.2, 2, 4), cf * CFrame.new(x - 2.4, 3, -52), WHITE)
			Kit.surfaceText(logo, "TINY EXPRESS", Enum.NormalId.Left, WHITE, palette.accent)
		end
	end
	if up["u_solar"] then
		for i = 0, 6 do
			local z = -15 + i * 10
			local pcf = cf * CFrame.new(53, 0, z)
			Kit.box(extras, "SolarLeg", Vector3.new(0.4, 2.4, 0.4), pcf * CFrame.new(0, 1.2, 0), Color3.fromRGB(150, 150, 160), Enum.Material.Metal)
			Kit.box(extras, "SolarPanel", Vector3.new(7, 0.3, 8), pcf * CFrame.new(0, 2.8, 0) * CFrame.Angles(0, 0, math.rad(25)), Color3.fromRGB(40, 70, 140), Enum.Material.Glass, { Reflectance = 0.3 })
		end
	end
	if up["u_heli"] then
		local hcf = cf * CFrame.new(-52, 0, 6)
		Kit.cylinder(extras, "Helipad", 0.4, 10, hcf * CFrame.new(0, 0.2, 0), Color3.fromRGB(50, 55, 65))
		local mark = Kit.box(extras, "HMark", Vector3.new(4, 0.05, 4), hcf * CFrame.new(0, 0.43, 0), Color3.fromRGB(50, 55, 65))
		Kit.surfaceText(mark, "H", Enum.NormalId.Top, nil, Color3.fromRGB(255, 220, 60))
		local heli = Kit.model(extras, "Helicopter")
		Kit.ball(heli, "Cabin", 4.4, hcf * CFrame.new(0, 3, 0), Color3.fromRGB(230, 60, 60))
		Kit.box(heli, "Tail", Vector3.new(0.8, 0.8, 6), hcf * CFrame.new(0, 3.3, 4.5), Color3.fromRGB(230, 60, 60))
		Kit.box(heli, "SkidL", Vector3.new(0.3, 0.3, 5), hcf * CFrame.new(-1.6, 0.9, 0), Color3.fromRGB(40, 40, 45))
		Kit.box(heli, "SkidR", Vector3.new(0.3, 0.3, 5), hcf * CFrame.new(1.6, 0.9, 0), Color3.fromRGB(40, 40, 45))
		local rotor = Kit.model(heli, "Rotor")
		local rc = hcf * CFrame.new(0, 5.5, 0)
		Kit.box(rotor, "Blade", Vector3.new(11, 0.2, 0.7), rc, Color3.fromRGB(40, 40, 45))
		Kit.box(rotor, "Blade", Vector3.new(0.7, 0.2, 11), rc, Color3.fromRGB(40, 40, 45))
		rotor.WorldPivot = rc
		rotor:AddTag("TE_Spin")
		rotor:SetAttribute("SpinSpeed", 600)
		rotor:SetAttribute("SpinAxis", "Y")
	end
	if up["u_statue"] then
		local scf = cf * CFrame.new(40, 0, -52)
		local gold = Color3.fromRGB(255, 200, 60)
		Kit.box(extras, "Plinth", Vector3.new(5, 3, 5), scf * CFrame.new(0, 1.5, 0), Color3.fromRGB(230, 230, 235), Enum.Material.Marble)
		local st = Kit.model(extras, "Statue")
		Kit.box(st, "Legs", Vector3.new(2, 3, 1.2), scf * CFrame.new(0, 4.5, 0), gold, Enum.Material.Foil)
		Kit.box(st, "Torso", Vector3.new(2.6, 3, 1.4), scf * CFrame.new(0, 7.5, 0), gold, Enum.Material.Foil)
		Kit.ball(st, "Head", 1.8, scf * CFrame.new(0, 9.9, 0), gold, Enum.Material.Foil)
		Kit.box(st, "Arm", Vector3.new(0.8, 3.2, 0.8), scf * CFrame.new(1.7, 9, 0) * CFrame.Angles(0, 0, math.rad(-30)), gold, Enum.Material.Foil)
		Kit.box(st, "TopHat", Vector3.new(1.4, 1.2, 1.4), scf * CFrame.new(0, 11.2, 0), Color3.fromRGB(30, 30, 35))
		Kit.sparkles(st.Torso, gold, 6)
	end

	if hasDecor and (data.settings == nil or data.settings.decor ~= false) then
		local deco = Kit.model(extras, "PremiumDecor")
		-- Arco de neon en la entrada
		local arc = Kit.model(deco, "NeonArch")
		for i = 0, 8 do
			local a = math.rad(i * 22.5)
			local p = cf * CFrame.new(math.cos(a) * 12, 3 + math.sin(a) * 12, -60.5)
			local seg = Kit.box(arc, "Seg", Vector3.new(1.2, 4.6, 0.8), p * CFrame.Angles(0, 0, a), (i % 2 == 0) and Color3.fromRGB(255, 80, 200) or Color3.fromRGB(80, 220, 255), Enum.Material.Neon, { CanCollide = false })
			seg:AddTag("TE_Pulse")
			seg:SetAttribute("PulseSpeed", 1 + i * 0.1)
		end
		-- Fuente premium
		local fcf = cf * CFrame.new(20, 0, -52)
		Kit.cylinder(deco, "Rim", 1.6, 9, fcf * CFrame.new(0, 0.8, 0), Color3.fromRGB(255, 215, 120), Enum.Material.Marble)
		Kit.cylinder(deco, "Water", 0.3, 7.6, fcf * CFrame.new(0, 1.5, 0), Color3.fromRGB(90, 190, 255), Enum.Material.Glass, { Transparency = 0.25, CanCollide = false })
		local spout = Kit.ball(deco, "Spout", 1.4, fcf * CFrame.new(0, 3.5, 0), Color3.fromRGB(120, 220, 255), Enum.Material.Neon, { CanCollide = false })
		Kit.cylinder(deco, "Column", 2.5, 1, fcf * CFrame.new(0, 2.2, 0), Color3.fromRGB(255, 215, 120), Enum.Material.Marble)
		Kit.sparkles(spout, Color3.fromRGB(160, 230, 255), 25)
		-- Estatuas de leon junto a la entrada
		for _, x in ipairs({ -13, 13 }) do
			local lcf = cf * CFrame.new(x, 0, -57)
			Kit.box(deco, "Pedestal", Vector3.new(3, 2, 3), lcf * CFrame.new(0, 1, 0), Color3.fromRGB(240, 240, 245), Enum.Material.Marble)
			Kit.ball(deco, "LionBody", 2.4, lcf * CFrame.new(0, 3, 0.3), Color3.fromRGB(255, 200, 60), Enum.Material.Foil)
			Kit.ball(deco, "LionHead", 1.8, lcf * CFrame.new(0, 4.3, -0.6), Color3.fromRGB(255, 200, 60), Enum.Material.Foil)
		end
		-- Palmeras y jardines en las esquinas
		for _, x in ipairs({ -56, 56 }) do
			Kit.tree(deco, cf * CFrame.new(x, 0, -45), "palm")
			Kit.flowerBed(deco, cf * CFrame.new(x, 0, -33), 4, 12, { Color3.fromRGB(255, 80, 160), Color3.fromRGB(255, 210, 60), Color3.fromRGB(150, 110, 255) })
		end
		-- Alfombra roja
		Kit.box(deco, "RedCarpet", Vector3.new(6, 0.12, 14), cf * CFrame.new(0, 0.12, -53), Color3.fromRGB(200, 30, 50), Enum.Material.Fabric, { CanCollide = false })
	end
end

function PlotBuilder.setOwnerText(plot, text, color)
	local gate = plot.Static.Gate
	for _, d in ipairs(gate.OwnerSign:GetDescendants()) do
		if d:IsA("TextLabel") and d.Name == "OwnerLabel" then
			d.Text = text
		end
	end
	local bb = plot.Static.Beacon.OwnerBillboard
	bb.OwnerLabel.Text = text
	bb.OwnerLabel.TextColor3 = color or WHITE
end

function PlotBuilder.setStatsText(plot, text)
	local label = plot.Static.Gate.StatsBoard:FindFirstChildWhichIsA("SurfaceGui").StatsLabel
	label.Text = text
end

return PlotBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Construye el mapa: suelo, carreteras, plaza central, 4 barrios, tiendas,
-- vehiculos decorativos e iluminacion. Devuelve la lista de parcelas.

local Lighting = game:GetService("Lighting")

local Kit = require(script.Parent.Kit)
local Palettes = require(script.Parent.Palettes)
local Details = require(script.Parent.Details)

local WorldBuilder = {}

local ROAD = Color3.fromRGB(70, 72, 80)
local LINE = Color3.fromRGB(255, 220, 90)
local SIDEWALK = Color3.fromRGB(205, 205, 210)
local WHITE = Color3.new(1, 1, 1)

WorldBuilder.RingX = 330
WorldBuilder.RingZ = 185
WorldBuilder.PlotSize = 120

-- Cuadrantes: (signo X, signo Z, indice de barrio)
local QUADRANTS = {
	{ sx = 1, sz = 1, hood = 1 },
	{ sx = -1, sz = 1, hood = 2 },
	{ sx = -1, sz = -1, hood = 3 },
	{ sx = 1, sz = -1, hood = 4 },
}

local function road(parent, size, cf, dashedAlongX)
	local r = Kit.box(parent, "Road", size, cf, ROAD, Enum.Material.Asphalt)
	local long = dashedAlongX and size.X or size.Z
	local n = math.floor(long / 12)
	for i = 0, n - 1 do
		local off = -long / 2 + 6 + i * 12
		local dcf = dashedAlongX and cf * CFrame.new(off, size.Y / 2 + 0.02, 0) or cf * CFrame.new(0, size.Y / 2 + 0.02, off)
		Kit.box(parent, "Dash", dashedAlongX and Vector3.new(5, 0.05, 0.6) or Vector3.new(0.6, 0.05, 5), dcf, LINE, Enum.Material.SmoothPlastic, { CanCollide = false, CastShadow = false })
	end
	return r
end

local function sidewalk(parent, size, cf)
	return Kit.box(parent, "Sidewalk", size, cf, SIDEWALK, Enum.Material.Concrete)
end

local function lighting()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.6
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	local atm = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atm.Density = 0.28
	atm.Offset = 0.2
	atm.Color = Color3.fromRGB(200, 220, 255)
	atm.Decay = Color3.fromRGB(110, 130, 170)
	atm.Glare = 0.2
	atm.Haze = 1.2
	atm.Parent = Lighting
	local cc = Lighting:FindFirstChild("TE_Color") or Instance.new("ColorCorrectionEffect")
	cc.Name = "TE_Color"
	cc.Saturation = 0.18
	cc.Contrast = 0.06
	cc.Brightness = 0.02
	cc.Parent = Lighting
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.SunAngularSize = 16
		sky.MoonAngularSize = 9
		sky.StarCount = 3000
		sky.Parent = Lighting
	end
end

------------------------------------------------------------------------------
-- PLAZA CENTRAL
------------------------------------------------------------------------------

local function fountain(parent, cf, radius, premium)
	local m = Kit.model(parent, "Fountain")
	local stone = premium and Color3.fromRGB(255, 220, 120) or Color3.fromRGB(225, 225, 230)
	Kit.cylinder(m, "Rim", 2, radius * 2, cf * CFrame.new(0, 1, 0), stone, premium and Enum.Material.Foil or Enum.Material.Marble)
	local water = Kit.cylinder(m, "Water", 0.4, radius * 2 - 2, cf * CFrame.new(0, 1.9, 0), Color3.fromRGB(80, 180, 255), Enum.Material.Glass, { Transparency = 0.25, CanCollide = false })
	water.Reflectance = 0.2
	Kit.cylinder(m, "Column", 6, radius * 0.25, cf * CFrame.new(0, 4, 0), stone, Enum.Material.Marble)
	Kit.cylinder(m, "Bowl", 1, radius * 0.9, cf * CFrame.new(0, 7, 0), stone, Enum.Material.Marble)
	local top = Kit.ball(m, "Spout", radius * 0.25, cf * CFrame.new(0, 8, 0), Color3.fromRGB(120, 210, 255), Enum.Material.Neon, { CanCollide = false })
	local p = Instance.new("ParticleEmitter")
	p.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	p.Color = ColorSequence.new(Color3.fromRGB(170, 225, 255))
	p.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.2) })
	p.Lifetime = NumberRange.new(1, 1.4)
	p.Rate = 60
	p.Speed = NumberRange.new(10, 14)
	p.SpreadAngle = Vector2.new(25, 25)
	p.Acceleration = Vector3.new(0, -25, 0)
	p.EmissionDirection = Enum.NormalId.Top
	p.LightEmission = 0.6
	p.Parent = top
	return m
end

local function kiosk(parent, cf, name, color, icon)
	local m = Kit.model(parent, "Kiosk")
	Kit.box(m, "Base", Vector3.new(8, 4, 6), cf * CFrame.new(0, 2, 0), WHITE, Enum.Material.Wood)
	Kit.box(m, "Counter", Vector3.new(8.4, 0.4, 6.4), cf * CFrame.new(0, 4.2, 0), color)
	for _, x in ipairs({ -3.8, 3.8 }) do
		for _, z in ipairs({ -2.8, 2.8 }) do
			Kit.box(m, "Post", Vector3.new(0.4, 4, 0.4), cf * CFrame.new(x, 6.2, z), WHITE)
		end
	end
	Kit.box(m, "Roof", Vector3.new(9.4, 0.6, 7.4), cf * CFrame.new(0, 8.4, 0), color)
	Kit.wedge(m, "RoofTop", Vector3.new(9.4, 1.6, 3.7), cf * CFrame.new(0, 9.5, -1.85), color:Lerp(WHITE, 0.3))
	Kit.wedge(m, "RoofTop", Vector3.new(9.4, 1.6, 3.7), cf * CFrame.new(0, 9.5, 1.85) * CFrame.Angles(0, math.rad(180), 0), color:Lerp(WHITE, 0.3))
	local sign = Kit.box(m, "Sign", Vector3.new(7, 1.6, 0.3), cf * CFrame.new(0, 7.4, -3.1), WHITE)
	Kit.surfaceText(sign, icon .. " " .. name, Enum.NormalId.Front, WHITE, color)
	local bulb = Kit.box(m, "Glow", Vector3.new(6, 0.2, 0.2), cf * CFrame.new(0, 8, -3.3), Color3.fromRGB(255, 230, 160), Enum.Material.Neon)
	Kit.light(bulb, Color3.fromRGB(255, 220, 160), 12, 1)
	return m
end

local function infoBoard(parent, cf, title, lines, color)
	local m = Kit.model(parent, "InfoBoard")
	Kit.box(m, "Leg", Vector3.new(0.6, 6, 0.6), cf * CFrame.new(-5, 3, 0), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	Kit.box(m, "Leg", Vector3.new(0.6, 6, 0.6), cf * CFrame.new(5, 3, 0), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	local board = Kit.box(m, "Board", Vector3.new(12, 9, 0.5), cf * CFrame.new(0, 9.5, 0), Color3.fromRGB(40, 45, 60))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0
	gui.Parent = board
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(30, 34, 50)
	frame.Parent = gui
	local head = Instance.new("TextLabel")
	head.Size = UDim2.new(1, 0, 0.18, 0)
	head.BackgroundColor3 = color
	head.Font = Enum.Font.FredokaOne
	head.TextScaled = true
	head.TextColor3 = WHITE
	head.Text = title
	head.Parent = frame
	local body = Instance.new("TextLabel")
	body.Position = UDim2.new(0.05, 0, 0.22, 0)
	body.Size = UDim2.new(0.9, 0, 0.74, 0)
	body.BackgroundTransparency = 1
	body.Font = Enum.Font.GothamMedium
	body.TextScaled = true
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.TextColor3 = Color3.fromRGB(235, 240, 255)
	body.Text = table.concat(lines, "\n")
	body.Parent = frame
	local back = Kit.surfaceText(board, "TINY EMPIRE", Enum.NormalId.Back, Color3.fromRGB(40, 45, 60), color)
	back.Name = "BackText"
	return m, board
end

local function signpost(parent, cf, entries)
	local m = Kit.model(parent, "Signpost")
	Kit.cylinder(m, "Pole", 10, 0.6, cf * CFrame.new(0, 5, 0), Color3.fromRGB(80, 60, 45), Enum.Material.Wood)
	for i, e in ipairs(entries) do
		local dir = e.dir
		local y = 9 - (i - 1) * 2.2
		local ang = math.atan2(-dir.X, -dir.Z)
		local arrowCF = CFrame.new((cf * CFrame.new(0, y, 0)).Position) * CFrame.Angles(0, ang, 0) * CFrame.Angles(0, math.rad(90), 0) * CFrame.new(3.2, 0, 0)
		local arrow = Kit.box(m, "Arrow", Vector3.new(6.4, 1.6, 0.3), arrowCF, e.color, Enum.Material.SmoothPlastic)
		Kit.surfaceText(arrow, e.text, Enum.NormalId.Front, e.color, WHITE)
		Kit.surfaceText(arrow, e.text, Enum.NormalId.Back, e.color, WHITE)
		-- Punta de flecha
		Kit.wedge(m, "ArrowTip", Vector3.new(0.3, 0.8, 1.2), arrowCF * CFrame.new(3.8, 0.4, 0) * CFrame.Angles(0, math.rad(-90), 0), e.color)
		Kit.wedge(m, "ArrowTip", Vector3.new(0.3, 0.8, 1.2), arrowCF * CFrame.new(3.8, -0.4, 0) * CFrame.Angles(math.rad(180), math.rad(-90), 0), e.color)
	end
	return m
end

local function stage(parent, cf)
	local m = Kit.model(parent, "Stage")
	Kit.box(m, "Platform", Vector3.new(26, 2, 14), cf * CFrame.new(0, 1, 0), Color3.fromRGB(90, 70, 110), Enum.Material.Wood)
	local colors = { Color3.fromRGB(255, 80, 150), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 220, 80), Color3.fromRGB(140, 255, 120) }
	for i = 0, 5 do
		for j = 0, 2 do
			local tile = Kit.box(m, "DanceTile", Vector3.new(3.6, 0.2, 3.6), cf * CFrame.new(-9.5 + i * 3.8, 2.1, -3.8 + j * 3.8), colors[((i + j) % 4) + 1], Enum.Material.Neon)
			tile:AddTag("TE_Pulse")
			tile:SetAttribute("PulseSpeed", 1 + ((i * 3 + j) % 4) * 0.4)
		end
	end
	Kit.box(m, "Back", Vector3.new(26, 12, 1), cf * CFrame.new(0, 8, 7), Color3.fromRGB(40, 35, 60))
	local banner = Kit.box(m, "Banner", Vector3.new(20, 4, 0.4), cf * CFrame.new(0, 11, 6.3), Color3.fromRGB(255, 90, 160), Enum.Material.Neon)
	Kit.surfaceText(banner, "⭐ ZONA SOCIAL ⭐", Enum.NormalId.Front, nil, WHITE)
	banner:AddTag("TE_Pulse")
	banner:SetAttribute("PulseSpeed", 0.6)
	for _, x in ipairs({ -12, 12 }) do
		Kit.box(m, "Speaker", Vector3.new(3, 5, 3), cf * CFrame.new(x, 4.5, 4), Color3.fromRGB(30, 30, 35))
		Kit.cylinderX(m, "Cone", 0.3, 2.2, cf * CFrame.new(x, 5, 2.4) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(80, 80, 90))
		local spot = Kit.box(m, "Spot", Vector3.new(1.2, 1.2, 1.2), cf * CFrame.new(x, 12.5, 5), Color3.fromRGB(255, 255, 220), Enum.Material.Neon)
		local l = Instance.new("SpotLight")
		l.Angle = 50
		l.Range = 30
		l.Brightness = 3
		l.Face = Enum.NormalId.Front
		l.Color = x < 0 and Color3.fromRGB(255, 120, 200) or Color3.fromRGB(120, 200, 255)
		l.Enabled = false
		l.Parent = spot
		spot:AddTag("TE_Lamp")
	end
	-- Escaleras
	for i = 0, 1 do
		Kit.box(m, "Step", Vector3.new(8, 0.7, 1.5), cf * CFrame.new(0, 0.35 + i * 0.7, -7.75 - (1 - i) * 1.5), Color3.fromRGB(110, 90, 130), Enum.Material.Wood)
	end
	return m
end

local function buildPlaza(map)
	local plaza = Kit.model(map, "Plaza")
	local R = 58
	Kit.cylinder(plaza, "Paving", 0.6, R * 2, CFrame.new(0, 0.3, 0), Color3.fromRGB(235, 225, 210), Enum.Material.Pavement)
	Kit.cylinder(plaza, "Ring", 0.62, R * 2 - 16, CFrame.new(0, 0.31, 0), Color3.fromRGB(215, 175, 140), Enum.Material.Pavement)
	Kit.cylinder(plaza, "Inner", 0.64, 40, CFrame.new(0, 0.32, 0), Color3.fromRGB(240, 235, 225), Enum.Material.Marble)
	-- Bordillo
	for i = 0, 47 do
		local a = math.rad(i * 7.5)
		local pos = Vector3.new(math.cos(a) * (R - 0.5), 0.8, math.sin(a) * (R - 0.5))
		if math.abs(pos.X) > 14 and math.abs(pos.Z) > 14 then
			Kit.box(plaza, "Curb", Vector3.new(1, 1, 8), CFrame.lookAt(pos, Vector3.new(0, 0.8, 0)) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(190, 185, 180), Enum.Material.Concrete)
		end
	end
	local mosaic = { Color3.fromRGB(255, 150, 120), Color3.fromRGB(120, 190, 255), Color3.fromRGB(255, 215, 110), Color3.fromRGB(150, 220, 140) }
	for i = 0, 15 do
		local a = math.rad(i * 22.5)
		local mid = Vector3.new(math.cos(a) * 34, 0.66, math.sin(a) * 34)
		Kit.box(plaza, "Mosaic", Vector3.new(2.2, 0.05, 26), CFrame.lookAt(mid, Vector3.new(0, 0.66, 0)), mosaic[(i % 4) + 1], Enum.Material.Pavement, { CanCollide = false, CastShadow = false })
	end
	fountain(plaza, CFrame.new(0, 0.6, 0), 9)
	-- Arboles y bancos en circulo
	for i = 0, 7 do
		local a = math.rad(22.5 + i * 45)
		local p = Vector3.new(math.cos(a) * 34, 0.6, math.sin(a) * 34)
		Kit.cylinder(plaza, "Planter", 1.4, 7, CFrame.new(p + Vector3.new(0, 0.7, 0)), Color3.fromRGB(180, 140, 110), Enum.Material.Brick)
		Kit.tree(plaza, CFrame.new(p + Vector3.new(0, 1.4, 0)), "round", Color3.fromRGB(110, 190, 90))
		local bp = Vector3.new(math.cos(a) * 26, 0.6, math.sin(a) * 26)
		Kit.bench(plaza, CFrame.lookAt(bp, Vector3.new(0, 0.6, 0)))
	end
	for i = 0, 11 do
		local a = math.rad(i * 30)
		if i % 3 ~= 0 and i ~= 7 and i ~= 8 then
			Kit.lamp(plaza, CFrame.lookAt(Vector3.new(math.cos(a) * 50, 0.6, math.sin(a) * 50), Vector3.new(0, 0.6, 0)), Color3.fromRGB(50, 55, 70))
		end
	end
	-- Escenario social (norte-oeste) y kioscos
	stage(plaza, CFrame.lookAt(Vector3.new(-33, 0.6, -33), Vector3.new(0, 0.6, 0)))
	kiosk(plaza, CFrame.lookAt(Vector3.new(34, 0.6, -30), Vector3.new(0, 0.6, 0)), "Helados", Color3.fromRGB(255, 120, 170), "🍦")
	kiosk(plaza, CFrame.lookAt(Vector3.new(-36, 0.6, 30), Vector3.new(0, 0.6, 0)), "Palomitas", Color3.fromRGB(255, 80, 80), "🍿")
	kiosk(plaza, CFrame.lookAt(Vector3.new(36, 0.6, 30), Vector3.new(0, 0.6, 0)), "Globos", Color3.fromRGB(90, 160, 255), "🎈")

	-- Cartel de bienvenida
	local arch = Kit.model(plaza, "WelcomeArch")
	for _, x in ipairs({ -11, 11 }) do
		Kit.box(arch, "Pillar", Vector3.new(2.4, 16, 2.4), CFrame.new(x, 8.6, -56), Color3.fromRGB(255, 200, 70), Enum.Material.SmoothPlastic)
	end
	local title = Kit.box(arch, "Title", Vector3.new(26, 5, 1.2), CFrame.new(0, 17, -56), Color3.fromRGB(255, 110, 70))
	Kit.surfaceText(title, "🏙️ TINY EMPIRE TYCOON", Enum.NormalId.Front, Color3.fromRGB(255, 110, 70), WHITE)
	Kit.surfaceText(title, "🏙️ TINY EMPIRE TYCOON", Enum.NormalId.Back, Color3.fromRGB(255, 110, 70), WHITE)
	local glow = Kit.box(arch, "Glow", Vector3.new(26.4, 0.4, 1.4), CFrame.new(0, 14.3, -56), Color3.fromRGB(255, 240, 150), Enum.Material.Neon)
	Kit.light(glow, Color3.fromRGB(255, 220, 150), 24, 2)

	-- Paneles informativos (tutorial integrado en el mundo)
	infoBoard(plaza, CFrame.lookAt(Vector3.new(-16, 0.6, 46), Vector3.new(0, 0.6, 0)), "📘 CÓMO JUGAR", {
		"1. Sigue la flecha hasta TU parcela.",
		"2. Pisa los botones verdes para construir.",
		"3. Tus negocios ganan dinero solos.",
		"4. Mejora negocios (botones azules) y",
		"   compra Mejoras de Imperio en el menú.",
		"5. Expande tu parcela y completa retos.",
		"6. ¡Recoge maletines 💼 aquí en la plaza!",
	}, Color3.fromRGB(80, 160, 255))
	local _, lb = infoBoard(plaza, CFrame.lookAt(Vector3.new(16, 0.6, 46), Vector3.new(0, 0.6, 0)), "🏆 RANKING DEL SERVIDOR", { "Cargando..." }, Color3.fromRGB(255, 180, 40))
	lb.Name = "LeaderboardBoard"

	signpost(plaza, CFrame.new(16, 0.6, 62), {
		{ text = "Barrio Pastel", dir = Vector3.new(1, 0, 0.3), color = Color3.fromRGB(255, 130, 180) },
		{ text = "Distrito Verde", dir = Vector3.new(-1, 0, 0.3), color = Color3.fromRGB(80, 170, 90) },
	})
	signpost(plaza, CFrame.new(-16, 0.6, -62), {
		{ text = "Puerto Industrial", dir = Vector3.new(-1, 0, -0.3), color = Color3.fromRGB(230, 150, 40) },
		{ text = "Costa Sol", dir = Vector3.new(1, 0, -0.3), color = Color3.fromRGB(40, 180, 200) },
	})
	-- Banderas y parada de autobus
	Details.flag(plaza, CFrame.new(28, 0.6, 50), Color3.fromRGB(255, 110, 70), "TINY EMPIRE")
	Details.flag(plaza, CFrame.new(-28, 0.6, 50), Color3.fromRGB(80, 160, 255), "⭐")
	Details.flag(plaza, CFrame.new(28, 0.6, -50), Color3.fromRGB(90, 200, 120), "⭐")
	Details.flag(plaza, CFrame.new(-28, 0.6, -50), Color3.fromRGB(255, 200, 60), "TINY EMPIRE")
	Details.busStop(plaza, CFrame.new(72, 0.2, 30))
	-- Trampolines (fisica de salto en el cliente)
	Details.trampoline(plaza, CFrame.lookAt(Vector3.new(44, 0.6, 0), Vector3.new(0, 0.6, 0)), Color3.fromRGB(255, 90, 160))
	Details.trampoline(plaza, CFrame.lookAt(Vector3.new(-44, 0.6, 0), Vector3.new(0, 0.6, 0)), Color3.fromRGB(80, 200, 255))
	-- Zona de recogida de maletines
	local crates = Instance.new("Folder")
	crates.Name = "Crates"
	crates.Parent = map
	return plaza
end

------------------------------------------------------------------------------
-- CARRETERAS
------------------------------------------------------------------------------

local function buildRoads(map)
	local roads = Kit.model(map, "Roads")
	local RX, RZ = WorldBuilder.RingX, WorldBuilder.RingZ
	-- Avenidas principales en cruz
	road(roads, Vector3.new(RX * 2, 0.3, 24), CFrame.new(0, 0.15, 0), true)
	road(roads, Vector3.new(24, 0.3, RZ * 2), CFrame.new(0, 0.15, 0), false)
	for _, s in ipairs({ -1, 1 }) do
		sidewalk(roads, Vector3.new(RX * 2, 0.5, 4), CFrame.new(0, 0.25, s * 14))
		sidewalk(roads, Vector3.new(4, 0.5, RZ * 2), CFrame.new(s * 14, 0.25, 0))
	end
	-- Anillo exterior
	for _, s in ipairs({ -1, 1 }) do
		road(roads, Vector3.new(RX * 2 + 20, 0.3, 20), CFrame.new(0, 0.16, s * RZ), true)
		road(roads, Vector3.new(20, 0.3, RZ * 2 + 20), CFrame.new(s * RX, 0.16, 0), false)
	end
	-- Calles laterales entre parcelas
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			road(roads, Vector3.new(18, 0.3, RZ - 22), CFrame.new(sx * 175, 0.15, sz * (12 + (RZ - 22) / 2 - 0.5)), false)
		end
	end
	return roads
end

------------------------------------------------------------------------------
-- BARRIOS: decoracion, tiendas y elementos tematicos
------------------------------------------------------------------------------

local SHOPS = {
	{ "Supermercado", "🛒" },
	{ "Floristería", "🌷" },
	{ "Banco", "🏦" },
	{ "Cine", "🎬" },
	{ "Heladería", "🍨" },
	{ "Librería", "📚" },
	{ "Gimnasio", "🏋️" },
	{ "Pizzería", "🍕" },
	{ "Farmacia", "💊" },
	{ "Peluquería", "💈" },
	{ "Tienda Surf", "🏄" },
	{ "Ferretería", "🔨" },
	{ "Hotel", "🏨" },
	{ "Museo", "🏛️" },
	{ "Arcade", "🕹️" },
	{ "Mercado", "🧺" },
}

local function shop(parent, cf, pal, name, icon, floors)
	local m = Kit.model(parent, "Shop")
	local w, d = 16, 12
	local h = floors * 6
	local wall = (floors % 2 == 0) and pal.wall or pal.wall2
	Kit.box(m, "Wall", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), wall)
	Kit.windows(m, cf * CFrame.new(0, h / 2 + 2, -d / 2 - 0.1), w - 2, h - 5, math.max(1, floors - 1), 3, Color3.fromRGB(170, 220, 255), pal.trim)
	Kit.box(m, "Storefront", Vector3.new(w - 3, 3.6, 0.3), cf * CFrame.new(0, 2.2, -d / 2 - 0.15), Color3.fromRGB(170, 220, 255), Enum.Material.Glass, { Transparency = 0.3 })
	Kit.awning(m, cf * CFrame.new(0, 4.6, -d / 2 - 1.3), w - 2, 2.6, pal.accent, WHITE)
	Kit.box(m, "Cornice", Vector3.new(w + 0.8, 0.8, d + 0.8), cf * CFrame.new(0, h + 0.4, 0), pal.trim)
	local sign = Kit.box(m, "Sign", Vector3.new(10, 2, 0.4), cf * CFrame.new(0, h + 1.8, -d / 2 + 0.6), WHITE)
	Kit.surfaceText(sign, icon .. " " .. name, Enum.NormalId.Front, WHITE, pal.accent:Lerp(Color3.new(0, 0, 0), 0.25))
	local glow = Kit.box(m, "Glow", Vector3.new(w - 3, 0.2, 0.2), cf * CFrame.new(0, 4.1, -d / 2 - 0.4), Color3.fromRGB(255, 230, 170), Enum.Material.Neon)
	Kit.light(glow, Color3.fromRGB(255, 220, 160), 14, 1.2)
	Details.rooftop(m, cf * CFrame.new(0, h + 0.8, 0), w, d, Random.new(#name * 31 + floors))
	-- Escalon de entrada y macetas
	Kit.box(m, "Step", Vector3.new(4, 0.4, 1.4), cf * CFrame.new(0, 0.2, -d / 2 - 0.7), Color3.fromRGB(200, 200, 205), Enum.Material.Concrete)
	for _, x in ipairs({ -w / 2 + 1.2, w / 2 - 1.2 }) do
		Kit.box(m, "Pot", Vector3.new(1.4, 1, 1.4), cf * CFrame.new(x, 0.5, -d / 2 - 1), Color3.fromRGB(190, 120, 80), Enum.Material.Brick)
		Kit.ball(m, "Plant", 1.8, cf * CFrame.new(x, 1.6, -d / 2 - 1), Color3.fromRGB(80, 170, 80), Enum.Material.Grass, { CanCollide = false })
	end
	return m
end

local function containers(parent, cf)
	local colors = { Color3.fromRGB(220, 70, 60), Color3.fromRGB(60, 120, 200), Color3.fromRGB(240, 180, 40), Color3.fromRGB(60, 170, 110) }
	for i = 0, 3 do
		for j = 0, 1 do
			local c = Kit.box(parent, "Container", Vector3.new(6, 6, 14), cf * CFrame.new(i * 6.4, 3 + j * 6.05, 0), colors[((i + j * 2) % 4) + 1], Enum.Material.CorrodedMetal)
			c.Name = "Container"
		end
	end
end

local function portCrane(parent, cf)
	local m = Kit.model(parent, "PortCrane")
	local y = Color3.fromRGB(240, 180, 40)
	for _, x in ipairs({ -5, 5 }) do
		for _, z in ipairs({ -4, 4 }) do
			Kit.box(m, "Leg", Vector3.new(1.2, 24, 1.2), cf * CFrame.new(x, 12, z), y, Enum.Material.Metal)
		end
	end
	Kit.box(m, "Top", Vector3.new(12, 2, 10), cf * CFrame.new(0, 25, 0), y, Enum.Material.Metal)
	local arm = Kit.box(m, "Boom", Vector3.new(2, 1.6, 34), cf * CFrame.new(0, 27, -10), y, Enum.Material.Metal)
	arm.Name = "Boom"
	Kit.box(m, "Cabin", Vector3.new(3, 3, 3), cf * CFrame.new(0, 23, -3), Color3.fromRGB(60, 60, 70))
	local hook = Kit.box(m, "Hook", Vector3.new(4, 1, 6), cf * CFrame.new(0, 16, -18), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	hook:AddTag("TE_Slide")
	hook:SetAttribute("SlideOffset", Vector3.new(0, 8, 0))
	hook:SetAttribute("SlideSpeed", 0.08)
	hook:SetAttribute("SlideMode", "pingpong")
	return m
end

local function pond(parent, cf, r)
	Kit.cylinder(parent, "PondEdge", 0.8, r * 2 + 3, cf * CFrame.new(0, 0.4, 0), Color3.fromRGB(150, 140, 120), Enum.Material.Slate)
	Kit.cylinder(parent, "Pond", 0.85, r * 2, cf * CFrame.new(0, 0.45, 0), Color3.fromRGB(70, 160, 220), Enum.Material.Glass, { Transparency = 0.15 })
	for i = 0, 2 do
		local a = math.rad(i * 120 + 20)
		Kit.cylinder(parent, "LilyPad", 0.1, 2.2, cf * CFrame.new(math.cos(a) * r * 0.5, 0.95, math.sin(a) * r * 0.5), Color3.fromRGB(90, 180, 80))
	end
end

local function beach(parent, sx, sz)
	local RX = WorldBuilder.RingX
	local cx = sx * (RX + 50)
	Kit.box(parent, "Sand", Vector3.new(80, 0.6, 360), CFrame.new(cx, 0.2, sz * 120), Color3.fromRGB(240, 220, 160), Enum.Material.Sand)
	Kit.box(parent, "Sea", Vector3.new(220, 0.6, 520), CFrame.new(cx + sx * 150, 0.05, 0), Color3.fromRGB(60, 170, 230), Enum.Material.Glass, { Transparency = 0.1, CanCollide = true })
	for i = 0, 4 do
		local z = sz * (40 + i * 55)
		local u = Kit.model(parent, "BeachUmbrella")
		local c = CFrame.new(cx + sx * 10, 0.5, z)
		Kit.cylinder(u, "Pole", 7, 0.3, c * CFrame.new(0, 3.5, 0), WHITE)
		Kit.cylinder(u, "Top", 0.5, 8, c * CFrame.new(0, 7, 0), (i % 2 == 0) and Color3.fromRGB(255, 100, 90) or Color3.fromRGB(60, 190, 210), Enum.Material.Fabric)
		Kit.box(u, "Towel", Vector3.new(3, 0.1, 6), c * CFrame.new(2, 0.35, 0), Color3.fromRGB(255, 220, 90), Enum.Material.Fabric)
		Kit.tree(parent, CFrame.new(cx - sx * 22, 0.5, z + 20), "palm")
	end
end

local function buildNeighborhood(map, q, hoodIndex)
	local pal = Palettes.Neighborhoods[hoodIndex]
	local hood = Kit.model(map, "Barrio_" .. pal.id)
	local sx, sz = q.sx, q.sz
	local RX, RZ = WorldBuilder.RingX, WorldBuilder.RingZ

	-- Suelo del barrio
	Kit.box(hood, "HoodGround", Vector3.new(RX - 14, 0.2, RZ - 24), CFrame.new(sx * (14 + (RX - 14) / 2), 0.05, sz * (14 + (RZ - 24) / 2 - 2)), pal.ground, pal.groundMaterial, { CastShadow = false })

	-- Arco de entrada del barrio sobre la calle lateral
	local archCF = CFrame.new(sx * 175, 0, sz * 22)
	for _, dx in ipairs({ -10, 10 }) do
		Kit.box(hood, "ArchPillar", Vector3.new(2, 14, 2), archCF * CFrame.new(dx, 7, 0), pal.trim)
	end
	local archSign = Kit.box(hood, "ArchSign", Vector3.new(22, 4, 1), archCF * CFrame.new(0, 15, 0), pal.accent)
	Kit.surfaceText(archSign, pal.name, Enum.NormalId.Front, pal.accent, WHITE)
	Kit.surfaceText(archSign, pal.name, Enum.NormalId.Back, pal.accent, WHITE)

	-- Farolas y arboles a lo largo de las calles
	for i = 0, 6 do
		local x = sx * (40 + i * 44)
		Kit.lamp(hood, CFrame.lookAt(Vector3.new(x, 0.2, sz * 18), Vector3.new(x, 0.2, 0)), nil, pal.lamp)
		Kit.tree(hood, CFrame.new(x + sx * 20, 0.2, sz * 21), pal.tree, pal.treeColor)
	end
	for i = 0, 3 do
		local z = sz * (40 + i * 40)
		Kit.lamp(hood, CFrame.lookAt(Vector3.new(sx * 18, 0.2, z), Vector3.new(0, 0.2, z)), nil, pal.lamp)
		Kit.tree(hood, CFrame.new(sx * 30, 0.2, z + sz * 10), pal.tree, pal.treeColor)
	end

	-- Tiendas decorativas mas alla del anillo exterior
	for i = 0, 3 do
		local x = sx * (50 + i * 70)
		local shopInfo = SHOPS[(hoodIndex - 1) * 4 + i + 1]
		local cf = CFrame.lookAt(Vector3.new(x, 0.2, sz * (RZ + 22)), Vector3.new(x, 0.2, 0))
		shop(hood, cf, pal, shopInfo[1], shopInfo[2], 2 + (i % 3))
		Kit.tree(hood, CFrame.new(x + sx * 35, 0.2, sz * (RZ + 20)), pal.tree, pal.treeColor)
		Kit.lamp(hood, CFrame.lookAt(Vector3.new(x + sx * 12, 0.2, sz * (RZ + 13)), Vector3.new(x + sx * 12, 0.2, 0)), nil, pal.lamp)
	end
	-- Acera exterior
	Kit.box(hood, "OuterSidewalk", Vector3.new(RX, 0.5, 6), CFrame.new(sx * RX / 2, 0.25, sz * (RZ + 13)), pal.path, pal.pathMaterial)

	-- Elementos tematicos
	if pal.id == "pastel" then
		for i = 0, 5 do
			Kit.tree(hood, CFrame.new(sx * (360 + (i % 2) * 15), 0.2, sz * (30 + i * 28)), "blossom", pal.treeColor)
		end
		Kit.flowerBed(hood, CFrame.new(sx * 175, 0.2, sz * 172), 14, 4)
	elseif pal.id == "green" then
		pond(hood, CFrame.new(sx * 370, 0.2, sz * 80), 16)
		for i = 0, 8 do
			Kit.tree(hood, CFrame.new(sx * (355 + (i % 3) * 14), 0.2, sz * (10 + i * 20)), "pine", pal.treeColor)
		end
		Kit.fence(hood, Vector3.new(sx * 343, 0.2, sz * 5), Vector3.new(sx * 343, 0.2, sz * 175), pal.fence)
	elseif pal.id == "industrial" then
		containers(hood, CFrame.new(sx * 350, 0.2, sz * 40) * CFrame.Angles(0, math.rad(90), 0))
		containers(hood, CFrame.new(sx * 350, 0.2, sz * 110) * CFrame.Angles(0, math.rad(90), 0))
		portCrane(hood, CFrame.new(sx * 385, 0.2, sz * 75) * CFrame.Angles(0, math.rad(sx > 0 and -90 or 90), 0))
		Kit.box(hood, "Dock", Vector3.new(60, 1, 200), CFrame.new(sx * 380, 0.3, sz * 90), Color3.fromRGB(150, 150, 155), Enum.Material.Concrete)
	elseif pal.id == "coast" then
		beach(hood, sx, sz)
	end
	return hood, pal
end

------------------------------------------------------------------------------
-- AFUERAS: arboledas, colinas y casitas para que el horizonte no quede vacio
------------------------------------------------------------------------------

local function house(parent, cf, wall, roof)
	local m = Kit.model(parent, "House")
	Kit.box(m, "Wall", Vector3.new(12, 8, 10), cf * CFrame.new(0, 4, 0), wall)
	Kit.wedge(m, "Roof", Vector3.new(13, 4, 5.5), cf * CFrame.new(0, 10, -2.75), roof)
	Kit.wedge(m, "Roof", Vector3.new(13, 4, 5.5), cf * CFrame.new(0, 10, 2.75) * CFrame.Angles(0, math.rad(180), 0), roof)
	Kit.box(m, "Door", Vector3.new(2.6, 4.6, 0.3), cf * CFrame.new(0, 2.3, -5.1), Color3.fromRGB(120, 80, 55), Enum.Material.Wood)
	Kit.windows(m, cf * CFrame.new(0, 5, -5.1), 10, 3, 1, 2, Color3.fromRGB(170, 220, 255), WHITE)
	return m
end

local function buildOutskirts(map)
	local out = Kit.model(map, "Outskirts")
	local rng = Random.new(2024)
	local styles = { "round", "pine", "round", "blossom" }
	local RX, RZ = WorldBuilder.RingX, WorldBuilder.RingZ
	-- Arboledas al norte y al sur (detras de las tiendas)
	for _, sz in ipairs({ -1, 1 }) do
		for i = 0, 40 do
			local x = -470 + i * 23 + rng:NextNumber(-6, 6)
			local z = sz * (RZ + 78 + rng:NextNumber(0, 80))
			local inCoast = x > RX + 5
			if not inCoast then
				local style = styles[rng:NextInteger(1, #styles)]
				Kit.tree(out, CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), style)
			end
		end
		-- Casitas
		for i = 0, 6 do
			local x = -300 + i * 95
			if x < RX - 20 then
				local z = sz * (RZ + 58)
				local wall = Color3.fromHSV(rng:NextNumber(0, 1), 0.25, 0.95)
				local roof = Color3.fromHSV(rng:NextNumber(0, 1), 0.55, 0.7)
				house(out, CFrame.lookAt(Vector3.new(x, 0, z), Vector3.new(x, 0, 0)), wall, roof)
			end
		end
	end
	-- Colinas en el horizonte oeste
	for i = 0, 6 do
		local z = -280 + i * 95
		local d = 70 + rng:NextNumber(0, 40)
		Kit.ball(out, "Hill", d, CFrame.new(-500 - rng:NextNumber(0, 30), -d * 0.28, z), Color3.fromRGB(95, 160, 85):Lerp(Color3.fromRGB(70, 130, 70), rng:NextNumber(0, 1)), Enum.Material.Grass)
	end
	for i = 0, 5 do
		local x = -420 + i * 150
		local d = 60 + rng:NextNumber(0, 40)
		if x < RX then
			Kit.ball(out, "Hill", d, CFrame.new(x, -d * 0.3, -360 - rng:NextNumber(0, 20)), Color3.fromRGB(100, 165, 90), Enum.Material.Grass)
			Kit.ball(out, "Hill", d, CFrame.new(x + 60, -d * 0.3, 360 + rng:NextNumber(0, 20)), Color3.fromRGB(100, 165, 90), Enum.Material.Grass)
		end
	end
	return out
end

------------------------------------------------------------------------------
-- VEHICULOS DECORATIVOS (el cliente los mueve por el anillo)
------------------------------------------------------------------------------

local function buildVehicles(map)
	local folder = Instance.new("Folder")
	folder.Name = "Vehicles"
	folder:SetAttribute("RingX", WorldBuilder.RingX)
	folder:SetAttribute("RingZ", WorldBuilder.RingZ)
	folder.Parent = map
	local colors = {
		Color3.fromRGB(255, 90, 90),
		Color3.fromRGB(80, 160, 255),
		Color3.fromRGB(255, 210, 60),
		Color3.fromRGB(120, 220, 120),
		Color3.fromRGB(255, 255, 255),
		Color3.fromRGB(190, 120, 255),
		Color3.fromRGB(255, 150, 60),
		Color3.fromRGB(60, 200, 200),
	}
	local kinds = { "car", "car", "van", "car", "truck", "car", "van", "car", "car", "truck", "car", "van" }
	for i = 1, 12 do
		local car = Kit.car(folder, CFrame.new(0, 0.3, 0), colors[(i - 1) % #colors + 1], kinds[i])
		car:AddTag("TE_Car")
		car:SetAttribute("Phase", (i - 1) / 12 + (i % 2) * 0.03)
		car:SetAttribute("Lane", i % 2 == 0 and 1 or -1)
		car:SetAttribute("Speed", 24 + (i % 4) * 4)
	end
	-- Autobus aparcado en la plaza
	local bus = Kit.model(map, "Bus")
	local bc = CFrame.new(64, 0.3, 30) * CFrame.Angles(0, 0, 0)
	Kit.box(bus, "Body", Vector3.new(6, 6, 22), bc * CFrame.new(0, 4, 0), Color3.fromRGB(255, 200, 40))
	Kit.box(bus, "Windows", Vector3.new(6.1, 2, 20), bc * CFrame.new(0, 5, 0), Color3.fromRGB(150, 200, 240), Enum.Material.Glass, { Transparency = 0.2 })
	local busSign = Kit.box(bus, "Sign", Vector3.new(5, 1, 0.2), bc * CFrame.new(0, 6.5, -11.1), Color3.fromRGB(20, 20, 20))
	Kit.surfaceText(busSign, "PLAZA ⭐", Enum.NormalId.Front, Color3.fromRGB(20, 20, 20), Color3.fromRGB(255, 160, 40))
	for _, z in ipairs({ -7, 7 }) do
		for _, x in ipairs({ -3, 3 }) do
			Kit.cylinderX(bus, "Wheel", 1, 2.6, bc * CFrame.new(x, 1.3, z), Color3.fromRGB(30, 30, 35))
		end
	end
end

------------------------------------------------------------------------------

function WorldBuilder.build()
	local existing = workspace:FindFirstChild("TinyEmpireMap")
	if existing then
		existing:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "TinyEmpireMap"

	lighting()

	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	Kit.box(map, "Ground", Vector3.new(1100, 4, 800), CFrame.new(0, -2, 0), Color3.fromRGB(120, 190, 100), Enum.Material.Grass)

	buildRoads(map)
	buildPlaza(map)

	local plots = {}
	for qi, q in ipairs(QUADRANTS) do
		local _, pal = buildNeighborhood(map, q, q.hood)
		for k, px in ipairs({ 100, 250 }) do
			local center = Vector3.new(q.sx * px, 0.2, q.sz * 105)
			local cf = CFrame.lookAt(center, center + Vector3.new(0, 0, -q.sz))
			table.insert(plots, {
				index = (qi - 1) * 2 + k,
				cframe = cf,
				neighborhood = pal,
				hoodIndex = q.hood,
			})
		end
	end

	buildVehicles(map)
	buildOutskirts(map)
	Details.crossings(map, WorldBuilder.RingX, WorldBuilder.RingZ)
	Details.streetFurniture(map)
	Details.pedestrians(map)
	Details.clouds(map)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.6, -44)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Parent = map
	local oldSpawn = workspace:FindFirstChildOfClass("SpawnLocation")
	if oldSpawn and oldSpawn ~= spawn then
		oldSpawn:Destroy()
	end

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = map

	map.Parent = workspace
	return map, plots
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="28">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="29">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">160</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="30">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">TinyEmpireClient</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Animaciones del mundo en el cliente (suaves y sin coste de red).
--   TE_Spin / TE_Bob / TE_Slide  movimiento de maquinas y objetos (con aceleracion
--                                al aparecer y "squash & stretch" al flotar)
--   TE_Pulse                     neones que laten
--   TE_Sway                      balanceo: "yaw" (giro) o "tilt" (arboles al viento)
--   TE_Flag                      banderas por segmentos que ondean como tela
--   TE_Cloud                     nubes a la deriva
-- Ademas: construccion animada, "+$" con trayectoria parabolica, botones de compra
-- que laten, trafico (World/Traffic) y peatones (World/Pedestrians).

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage:WaitForChild("TinyEmpireShared").Format)
local Traffic = require(script.Parent.World.Traffic)
local Pedestrians = require(script.Parent.World.Pedestrians)

local Animator = {}

local entries = {} -- [Instance] = entry
local flags = {}
local clouds = {}
local trafficLights = {}
local pads = {}
local popups = {}
local ACTIVE_RANGE = 320

-- Viento global: rafagas lentas que modulan arboles y banderas
local function wind(t)
	return 0.75 + 0.25 * math.sin(t * 0.21) + 0.15 * math.sin(t * 0.83 + 1.3)
end

local function pivotOf(inst)
	if inst:IsA("Model") then
		return inst:GetPivot()
	end
	return inst.CFrame
end

local function setPivot(inst, cf)
	if inst:IsA("Model") then
		inst:PivotTo(cf)
	else
		inst.CFrame = cf
	end
end

local function register(inst)
	if entries[inst] then
		entries[inst].dirtyTags = true
		return
	end
	if not (inst:IsA("BasePart") or inst:IsA("Model")) then
		return
	end
	entries[inst] = {
		inst = inst,
		base = pivotOf(inst),
		baseTransparency = inst:IsA("BasePart") and inst.Transparency or 0,
		seed = math.random() * 10,
		born = os.clock(),
		active = true,
		dirtyTags = true,
	}
end

local function unregister(inst)
	entries[inst] = nil
end

local function refreshTags(e)
	local inst = e.inst
	e.spin = inst:HasTag("TE_Spin")
	e.bob = inst:HasTag("TE_Bob")
	e.slide = inst:HasTag("TE_Slide")
	e.pulse = inst:HasTag("TE_Pulse") and inst:IsA("BasePart")
	e.sway = inst:HasTag("TE_Sway")
	e.swayMode = inst:GetAttribute("SwayMode") or "yaw"
	e.swayAngle = math.rad(inst:GetAttribute("SwayAngle") or 15)
	e.swaySpeed = inst:GetAttribute("SwaySpeed") or 0.5
	e.spinSpeed = math.rad(inst:GetAttribute("SpinSpeed") or 45)
	e.spinAxis = inst:GetAttribute("SpinAxis") or "Y"
	e.bobHeight = inst:GetAttribute("BobHeight") or 1
	e.bobSpeed = inst:GetAttribute("BobSpeed") or 1
	e.slideOffset = inst:GetAttribute("SlideOffset") or Vector3.zero
	e.slideSpeed = inst:GetAttribute("SlideSpeed") or 0.3
	e.slideMode = inst:GetAttribute("SlideMode") or "pingpong"
	e.slidePhase = inst:GetAttribute("SlidePhase") or 0
	e.pulseSpeed = inst:GetAttribute("PulseSpeed") or 1
	e.spinAngle = e.spinAngle or 0
	e.dirtyTags = false
end

-- Movimiento de vaiven con pausa en los extremos (como una maquina real)
local function easedPingPong(phase)
	local x = phase % 1
	local f = x < 0.5 and x * 2 or (1 - x) * 2 -- triangulo 0..1..0
	f = math.clamp((f - 0.08) / 0.84, 0, 1) -- pequenas pausas en los extremos
	return f * f * (3 - 2 * f)
end

local function step(t, dt)
	local w = wind(t)
	for inst, e in pairs(entries) do
		if not e.active then
			continue
		end
		if e.dirtyTags then
			refreshTags(e)
		end
		local moved = e.spin or e.bob or e.slide or e.sway
		if moved then
			local cf = e.base
			if e.slide then
				local phase = t * e.slideSpeed + e.slidePhase
				local f = e.slideMode == "loop" and (phase % 1) or easedPingPong(phase)
				cf = cf * CFrame.new(e.slideOffset * f)
			end
			if e.bob then
				cf = cf + Vector3.new(0, math.sin((t + e.seed) * e.bobSpeed * math.pi) * e.bobHeight, 0)
			end
			if e.sway then
				local s = math.sin((t + e.seed) * e.swaySpeed * math.pi * 2)
				if e.swayMode == "tilt" then
					-- Arbol: se inclina desde la base, con rafagas de viento
					local s2 = math.sin((t + e.seed) * e.swaySpeed * 1.7 * math.pi * 2 + 1.1)
					cf = cf * CFrame.Angles(s * e.swayAngle * w, 0, s2 * e.swayAngle * 0.6 * w)
				else
					cf = cf * CFrame.Angles(0, s * e.swayAngle, 0)
				end
			end
			if e.spin then
				-- Arranque progresivo durante el primer segundo (inercia)
				local ramp = math.clamp((os.clock() - e.born) / 1.2, 0, 1)
				e.spinAngle += e.spinSpeed * dt * ramp * ramp
				local a = e.spinAngle + e.seed
				if e.spinAxis == "X" then
					cf = cf * CFrame.Angles(a, 0, 0)
				elseif e.spinAxis == "Z" then
					cf = cf * CFrame.Angles(0, 0, a)
				else
					cf = cf * CFrame.Angles(0, a, 0)
				end
			end
			setPivot(inst, cf)
		end
		if e.pulse then
			local s = (math.sin((t + e.seed) * e.pulseSpeed * math.pi * 2) + 1) / 2
			inst.Transparency = e.baseTransparency + s * s * 0.45
		end
	end
end

-- Solo se animan objetos cercanos a la camara
local function updateActive(camPos)
	for _, e in pairs(entries) do
		local ok, pos = pcall(function()
			return e.base.Position
		end)
		e.active = ok and (pos - camPos).Magnitude < ACTIVE_RANGE
	end
end

------------------------------------------------------------------------------
-- Banderas: segmentos encadenados con onda que avanza hacia el extremo
------------------------------------------------------------------------------

local function registerFlag(model)
	local segs = {}
	local n = model:GetAttribute("Segments") or 5
	for i = 1, n do
		local seg = model:FindFirstChild("Seg" .. i)
		if seg then
			table.insert(segs, seg)
		end
	end
	table.insert(flags, {
		model = model,
		segs = segs,
		width = model:GetAttribute("SegmentWidth") or 1,
		hinge = model:GetPivot(),
		seed = math.random() * 10,
	})
end

local function stepFlags(t, camPos)
	local w = wind(t)
	for _, f in ipairs(flags) do
		if f.model.Parent and (f.hinge.Position - camPos).Magnitude < 220 then
			-- La bandera apunta a favor del viento y la onda recorre la tela
			local cf = f.hinge * CFrame.Angles(0, math.sin(t * 0.4 + f.seed) * 0.35 * w, 0) * CFrame.new(0.2, 0, 0)
			for i, seg in ipairs(f.segs) do
				local amp = 0.22 + 0.1 * i
				local bend = math.sin(t * 4.2 * w - i * 0.9 + f.seed) * amp * w
				local droop = (1 - w) * 0.05 * i
				cf = cf * CFrame.Angles(0, bend, -droop)
				seg.CFrame = cf * CFrame.new(f.width / 2, 0, 0)
				cf = cf * CFrame.new(f.width, 0, 0)
			end
		end
	end
end

------------------------------------------------------------------------------
-- Nubes y semaforos
------------------------------------------------------------------------------

local function stepClouds(t)
	for _, c in ipairs(clouds) do
		if c.model.Parent then
			local x = ((c.base.Position.X + t * c.speed + 700) % 1400) - 700
			local bobY = math.sin(t * 0.1 + c.base.Position.Z) * 2
			c.model:PivotTo(CFrame.new(x, c.base.Position.Y + bobY, c.base.Position.Z))
		end
	end
end

local function stepTrafficLights(t)
	for _, tl in ipairs(trafficLights) do
		if tl.model.Parent then
			local state = Traffic.lightState(tl.phase, t)
			if state ~= tl.state then
				tl.state = state
				for _, name in ipairs({ "Red", "Yellow", "Green" }) do
					local lamp = tl.model:FindFirstChild(name)
					if lamp then
						local on = name == state
						lamp.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
						local c = lamp:GetAttribute("OnColor") or Color3.new(1, 1, 1)
						lamp.Color = on and c or c:Lerp(Color3.new(0.1, 0.1, 0.1), 0.75)
					end
				end
			end
		end
	end
end

------------------------------------------------------------------------------
-- Botones de compra: laten y flotan para llamar la atencion
------------------------------------------------------------------------------

local function registerPad(button)
	if pads[button] then
		return
	end
	local info = button:FindFirstChild("Info")
	pads[button] = { button = button, info = info, seed = math.random() * 6 }
end

local function stepPads(t, camPos)
	for button, p in pairs(pads) do
		if not button.Parent then
			pads[button] = nil
		else
			local pad = button.Parent
			if pad:GetAttribute("Visible") and (button.Position - camPos).Magnitude < 120 then
				local s = math.sin(t * 3 + p.seed)
				button.Transparency = 0.12 + (s + 1) * 0.1
				if p.info then
					p.info.StudsOffsetWorldSpace = Vector3.new(0, 5.5 + s * 0.25, 0)
				end
			end
		end
	end
end

------------------------------------------------------------------------------
-- Animacion de construccion: las piezas crecen desde el suelo con rebote
------------------------------------------------------------------------------

local function isAnimated(inst, root)
	local node = inst
	while node and node ~= root do
		if node:HasTag("TE_Spin") or node:HasTag("TE_Bob") or node:HasTag("TE_Slide") or node:HasTag("TE_Sway") then
			return true
		end
		node = node.Parent
	end
	return false
end

Animator.onBuild = nil -- function(position) (rafaga fisica de escombros)

function Animator.playBuild(model)
	local parts = {}
	local minY, maxY = math.huge, -math.huge
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not isAnimated(d, model) then
			table.insert(parts, d)
			minY = math.min(minY, d.Position.Y)
			maxY = math.max(maxY, d.Position.Y)
		end
	end
	if #parts == 0 then
		return
	end
	local height = math.max(4, maxY - minY)
	local center = model:GetPivot().Position
	for _, p in ipairs(parts) do
		local targetCF = p.CFrame
		local targetSize = p.Size
		-- Retraso segun altura y distancia al centro: la obra "sube" por plantas
		local radial = Vector3.new(p.Position.X - center.X, 0, p.Position.Z - center.Z).Magnitude
		local delayTime = ((p.Position.Y - minY) / height) * 0.7 + radial * 0.012
		p.LocalTransparencyModifier = 1
		p.Size = targetSize * 0.15
		p.CFrame = targetCF * CFrame.new(0, -2.5, 0)
		task.delay(delayTime, function()
			if not p.Parent then
				return
			end
			p.LocalTransparencyModifier = 0
			local info = TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			TweenService:Create(p, info, { CFrame = targetCF, Size = targetSize }):Play()
		end)
	end
	-- Nube de polvo y destellos en la base
	local puff = Instance.new("Part")
	puff.Anchored = true
	puff.CanCollide = false
	puff.CanQuery = false
	puff.CanTouch = false
	puff.Transparency = 1
	puff.Size = Vector3.new(1, 1, 1)
	puff.CFrame = CFrame.new(center)
	puff.Parent = workspace
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(240, 225, 200))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(1, 1.8)
	dust.Speed = NumberRange.new(10, 18)
	dust.Drag = 3
	dust.SpreadAngle = Vector2.new(180, 10)
	dust.Parent = puff
	local stars = Instance.new("ParticleEmitter")
	stars.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	stars.Color = ColorSequence.new(Color3.fromRGB(255, 230, 120))
	stars.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) })
	stars.Lifetime = NumberRange.new(1, 1.8)
	stars.Speed = NumberRange.new(12, 22)
	stars.Acceleration = Vector3.new(0, -20, 0)
	stars.SpreadAngle = Vector2.new(60, 60)
	stars.EmissionDirection = Enum.NormalId.Top
	stars.LightEmission = 1
	stars.Parent = puff
	dust:Emit(30)
	stars:Emit(40)
	task.delay(0.7 + 0.3, function()
		stars:Emit(25) -- segundo destello al terminar
	end)
	task.delay(3, function()
		puff:Destroy()
	end)
	if Animator.onBuild then
		Animator.onBuild(center)
	end
end

------------------------------------------------------------------------------
-- "+$" flotantes: saltan con trayectoria parabolica y se desvanecen
------------------------------------------------------------------------------

local POPUP_INTERVAL = 3
local GRAVITY = 22

local function popup(model, amount)
	if not model.Parent then
		return -- el edificio se reconstruyo mientras esperaba
	end
	local cf = model:GetPivot()
	local size = model:GetExtentsSize()
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	local start = cf.Position + Vector3.new(math.random(-3, 3), size.Y * 0.8 + 1, math.random(-3, 3))
	anchor.CFrame = CFrame.new(start)
	anchor.Parent = workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(40, 14)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 140
	bb.LightInfluence = 0
	bb.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "+" .. Format.cash(amount)
	label.TextColor3 = Color3.fromRGB(110, 255, 130)
	label.Parent = bb
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(20, 70, 30)
	stroke.Parent = label
	-- Aparece con rebote (escala) y luego cae en parabola
	TweenService:Create(bb, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(140, 44) }):Play()
	local a = math.random() * math.pi * 2
	table.insert(popups, {
		anchor = anchor,
		label = label,
		stroke = stroke,
		pos = start,
		vel = Vector3.new(math.cos(a) * 2.5, 13, math.sin(a) * 2.5),
		age = 0,
		life = 1.6,
	})
end

local function stepPopups(dt)
	for i = #popups, 1, -1 do
		local p = popups[i]
		p.age += dt
		if p.age >= p.life or not p.anchor.Parent then
			if p.anchor.Parent then
				p.anchor:Destroy()
			end
			table.remove(popups, i)
		else
			p.vel += Vector3.new(0, -GRAVITY * dt, 0)
			p.pos += p.vel * dt
			p.anchor.CFrame = CFrame.new(p.pos)
			local fade = math.clamp((p.age - p.life * 0.55) / (p.life * 0.45), 0, 1)
			p.label.TextTransparency = fade
			p.stroke.Transparency = fade
		end
	end
end

local function popupLoop(plotsFolder)
	while true do
		task.wait(POPUP_INTERVAL)
		local cam = workspace.CurrentCamera
		if cam then
			local camPos = cam.CFrame.Position
			local shown = 0
			for _, plot in ipairs(plotsFolder:GetChildren()) do
				local buildings = plot:FindFirstChild("Buildings")
				if buildings then
					for _, m in ipairs(buildings:GetChildren()) do
						local income = m:GetAttribute("Income")
						if income and income > 0 and shown < 24 then
							local dist = (m:GetPivot().Position - camPos).Magnitude
							if dist < 140 then
								shown += 1
								task.delay(math.random() * 1.2, popup, m, income * POPUP_INTERVAL)
							end
						end
					end
				end
			end
		end
	end
end

------------------------------------------------------------------------------

function Animator.start(map)
	for _, tag in ipairs({ "TE_Spin", "TE_Bob", "TE_Slide", "TE_Pulse", "TE_Sway" }) do
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			register(inst)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(register)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(unregister)
	end
	for _, f in ipairs(CollectionService:GetTagged("TE_Flag")) do
		registerFlag(f)
	end
	for _, tl in ipairs(CollectionService:GetTagged("TE_TrafficLight")) do
		table.insert(trafficLights, { model = tl, phase = tl:GetAttribute("Phase") or 0, state = nil })
	end
	for _, c in ipairs(CollectionService:GetTagged("TE_Cloud")) do
		table.insert(clouds, { model = c, base = c:GetPivot(), speed = c:GetAttribute("Speed") or 3 })
	end
	Traffic.start()
	Pedestrians.start()

	local plotsFolder = map:WaitForChild("Plots")
	local function watchPlot(plot)
		local buildings = plot:WaitForChild("Buildings", 10)
		local padFolder = plot:WaitForChild("Pads", 10)
		if padFolder then
			for _, d in ipairs(padFolder:GetDescendants()) do
				if d.Name == "Button" and d:IsA("BasePart") then
					registerPad(d)
				end
			end
		end
		if not buildings then
			return
		end
		buildings.ChildAdded:Connect(function(m)
			local builtAt = m:GetAttribute("BuiltAt")
			if builtAt and workspace:GetServerTimeNow() - builtAt < 4 then
				task.defer(Animator.playBuild, m)
			end
		end)
	end
	for _, plot in ipairs(plotsFolder:GetChildren()) do
		task.spawn(watchPlot, plot)
	end
	plotsFolder.ChildAdded:Connect(watchPlot)

	local start = os.clock()
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - start
		acc += dt
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		if acc > 0.5 then
			acc = 0
			updateActive(camPos)
		end
		step(t, dt)
		stepFlags(t, camPos)
		stepClouds(t)
		stepTrafficLights(t)
		stepPads(t, camPos)
		stepPopups(dt)
		Traffic.step(dt, t, camPos)
		Pedestrians.step(dt, t, camPos)
	end)
	task.spawn(popupLoop, plotsFolder)
end

Animator._entries = entries
Animator._flags = flags
Animator._popups = popups

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Efectos de pantalla: confeti, dinero volando hacia el contador y destellos.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage:WaitForChild("TinyEmpireShared").Format)
local Theme = require(script.Parent.UI.Theme)

local Effects = {}

local gui
local layer

local CONFETTI = {
	Color3.fromRGB(255, 90, 120),
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(90, 200, 255),
	Color3.fromRGB(120, 230, 120),
	Color3.fromRGB(190, 120, 255),
}

function Effects.init(screenGui)
	gui = screenGui
	layer = Instance.new("Frame")
	layer.Name = "Effects"
	layer.Size = UDim2.fromScale(1, 1)
	layer.BackgroundTransparency = 1
	layer.ZIndex = 80
	layer.Parent = gui
end

function Effects.confetti(count)
	count = count or 60
	for _ = 1, count do
		local piece = Instance.new("Frame")
		piece.Size = UDim2.fromOffset(math.random(8, 14), math.random(12, 20))
		piece.Position = UDim2.new(math.random(), 0, -0.05, 0)
		piece.BackgroundColor3 = CONFETTI[math.random(#CONFETTI)]
		piece.BorderSizePixel = 0
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 81
		piece.Parent = layer
		local duration = 1.6 + math.random() * 1.4
		local goal = {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.25, 0, 1.05, 0),
			Rotation = piece.Rotation + math.random(-540, 540),
		}
		TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), goal):Play()
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

-- Texto "+$X" grande en el centro que vuela hacia el contador
function Effects.cashBurst(amount, target)
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.45)
	label.Size = UDim2.fromOffset(360, 70)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "+" .. Format.cash(amount)
	label.TextColor3 = Color3.fromRGB(120, 255, 140)
	label.ZIndex = 82
	label.Parent = layer
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Color3.fromRGB(20, 70, 30)
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = label
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	-- Monedas
	for _ = 1, 10 do
		local coin = Instance.new("TextLabel")
		coin.AnchorPoint = Vector2.new(0.5, 0.5)
		coin.Position = UDim2.new(0.5, math.random(-120, 120), 0.45, math.random(-60, 60))
		coin.Size = UDim2.fromOffset(34, 34)
		coin.BackgroundTransparency = 1
		coin.TextScaled = true
		coin.Text = "🪙"
		coin.ZIndex = 82
		coin.Parent = layer
		task.delay(0.3 + math.random() * 0.3, function()
			TweenService:Create(coin, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, -100, 0, 40), TextTransparency = 0.6 }):Play()
			task.wait(0.62)
			coin:Destroy()
		end)
	end
	task.delay(0.9, function()
		TweenService:Create(label, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, -100, 0, 40), TextTransparency = 1 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.5), { Transparency = 1 }):Play()
		task.wait(0.55)
		label:Destroy()
		if target then
			Theme.pop(target)
		end
		Theme.play("coin")
	end)
end

-- Destello de color en los bordes de la pantalla
function Effects.flash(color)
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundTransparency = 1
	f.ZIndex = 79
	f.Parent = layer
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 26
	stroke.Color = color
	stroke.Transparency = 0.3
	stroke.Parent = f
	TweenService:Create(stroke, TweenInfo.new(0.7), { Transparency = 1, Thickness = 4 }):Play()
	task.delay(0.75, function()
		f:Destroy()
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="34">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Tiny Empire Tycoon :: arranque del cliente.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("TinyEmpireShared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Store = require(script.Parent.Store)
local Theme = require(script.Parent.UI.Theme)
local Hud = require(script.Parent.UI.Hud)
local Panels = require(script.Parent.UI.Panels)
local Effects = require(script.Parent.Effects)
local Animator = require(script.Parent.Animator)
local Physics = require(script.Parent.Physics)
local Tutorial = require(script.Parent.Tutorial)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("TinyEmpireRemotes")
local map = workspace:WaitForChild("TinyEmpireMap")

local function fire(action, a, b)
	remotes.Action:FireServer(action, a, b)
end

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

------------------------------------------------------------------------------
-- Compras
------------------------------------------------------------------------------

local function buyPass(key)
	local p = Config.GamePasses[key]
	if not p then
		return
	end
	if (p.id or 0) > 0 then
		MarketplaceService:PromptGamePassPurchase(player, p.id)
	elseif Store.state and Store.state.simulation then
		fire("simulate", "pass", key)
	else
		Hud.toast("🛒 Este artículo estará disponible pronto.", Theme.C.grey)
	end
end

local function buyProduct(key)
	local p = Config.Products[key]
	if not p then
		return
	end
	if (p.id or 0) > 0 then
		MarketplaceService:PromptProductPurchase(player, p.id)
	elseif Store.state and Store.state.simulation then
		fire("simulate", "product", key)
	else
		Hud.toast("🛒 Este artículo estará disponible pronto.", Theme.C.grey)
	end
end

------------------------------------------------------------------------------
-- Interfaz
------------------------------------------------------------------------------

Hud.init({
	empire = function()
		Panels.open("empire")
	end,
	challenges = function()
		Panels.open("challenges")
	end,
	shop = function()
		Panels.open("shop")
	end,
	plot = function()
		Panels.close()
		fire("teleport", "plot")
	end,
	plaza = function()
		Panels.close()
		fire("teleport", "plaza")
	end,
	claimGoal = function()
		fire("claimGoal")
	end,
	skipTutorial = function()
		Panels.confirm("¿Saltar el tutorial?", "Puedes consultar cómo jugar en el panel de la plaza central.", function()
			fire("tutorial", "skip")
		end)
	end,
})

Panels.init(Hud.gui(), {
	fire = fire,
	buyPass = buyPass,
	buyProduct = buyProduct,
	onOpen = function(key)
		if key == "challenges" then
			fire("tutorial", "openedChallenges")
		end
	end,
})

Effects.init(Hud.gui())
Animator.onBuild = function(position)
	Physics.debrisBurst(position, 12)
end
Animator.start(map)
Physics.start(Hud.gui())
Tutorial.init(map)

------------------------------------------------------------------------------
-- Red
------------------------------------------------------------------------------

remotes.State.OnClientEvent:Connect(function(state)
	Store.set(state)
	Hud.refresh(state)
	Panels.refresh(state)
	Tutorial.update(state)
end)

remotes.Tick.OnClientEvent:Connect(function(cash, income, runEarned)
	Store.tick(cash, income, runEarned)
end)

remotes.Notify.OnClientEvent:Connect(function(payload)
	Hud.toast(payload.text, payload.color)
	if payload.sound then
		Theme.play(payload.sound)
	end
end)

remotes.Effect.OnClientEvent:Connect(function(payload)
	local kind = payload.kind
	if kind == "confetti" then
		Effects.confetti(70)
	elseif kind == "cash" then
		Effects.cashBurst(payload.amount, Hud.cashPanel())
		if payload.position then
			Physics.coinBurst(payload.position, 14)
		end
	elseif kind == "build" then
		Effects.flash(Theme.C.green)
		if payload.position then
			Physics.coinBurst(payload.position, 10)
		end
	elseif kind == "rain" then
		Effects.flash(Theme.C.gold)
	elseif kind == "levelup" then
		Effects.flash(Theme.C.blue)
		if payload.position then
			Physics.coinBurst(payload.position, 8)
		end
		if payload.level == Config.MaxBusinessLevel then
			Effects.confetti(40)
		end
	elseif kind == "upgrade" then
		Effects.flash(Theme.C.purple)
	elseif kind == "expansion" then
		Effects.flash(Theme.C.gold)
	elseif kind == "offline" then
		Hud.modal("🌙 ¡Bienvenido de vuelta!", string.format("Mientras no estabas (%s), tu imperio ganó:\n%s", Format.time(payload.seconds), Format.cash(payload.amount)), "¡Genial!", Theme.C.gold)
		Effects.confetti(50)
		Theme.play("success")
	end
end)

fire("requestState")
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Physics</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Fisica del lado del cliente (el personaje local es propiedad del cliente):
--  * Trampolines: impulso vertical + lona con muelle amortiguado
--  * Sprint (Shift o boton tactil) con aceleracion suave y cambio de FOV
--  * Rafagas de monedas y escombros: piezas fisicas que rebotan y se desvanecen
--    (grupo de colision TE_Effects: chocan con el suelo pero no con jugadores)

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.UI.Theme)

local Physics = {}

local player = Players.LocalPlayer
local springs = {} -- lonas de trampolin con muelle
local effects = {} -- piezas fisicas temporales
local MAX_EFFECTS = 90

Physics.WALK_SPEED = 16
Physics.SPRINT_SPEED = 26
Physics.BASE_FOV = 70
Physics.SPRINT_FOV = 80

------------------------------------------------------------------------------
-- Trampolines
------------------------------------------------------------------------------

local function setupTrampoline(mat)
	if springs[mat] then
		return
	end
	local spring = { part = mat, base = mat.CFrame, x = 0, v = 0, debounce = 0 }
	springs[mat] = spring
	mat.Touched:Connect(function(hit)
		local character = player.Character
		if not character or not hit:IsDescendantOf(character) then
			return
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.Health <= 0 then
			return
		end
		local now = os.clock()
		if now - spring.debounce < 0.35 then
			return
		end
		spring.debounce = now
		local power = mat:GetAttribute("Power") or 110
		local vel = root.AssemblyLinearVelocity
		-- Conserva el impulso horizontal y suma un poco si se llega corriendo
		root.AssemblyLinearVelocity = Vector3.new(vel.X * 1.1, power, vel.Z * 1.1)
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		spring.v -= 22 -- la lona se hunde
		Theme.play("coin")
	end)
end

local function stepSprings(dt)
	for mat, s in pairs(springs) do
		if mat.Parent then
			-- Oscilador amortiguado: x'' = -k x - c x'
			local k, c = 220, 9
			local acc = -k * s.x - c * s.v
			s.v += acc * dt
			s.x += s.v * dt
			if math.abs(s.x) > 0.001 or math.abs(s.v) > 0.01 then
				mat.CFrame = s.base * CFrame.new(math.clamp(s.x, -1.2, 0.6), 0, 0) -- eje X del cilindro = vertical
			end
		else
			springs[mat] = nil
		end
	end
end

------------------------------------------------------------------------------
-- Sprint
------------------------------------------------------------------------------

local sprinting = false
local currentSpeed = Physics.WALK_SPEED

function Physics.setSprint(on)
	sprinting = on
	local cam = workspace.CurrentCamera
	if cam then
		TweenService:Create(cam, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { FieldOfView = on and Physics.SPRINT_FOV or Physics.BASE_FOV }):Play()
	end
end

function Physics.isSprinting()
	return sprinting
end

local function stepSprint(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local target = sprinting and Physics.SPRINT_SPEED or Physics.WALK_SPEED
	-- Aceleracion progresiva en lugar de un salto brusco de velocidad
	currentSpeed += (target - currentSpeed) * math.min(1, dt * 4)
	if math.abs(humanoid.WalkSpeed - currentSpeed) > 0.05 then
		humanoid.WalkSpeed = currentSpeed
	end
end

------------------------------------------------------------------------------
-- Rafagas de piezas fisicas
------------------------------------------------------------------------------

local function spawnEffect(cf, size, color, material, velocity, angular, lifetime, shape)
	if #effects >= MAX_EFFECTS then
		local old = table.remove(effects, 1)
		if old.part.Parent then
			old.part:Destroy()
		end
	end
	local p = Instance.new("Part")
	p.Name = "TE_Effect"
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	if shape then
		p.Shape = shape
	end
	p.Anchored = false
	p.CanCollide = true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.CollisionGroup = "TE_Effects"
	p.CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.4, 0.5, 1, 1)
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = workspace
	p.AssemblyLinearVelocity = velocity
	p.AssemblyAngularVelocity = angular
	table.insert(effects, { part = p, born = os.clock(), life = lifetime })
	return p
end

local rng = Random.new()

-- Monedas que saltan y rebotan
function Physics.coinBurst(position, count)
	count = count or 12
	for i = 1, count do
		local a = (i / count) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local out = rng:NextNumber(6, 14)
		local vel = Vector3.new(math.cos(a) * out, rng:NextNumber(26, 40), math.sin(a) * out)
		local cf = CFrame.new(position + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, a, math.rad(90))
		spawnEffect(cf, Vector3.new(0.25, 1.3, 1.3), Color3.fromRGB(255, 205, 60), Enum.Material.Foil, vel, Vector3.new(rng:NextNumber(-12, 12), rng:NextNumber(-12, 12), rng:NextNumber(-12, 12)), rng:NextNumber(1.6, 2.4), Enum.PartType.Cylinder)
	end
end

-- Escombros de obra al construir/mejorar (ladrillos y tablas)
local DEBRIS_COLORS = {
	Color3.fromRGB(190, 110, 80),
	Color3.fromRGB(170, 130, 90),
	Color3.fromRGB(220, 220, 225),
	Color3.fromRGB(255, 200, 60),
}
function Physics.debrisBurst(position, count)
	count = count or 14
	for _ = 1, count do
		local a = rng:NextNumber(0, math.pi * 2)
		local out = rng:NextNumber(5, 16)
		local size = Vector3.new(rng:NextNumber(0.5, 1.4), rng:NextNumber(0.4, 0.8), rng:NextNumber(0.5, 1.6))
		local vel = Vector3.new(math.cos(a) * out, rng:NextNumber(18, 34), math.sin(a) * out)
		local cf = CFrame.new(position + Vector3.new(math.cos(a) * 3, 1.5, math.sin(a) * 3)) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0)
		local material = rng:NextNumber() < 0.5 and Enum.Material.Brick or Enum.Material.Wood
		spawnEffect(cf, size, DEBRIS_COLORS[rng:NextInteger(1, #DEBRIS_COLORS)], material, vel, Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-8, 8), rng:NextNumber(-8, 8)), rng:NextNumber(1.8, 2.6))
	end
end

local function stepEffects()
	local now = os.clock()
	for i = #effects, 1, -1 do
		local e = effects[i]
		local age = now - e.born
		if not e.part.Parent then
			table.remove(effects, i)
		elseif age > e.life then
			e.part:Destroy()
			table.remove(effects, i)
		elseif age > e.life - 0.5 then
			-- desvanecer y encoger al final
			local k = (e.life - age) / 0.5
			e.part.LocalTransparencyModifier = 1 - k
		end
	end
end

------------------------------------------------------------------------------

function Physics.start(hud)
	for _, mat in ipairs(CollectionService:GetTagged("TE_Trampoline")) do
		setupTrampoline(mat)
	end
	CollectionService:GetInstanceAddedSignal("TE_Trampoline"):Connect(setupTrampoline)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			Physics.setSprint(true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			Physics.setSprint(false)
		end
	end)
	-- Boton de sprint para moviles
	if UserInputService.TouchEnabled and hud then
		local btn = Theme.button({
			Name = "SprintButton",
			Text = "🏃",
			Size = UDim2.fromOffset(74, 74),
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -150, 1, -150),
			Color = Theme.C.purple,
			Radius = 37,
			MaxText = 36,
			Parent = hud,
			OnClick = function()
				Physics.setSprint(not sprinting)
			end,
		})
		local _ = btn
	end
	player.CharacterAdded:Connect(function()
		currentSpeed = Physics.WALK_SPEED
	end)

	RunService.Heartbeat:Connect(function(dt)
		dt = math.min(dt, 0.1)
		stepSprings(dt)
		stepSprint(dt)
		stepEffects()
	end)
end

Physics._effects = effects
Physics._springs = springs

return Physics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Estado del jugador recibido del servidor (solo lectura en el cliente).

local Store = {}

Store.state = nil
Store.cash = 0
Store.income = 0

local changed = Instance.new("BindableEvent")
local ticked = Instance.new("BindableEvent")
Store.Changed = changed.Event
Store.Ticked = ticked.Event

function Store.set(state)
	Store.state = state
	Store.cash = state.cash
	Store.income = state.income
	changed:Fire(state)
	ticked:Fire()
end

function Store.tick(cash, income, runEarned)
	Store.cash = cash
	Store.income = income
	if Store.state then
		Store.state.cash = cash
		Store.state.income = income
		Store.state.runEarned = runEarned
	end
	ticked:Fire()
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Tutorial guiado: texto en pantalla + haz de luz desde el jugador hasta el objetivo.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Hud = require(script.Parent.UI.Hud)
local Shared = ReplicatedStorage:WaitForChild("TinyEmpireShared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local TRUCK_COST = Format.cash(Config.BusinessById.foodtruck.cost)

local Tutorial = {}

local player = Players.LocalPlayer
local map
local beam, attach0, attach1, marker
local currentTarget = nil
local highlightTween = nil

Tutorial.Steps = {
	{ text = "👋 ¡Bienvenido a tu parcela! Pisa el botón verde ⬇ para abrir tu Puesto de Limonada (¡gratis!).", pad = "lemonade" },
	{ text = "💰 Tus negocios ganan dinero solos cada segundo. ¡Reúne " .. TRUCK_COST .. " para tu siguiente negocio!" },
	{ text = "🌮 ¡Ya tienes " .. TRUCK_COST .. "! Pisa el botón del Food Truck para comprarlo.", pad = "foodtruck" },
	{ text = "⬆️ Sube de nivel un negocio: pisa su botón azul o usa el menú 🏛️ Imperio.", pad = "lemonade" },
	{ text = "✨ Abre 🏛️ Imperio → Mejoras y compra 'Letrero Llamativo' (+10% de ingresos).", menu = "empire" },
	{ text = "🎯 Abre el menú 🎯 Retos: tienes retos diarios y objetivos de expansión con premios.", menu = "challenges" },
	{ text = "⛲ Visita la plaza central (botón ⛲ Plaza) y recoge maletines 💼 llenos de dinero.", plaza = true, menu = "plaza" },
}

local function ensureBeam()
	if beam and beam.Parent then
		return
	end
	attach1 = Instance.new("Attachment")
	attach1.Name = "TutorialTarget"
	local holder = Instance.new("Part")
	holder.Name = "TutorialAnchor"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.5, 0.5, 0.5)
	holder.Parent = workspace
	attach1.Parent = holder
	beam = Instance.new("Beam")
	beam.Name = "TutorialBeam"
	beam.Attachment1 = attach1
	beam.Width0 = 1.6
	beam.Width1 = 1.6
	beam.FaceCamera = true
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Static
	beam.TextureLength = 3
	beam.TextureSpeed = 2
	beam.LightEmission = 1
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 230, 90), Color3.fromRGB(120, 255, 140))
	beam.Transparency = NumberSequence.new(0.15)
	beam.Segments = 20
	beam.CurveSize0 = 6
	beam.Parent = holder
	marker = Instance.new("BillboardGui")
	marker.Size = UDim2.fromOffset(80, 80)
	marker.StudsOffset = Vector3.new(0, 6, 0)
	marker.AlwaysOnTop = true
	marker.Parent = holder
	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.fromScale(1, 1)
	arrow.BackgroundTransparency = 1
	arrow.Text = "⬇️"
	arrow.TextScaled = true
	arrow.Parent = marker
	TweenService:Create(marker, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { StudsOffset = Vector3.new(0, 8, 0) }):Play()
end

local function attachToCharacter()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	if not attach0 or attach0.Parent ~= root then
		attach0 = Instance.new("Attachment")
		attach0.Name = "TutorialSource"
		attach0.Parent = root
	end
	beam.Attachment0 = attach0
	return true
end

local function setTarget(position)
	currentTarget = position
	if not position then
		if beam then
			beam.Parent.Parent = nil
		end
		return
	end
	ensureBeam()
	beam.Parent.Parent = workspace
	beam.Parent.CFrame = CFrame.new(position)
	attachToCharacter()
end

local function highlightMenu(key)
	if highlightTween then
		highlightTween:Cancel()
		highlightTween = nil
	end
	for _, k in ipairs({ "empire", "challenges", "plaza" }) do
		local btn = Hud.menuButton(k)
		if btn then
			local stroke = btn:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Thickness = 3
			end
		end
	end
	if key then
		local btn = Hud.menuButton(key)
		local stroke = btn and btn:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Thickness = 3
			highlightTween = TweenService:Create(stroke, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 8 })
			highlightTween:Play()
		end
	end
end

function Tutorial.update(state)
	local step = state.tutorial or 99
	local def = Tutorial.Steps[step]
	if not def then
		Hud.setTutorial(nil)
		setTarget(nil)
		highlightMenu(nil)
		return
	end
	Hud.setTutorial(step, #Tutorial.Steps, def.text)
	highlightMenu(def.menu)
	local target = nil
	if def.pad and state.plotIndex then
		local plot = map.Plots:FindFirstChild("Plot" .. state.plotIndex)
		local pad = plot and plot.Pads:FindFirstChild("Pad_" .. def.pad)
		local button = pad and pad:FindFirstChild("Button")
		if button then
			target = button.Position + Vector3.new(0, 1, 0)
		end
	elseif def.plaza then
		target = Vector3.new(0, 10, 0)
	end
	setTarget(target)
end

function Tutorial.init(worldMap)
	map = worldMap
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		if currentTarget and beam then
			attachToCharacter()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if currentTarget and beam and beam.Attachment0 == nil then
			attachToCharacter()
		end
	end)
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="38">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!nonstrict
-- HUD principal: dinero, ingresos, nivel, menu lateral, objetivo actual,
-- notificaciones, tutorial y ventanas emergentes.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("TinyEmpireShared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Theme = require(script.Parent.Theme)
local Store = require(script.Parent.Parent.Store)

local C = Theme.C
local new = Theme.new

local Hud = {}

local player = Players.LocalPlayer
local gui
local refs: any = {}
local menuButtons = {}
local displayedCash = 0

function Hud.gui()
	return gui
end

local function autoScale(screen)
	local scale = new("UIScale", { Parent = screen })
	local function update()
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local vp = cam.ViewportSize
		scale.Scale = math.clamp(math.min(vp.Y / 820, vp.X / 1280), 0.55, 1.15)
	end
	update()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(update)
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	return scale
end

------------------------------------------------------------------------------
-- Barra superior
------------------------------------------------------------------------------

local function buildTopBar()
	local top = new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(560, 74),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = top,
	})

	-- Dinero
	local cash = Theme.panel({ Name = "Cash", Size = UDim2.fromOffset(270, 74), BackgroundColor3 = C.bg, LayoutOrder = 1, Parent = top, Radius = 18 })
	Theme.stroke(C.green, 3).Parent = cash
	Theme.gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 215), 90).Parent = cash
	Theme.label({ Text = "💰", Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(8, 9), MaxText = 44, Parent = cash })
	refs.cashLabel = Theme.label({ Name = "Amount", Text = "$0", Size = UDim2.new(1, -72, 0, 42), Position = UDim2.fromOffset(64, 4), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.white, MaxText = 38, Parent = cash })
	Theme.textStroke(Color3.fromRGB(20, 60, 30), 2.5).Parent = refs.cashLabel
	refs.incomeLabel = Theme.label({ Name = "Income", Text = "+$0/s", Size = UDim2.new(1, -72, 0, 24), Position = UDim2.fromOffset(65, 44), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.green, MaxText = 22, Parent = cash })
	refs.cashPanel = cash

	-- Nivel de imperio
	local lvl = Theme.panel({ Name = "Level", Size = UDim2.fromOffset(270, 74), BackgroundColor3 = C.bg, LayoutOrder = 2, Parent = top, Radius = 18 })
	Theme.stroke(C.gold, 3).Parent = lvl
	Theme.gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 215), 90).Parent = lvl
	Theme.label({ Text = "⭐", Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(10, 6), MaxText = 38, Parent = lvl })
	refs.levelLabel = Theme.label({ Text = "Nivel 1", Size = UDim2.new(1, -70, 0, 26), Position = UDim2.fromOffset(60, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.gold, MaxText = 24, Parent = lvl })
	refs.titleLabel = Theme.label({ Text = "Emprendedor", Size = UDim2.new(1, -70, 0, 18), Position = UDim2.fromOffset(60, 31), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.muted, Font = Theme.Bold, MaxText = 16, Parent = lvl })
	refs.levelBar = Theme.progressBar({ Size = UDim2.new(1, -24, 0, 12), Position = UDim2.fromOffset(12, 54), Color = C.gold, Parent = lvl })
	refs.levelNext = Theme.label({ Text = "", Size = UDim2.new(1, -24, 0, 12), Position = UDim2.fromOffset(12, 54), TextColor3 = C.white, Font = Theme.Bold, MaxText = 10, ZIndex = 3, Parent = lvl })
end

------------------------------------------------------------------------------
-- Menu lateral
------------------------------------------------------------------------------

local function buildMenu(handlers)
	local menu = new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.56, 0),
		Size = UDim2.fromOffset(92, 470),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.list(10).Parent = menu
	local items = {
		{ key = "empire", icon = "🏛️", text = "Imperio", color = C.blue },
		{ key = "challenges", icon = "🎯", text = "Retos", color = C.pink },
		{ key = "shop", icon = "🛒", text = "Tienda", color = C.gold },
		{ key = "plot", icon = "🏠", text = "Parcela", color = C.green },
		{ key = "plaza", icon = "⛲", text = "Plaza", color = C.purple },
	}
	for i, item in ipairs(items) do
		local btn = new("TextButton", {
			Name = item.key,
			Size = UDim2.fromOffset(84, 84),
			BackgroundColor3 = item.color,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = i,
			Parent = menu,
		})
		Theme.corner(20).Parent = btn
		Theme.stroke(item.color:Lerp(Color3.new(0, 0, 0), 0.35), 3).Parent = btn
		Theme.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 200), 90).Parent = btn
		Theme.label({ Text = item.icon, Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 6), MaxText = 40, Parent = btn })
		local l = Theme.label({ Text = item.text, Size = UDim2.new(1, -6, 0, 22), Position = UDim2.fromOffset(3, 54), MaxText = 18, Parent = btn })
		Theme.textStroke(item.color:Lerp(Color3.new(0, 0, 0), 0.5), 2).Parent = l
		local badge = new("Frame", {
			Name = "Badge",
			Size = UDim2.fromOffset(26, 26),
			Position = UDim2.new(1, -18, 0, -8),
			BackgroundColor3 = C.red,
			Visible = false,
			ZIndex = 5,
			Parent = btn,
		})
		Theme.corner(13).Parent = badge
		Theme.stroke(C.white, 2).Parent = badge
		Theme.label({ Text = "!", Size = UDim2.fromScale(1, 1), ZIndex = 6, MaxText = 20, Parent = badge })
		local scale = new("UIScale", { Parent = btn })
		btn.MouseEnter:Connect(function()
			TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.08 }):Play()
		end)
		btn.MouseLeave:Connect(function()
			TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
		end)
		btn.Activated:Connect(function()
			Theme.play("click")
			scale.Scale = 0.9
			TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			if handlers[item.key] then
				handlers[item.key]()
			end
		end)
		menuButtons[item.key] = btn
	end
end

function Hud.setBadge(key, visible)
	local btn = menuButtons[key]
	if btn then
		btn.Badge.Visible = visible
	end
end

function Hud.menuButton(key)
	return menuButtons[key]
end

------------------------------------------------------------------------------
-- Objetivo actual (derecha)
------------------------------------------------------------------------------

local function buildGoal(onClaim)
	local card = Theme.panel({
		Name = "Goal",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.56, 0),
		Size = UDim2.fromOffset(270, 128),
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.08,
		Parent = gui,
	})
	Theme.stroke(C.blue, 2.5).Parent = card
	Theme.label({ Text = "🎯 OBJETIVO DE EXPANSIÓN", Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.blue, MaxText = 16, Parent = card })
	refs.goalText = Theme.label({ Text = "", Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 30), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Bold, MaxText = 18, Parent = card })
	refs.goalBar = Theme.progressBar({ Size = UDim2.new(1, -20, 0, 14), Position = UDim2.fromOffset(10, 60), Color = C.blue, Parent = card })
	refs.goalProgress = Theme.label({ Text = "", Size = UDim2.new(1, -20, 0, 14), Position = UDim2.fromOffset(10, 60), Font = Theme.Bold, MaxText = 12, ZIndex = 3, Parent = card })
	refs.goalButton = Theme.button({ Text = "", Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 82), Color = C.grey, MaxText = 20, Parent = card, OnClick = onClaim })
	refs.goalCard = card
end

------------------------------------------------------------------------------
-- Notificaciones
------------------------------------------------------------------------------

local function buildToasts()
	local holder = new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 94),
		Size = UDim2.fromOffset(460, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.list(6).Parent = holder
	refs.toasts = holder
end

function Hud.toast(text, color)
	color = color or C.blue
	local holder = refs.toasts
	if not holder then
		return
	end
	local count = 0
	for _, c in ipairs(holder:GetChildren()) do
		if c:IsA("Frame") then
			count += 1
		end
	end
	if count >= 4 then
		for _, c in ipairs(holder:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
	local toast = Theme.panel({
		Size = UDim2.fromOffset(440, 42),
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.05,
		LayoutOrder = math.floor(os.clock() * 100) % 1000000000,
		Parent = holder,
		Radius = 12,
	})
	Theme.stroke(color, 2.5).Parent = toast
	local accent = new("Frame", { Size = UDim2.new(0, 8, 1, -12), Position = UDim2.fromOffset(8, 6), BackgroundColor3 = color, Parent = toast })
	Theme.corner(4).Parent = accent
	local label = Theme.label({ Text = text, Size = UDim2.new(1, -34, 1, -10), Position = UDim2.fromOffset(24, 5), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Bold, MaxText = 18, Parent = toast })
	Theme.pop(toast)
	task.delay(3.6, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
			TweenService:Create(toast.UIStroke, TweenInfo.new(0.35), { Transparency = 1 }):Play()
			TweenService:Create(accent, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

------------------------------------------------------------------------------
-- Tutorial (tarjeta inferior)
------------------------------------------------------------------------------

local function buildTutorial(onSkip)
	local card = Theme.panel({
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(560, 92),
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = gui,
		Radius = 18,
	})
	Theme.stroke(C.gold, 3).Parent = card
	refs.tutStep = Theme.label({ Text = "PASO 1/7", Size = UDim2.fromOffset(120, 20), Position = UDim2.fromOffset(14, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.gold, MaxText = 16, Parent = card })
	refs.tutText = Theme.label({ Text = "", Size = UDim2.new(1, -130, 0, 54), Position = UDim2.fromOffset(14, 30), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Bold, TextWrapped = true, MaxText = 20, Parent = card })
	Theme.button({ Text = "Saltar", Size = UDim2.fromOffset(92, 34), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Color = C.greyDark, MaxText = 18, Parent = card, OnClick = onSkip })
	refs.tutCard = card
end

function Hud.setTutorial(stepIndex, total, text)
	local card = refs.tutCard
	if not text then
		card.Visible = false
		return
	end
	local changed = refs.tutText.Text ~= text
	card.Visible = true
	refs.tutStep.Text = string.format("PASO %d/%d", stepIndex, total)
	refs.tutText.Text = text
	if changed then
		Theme.pop(card)
	end
end

------------------------------------------------------------------------------
-- Ventana de ganancias offline / mensajes grandes
------------------------------------------------------------------------------

function Hud.modal(title, body, buttonText, color)
	local shade = new("Frame", {
		Name = "Modal",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		ZIndex = 50,
		Parent = gui,
	})
	local card = Theme.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 250),
		BackgroundColor3 = C.bg,
		ZIndex = 51,
		Parent = shade,
		Radius = 22,
	})
	Theme.stroke(color or C.gold, 4).Parent = card
	Theme.label({ Text = title, Size = UDim2.new(1, -30, 0, 46), Position = UDim2.fromOffset(15, 16), TextColor3 = color or C.gold, ZIndex = 52, MaxText = 34, Parent = card })
	Theme.label({ Text = body, Size = UDim2.new(1, -40, 0, 100), Position = UDim2.fromOffset(20, 68), Font = Theme.Bold, TextWrapped = true, ZIndex = 52, MaxText = 24, Parent = card })
	local btn = Theme.button({
		Text = buttonText or "¡Genial!",
		Size = UDim2.fromOffset(200, 50),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Color = C.green,
		Parent = card,
		OnClick = function()
			shade:Destroy()
		end,
	})
	btn.ZIndex = 52
	btn.Label.ZIndex = 53
	Theme.pop(card)
	return shade
end

------------------------------------------------------------------------------
-- Actualizacion
------------------------------------------------------------------------------

local function refreshGoal(state)
	local goal = Economy.currentGoal(state)
	if not goal then
		refs.goalText.Text = "¡Todos los objetivos completados! 🏆"
		Theme.setProgress(refs.goalBar, 1)
		refs.goalProgress.Text = ""
		Theme.setButton(refs.goalButton, "Completado", C.grey)
		Hud.setBadge("challenges", false)
		return false
	end
	local progress = Economy.goalProgress(state, goal)
	local done = progress >= goal.target
	refs.goalText.Text = goal.text
	Theme.setProgress(refs.goalBar, progress / goal.target, true)
	refs.goalProgress.Text = string.format("%d / %d", math.min(progress, goal.target), goal.target)
	if done then
		Theme.setButton(refs.goalButton, "🎁 Reclamar " .. Format.cash(goal.reward), C.green)
	else
		Theme.setButton(refs.goalButton, "Premio: " .. Format.cash(goal.reward), C.greyDark)
	end
	return done
end

local function refreshLevel()
	local state = Store.state
	if not state then
		return
	end
	local level, info, nextInfo, progress = Economy.empireLevel(state.runEarned)
	refs.levelLabel.Text = "Nivel " .. level
	refs.titleLabel.Text = info.title
	Theme.setProgress(refs.levelBar, progress)
	if nextInfo then
		refs.levelNext.Text = Format.cash(state.runEarned) .. " / " .. Format.cash(nextInfo.need)
	else
		refs.levelNext.Text = "¡NIVEL MÁXIMO!"
	end
	if refs.lastLevel and level > refs.lastLevel then
		Hud.toast("⭐ ¡Nivel de imperio " .. level .. ": " .. info.title .. "!", C.gold)
		Theme.play("levelup")
		Theme.pop(refs.levelLabel.Parent)
	end
	refs.lastLevel = level
end

function Hud.refresh(state)
	local goalDone = refreshGoal(state)
	local dailyReady = false
	if state.daily then
		for _, c in ipairs(state.daily.list) do
			if not c.claimed and c.progress >= c.target then
				dailyReady = true
			end
		end
	end
	Hud.setBadge("challenges", goalDone or dailyReady)
	-- Algo asequible en el menu Imperio
	local affordable = false
	for _, u in ipairs(Config.Upgrades) do
		if Economy.upgradeState(state, u.id) == "available" and state.cash >= u.cost then
			affordable = true
			break
		end
	end
	Hud.setBadge("empire", affordable)
	refreshLevel()
end

function Hud.init(handlers)
	gui = new("ScreenGui", {
		Name = "TinyEmpireHUD",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	autoScale(gui)
	buildTopBar()
	buildMenu(handlers)
	buildGoal(handlers.claimGoal)
	buildToasts()
	buildTutorial(handlers.skipTutorial)

	-- Contador animado de dinero
	RunService.RenderStepped:Connect(function(dt)
		local target = Store.cash
		if math.abs(target - displayedCash) < 0.5 then
			displayedCash = target
		else
			displayedCash += (target - displayedCash) * math.min(1, dt * 8)
		end
		refs.cashLabel.Text = Format.cash(displayedCash)
	end)
	Store.Ticked:Connect(function()
		refs.incomeLabel.Text = "+" .. Format.cash(Store.income) .. "/s"
		refreshLevel()
		if Store.state then
			Hud.refresh(Store.state)
		end
	end)
end

-- Pequeno rebote del contador al ganar dinero
function Hud.bumpCash()
	if refs.cashPanel then
		Theme.pop(refs.cashPanel)
	end
end

function Hud.cashPanel()
	return refs.cashPanel
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Ventanas: Imperio (negocios, mejoras, expansion), Retos y Tienda.

local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("TinyEmpireShared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Theme = require(script.Parent.Theme)
local Store = require(script.Parent.Parent.Store)

local C = Theme.C
local new = Theme.new

local Panels = {}

local gui
local actions -- callbacks hacia Main
local windows = {} -- [key] = window
local openKey = nil
local refreshers = {} -- funciones de refresco por ventana

------------------------------------------------------------------------------
-- Ventana generica con pestanas
------------------------------------------------------------------------------

local function makeWindow(key, title, color, tabNames)
	local shade = new("TextButton", {
		Name = key .. "Window",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	})
	local frame = Theme.panel({
		Name = "Frame",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(720, 520),
		BackgroundColor3 = C.bg,
		Active = true,
		Parent = shade,
		Radius = 22,
	})
	Theme.stroke(color, 4).Parent = frame
	new("UIScale", { Parent = frame })
	-- Cabecera
	local header = Theme.panel({ Name = "Header", Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = color, Parent = frame, Radius = 20 })
	Theme.gradient(Color3.new(1, 1, 1), Color3.fromRGB(185, 185, 195), 90).Parent = header
	local titleLabel = Theme.label({ Text = title, Size = UDim2.new(1, -140, 0, 44), Position = UDim2.fromOffset(20, 9), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 34, Parent = header })
	Theme.textStroke(color:Lerp(Color3.new(0, 0, 0), 0.5), 2.5).Parent = titleLabel
	Theme.button({
		Text = "✕",
		Size = UDim2.fromOffset(48, 44),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Color = C.red,
		MaxText = 26,
		Parent = header,
		OnClick = function()
			Panels.close()
		end,
	})
	-- Pestanas
	local tabBar = new("Frame", { Name = "Tabs", Size = UDim2.new(1, -24, 0, 42), Position = UDim2.fromOffset(12, 70), BackgroundTransparency = 1, Parent = frame })
	Theme.list(8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left).Parent = tabBar
	local pages = {}
	local tabButtons = {}
	local win = { shade = shade, frame = frame, pages = pages, tabs = tabButtons, color = color, current = nil }
	local function select(name)
		win.current = name
		for n, page in pairs(pages) do
			page.Visible = n == name
		end
		for n, b in pairs(tabButtons) do
			Theme.setButton(b, b.Label.Text, n == name and color or C.bg3)
		end
	end
	win.select = select
	for i, name in ipairs(tabNames) do
		local page = new("ScrollingFrame", {
			Name = name,
			Size = UDim2.new(1, -24, 1, -128),
			Position = UDim2.fromOffset(12, 118),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 8,
			ScrollBarImageColor3 = color,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = i == 1,
			Parent = frame,
		})
		Theme.list(10).Parent = page
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = page })
		pages[name] = page
		if #tabNames > 1 then
			tabButtons[name] = Theme.button({
				Text = name,
				Size = UDim2.fromOffset(150, 40),
				Color = i == 1 and color or C.bg3,
				MaxText = 20,
				LayoutOrder = i,
				Parent = tabBar,
				OnClick = function()
					select(name)
				end,
			})
		end
	end
	if #tabNames <= 1 then
		for _, page in pairs(pages) do
			page.Position = UDim2.fromOffset(12, 74)
			page.Size = UDim2.new(1, -24, 1, -84)
		end
	end
	win.current = tabNames[1]
	windows[key] = win
	return win
end

local function card(parent, height, order, accent)
	local f = Theme.panel({ Size = UDim2.new(1, -4, 0, height), BackgroundColor3 = C.bg2, LayoutOrder = order, Parent = parent, Radius = 14 })
	Theme.stroke(accent or C.bg3, 2).Parent = f
	return f
end

local function iconBox(parent, icon, color, size)
	local box = Theme.panel({ Size = UDim2.fromOffset(size, size), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = color, Parent = parent, Radius = 14 })
	Theme.gradient(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 180), 120).Parent = box
	Theme.label({ Name = "Emoji", Text = icon, Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), MaxText = 48, Parent = box })
	return box
end

-- Usa la imagen oficial del pase/producto (subida en el Creator Dashboard) si existe
local iconCache = {}
local function useStoreIcon(box, assetId, infoType)
	if not assetId or assetId <= 0 or box:GetAttribute("IconLoaded") then
		return
	end
	box:SetAttribute("IconLoaded", true)
	task.spawn(function()
		local image = iconCache[assetId]
		if not image then
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(assetId, infoType)
			end)
			if ok and info and info.IconImageAssetId and info.IconImageAssetId > 0 then
				image = "rbxassetid://" .. info.IconImageAssetId
				iconCache[assetId] = image
			end
		end
		if image and box.Parent then
			new("ImageLabel", {
				Name = "StoreIcon",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Image = image,
				ScaleType = Enum.ScaleType.Fit,
				Parent = box,
			})
			Theme.corner(14).Parent = box.StoreIcon
			box.Emoji.Visible = false
		end
	end)
end

local function sectionHeader(parent, text, order, color)
	local l = Theme.label({ Text = text, Size = UDim2.new(1, -4, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color or C.gold, LayoutOrder = order, MaxText = 24, Parent = parent })
	return l
end

local function stars(level)
	local s = ""
	for i = 1, Config.MaxBusinessLevel do
		s ..= (i <= level) and "★" or "☆"
	end
	return s
end

------------------------------------------------------------------------------
-- IMPERIO
------------------------------------------------------------------------------

local function buildEmpire()
	local win = makeWindow("empire", "🏛️ Tu Imperio", C.blue, { "Negocios", "Mejoras", "Expansión" })
	local bizCards = {}
	for i, b in ipairs(Config.Businesses) do
		local f = card(win.pages["Negocios"], 92, i)
		iconBox(f, b.icon, b.color, 72)
		local name = Theme.label({ Text = b.name, Size = UDim2.new(1, -280, 0, 28), Position = UDim2.fromOffset(94, 8), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 24, Parent = f })
		local starsLabel = Theme.label({ Text = "", Size = UDim2.fromOffset(120, 22), Position = UDim2.fromOffset(94, 36), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.gold, Font = Theme.Bold, MaxText = 20, Parent = f })
		local info = Theme.label({ Text = "", Size = UDim2.new(1, -280, 0, 22), Position = UDim2.fromOffset(94, 60), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.muted, Font = Theme.Bold, MaxText = 17, Parent = f })
		local btn = Theme.button({
			Text = "",
			Size = UDim2.fromOffset(170, 52),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			MaxText = 20,
			Parent = f,
			OnClick = function()
				local st = Store.state and Economy.businessState(Store.state, b.id)
				if st == "owned" then
					actions.fire("upgradeBusiness", b.id)
				else
					actions.fire("buyBusiness", b.id)
				end
			end,
		})
		bizCards[b.id] = { frame = f, name = name, stars = starsLabel, info = info, btn = btn }
	end

	local upCards = {}
	local order = 0
	for _, tier in ipairs(Config.UpgradeTiers) do
		order += 1
		local header = sectionHeader(win.pages["Mejoras"], "Nivel " .. tier.tier .. " · " .. tier.name, order, C.purple)
		local grid = new("Frame", { Size = UDim2.new(1, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order + 0.5, Parent = win.pages["Mejoras"] })
		order += 1
		grid.LayoutOrder = order
		new("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 112), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
		for _, u in ipairs(Config.Upgrades) do
			if u.tier == tier.tier then
				local f = Theme.panel({ BackgroundColor3 = C.bg2, LayoutOrder = u.order, Parent = grid, Radius = 14 })
				Theme.stroke(C.bg3, 2).Parent = f
				iconBox(f, u.icon, C.purple, 52)
				Theme.label({ Text = u.name, Size = UDim2.new(1, -78, 0, 24), Position = UDim2.fromOffset(70, 8), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 19, Parent = f })
				Theme.label({ Text = u.desc, Size = UDim2.new(1, -78, 0, 32), Position = UDim2.fromOffset(70, 32), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = C.muted, Font = Theme.Bold, TextWrapped = true, MaxText = 14, Parent = f })
				local btn = Theme.button({
					Text = "",
					Size = UDim2.new(1, -20, 0, 36),
					Position = UDim2.new(0, 10, 1, -44),
					MaxText = 18,
					Parent = f,
					OnClick = function()
						actions.fire("buyUpgrade", u.id)
					end,
				})
				upCards[u.id] = { frame = f, btn = btn }
			end
		end
		local _ = header
	end

	-- Expansion y franquicia
	local expCards = {}
	for i, exp in ipairs(Config.Expansions) do
		local f = card(win.pages["Expansión"], 96, i, C.gold)
		iconBox(f, i == 1 and "🏪" or "🏙️", C.gold, 76)
		Theme.label({ Text = exp.name, Size = UDim2.new(1, -290, 0, 30), Position = UDim2.fromOffset(98, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 24, Parent = f })
		local names = {}
		for _, b in ipairs(Config.Businesses) do
			if b.zone == i + 1 then
				table.insert(names, b.icon .. " " .. b.name)
			end
		end
		Theme.label({ Text = "Desbloquea: " .. table.concat(names, ", "), Size = UDim2.new(1, -290, 0, 40), Position = UDim2.fromOffset(98, 44), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextColor3 = C.muted, Font = Theme.Bold, MaxText = 15, Parent = f })
		local btn = Theme.button({
			Text = "",
			Size = UDim2.fromOffset(170, 52),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			MaxText = 20,
			Parent = f,
			OnClick = function()
				actions.fire("buyExpansion", i)
			end,
		})
		expCards[i] = { btn = btn }
	end
	local fr = card(win.pages["Expansión"], 120, 10, C.purple)
	iconBox(fr, "🌟", C.purple, 76)
	Theme.label({ Text = "Franquicia", Size = UDim2.new(1, -290, 0, 30), Position = UDim2.fromOffset(98, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 24, Parent = fr })
	local frInfo = Theme.label({ Text = "", Size = UDim2.new(1, -290, 0, 66), Position = UDim2.fromOffset(98, 44), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextColor3 = C.muted, Font = Theme.Bold, MaxText = 15, Parent = fr })
	local frBtn = Theme.button({
		Text = "",
		Size = UDim2.fromOffset(170, 52),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		MaxText = 20,
		Parent = fr,
		OnClick = function()
			actions.confirm("🌟 ¿Abrir una franquicia?", "Reinicias negocios, mejoras y dinero a cambio de un bonus PERMANENTE de ingresos. Los objetivos y retos se mantienen.", function()
				actions.fire("franchise")
			end)
		end,
	})

	refreshers.empire = function(state)
		local x2 = state.passes and state.passes.x2
		for _, b in ipairs(Config.Businesses) do
			local c = bizCards[b.id]
			local st, reason = Economy.businessState(state, b.id)
			local level = state.businesses[b.id] or 0
			if st == "owned" then
				c.stars.Text = stars(level)
				local income = Economy.businessIncome(state, b.id, x2)
				local cost = Economy.levelUpCost(b.id, level)
				if cost then
					local nextIncome = Economy.baseIncomeAt(b.id, level + 1) * Economy.businessMultiplier(state, b.id) * Economy.globalMultiplier(state, x2)
					c.info.Text = string.format("💰 %s/s  →  %s/s", Format.cash(income), Format.cash(nextIncome))
					Theme.setButton(c.btn, "⬆️ " .. Format.cash(cost), state.cash >= cost and C.blue or C.greyDark)
				else
					c.info.Text = string.format("💰 %s/s  ·  ¡Nivel máximo!", Format.cash(income))
					Theme.setButton(c.btn, "⭐ MÁX", C.gold)
				end
				c.frame.UIStroke.Color = C.bg3
			elseif st == "available" then
				c.stars.Text = "Nuevo negocio"
				local income = Economy.baseIncomeAt(b.id, 1) * Economy.businessMultiplier(state, b.id) * Economy.globalMultiplier(state, x2)
				c.info.Text = string.format("💰 %s/s  ·  %s", Format.cash(income), b.desc)
				Theme.setButton(c.btn, b.cost == 0 and "¡GRATIS!" or ("🔨 " .. Format.cash(b.cost)), state.cash >= b.cost and C.green or C.greyDark)
				c.frame.UIStroke.Color = state.cash >= b.cost and C.green or C.bg3
			else
				c.stars.Text = "🔒 Bloqueado"
				c.info.Text = reason or ""
				Theme.setButton(c.btn, "🔒", C.grey)
				c.frame.UIStroke.Color = C.bg3
			end
		end
		for _, u in ipairs(Config.Upgrades) do
			local c = upCards[u.id]
			local st, reason = Economy.upgradeState(state, u.id)
			if st == "owned" then
				Theme.setButton(c.btn, "✔ Comprada", C.greenDark)
				c.frame.UIStroke.Color = C.green
			elseif st == "available" then
				Theme.setButton(c.btn, Format.cash(u.cost), state.cash >= u.cost and C.purple or C.greyDark)
				c.frame.UIStroke.Color = state.cash >= u.cost and C.purple or C.bg3
			else
				Theme.setButton(c.btn, "🔒 " .. (reason or ""), C.grey)
				c.frame.UIStroke.Color = C.bg3
			end
		end
		for i, exp in ipairs(Config.Expansions) do
			local st, reason = Economy.expansionState(state, i)
			local btn = expCards[i].btn
			if st == "owned" then
				Theme.setButton(btn, "✔ Desbloqueado", C.greenDark)
			elseif st == "available" then
				Theme.setButton(btn, "🚧 " .. Format.cash(exp.cost), state.cash >= exp.cost and C.gold or C.greyDark)
			else
				Theme.setButton(btn, "🔒 " .. (reason or ""), C.grey)
			end
		end
		local bonusNow = (state.franchises or 0) * Config.Franchise.bonusPerFranchise
		frInfo.Text = string.format(
			"Requiere Torre Corporativa y %s ganados en esta partida. Cada franquicia da %s de ingresos para siempre. Bonus actual: %s.",
			Format.cash(Config.Franchise.needEarned),
			Format.percent(Config.Franchise.bonusPerFranchise),
			Format.percent(bonusNow)
		)
		if state.canFranchise then
			Theme.setButton(frBtn, "🌟 Franquiciar", C.purple)
		else
			Theme.setButton(frBtn, "🔒 Bloqueado", C.grey)
		end
	end
end

------------------------------------------------------------------------------
-- RETOS
------------------------------------------------------------------------------

local function buildChallenges()
	local win = makeWindow("challenges", "🎯 Retos y Objetivos", C.pink, { "Diarios", "Objetivos" })
	local page = win.pages["Diarios"]
	local resetLabel = sectionHeader(page, "", 0, C.pink)
	local dailyCards = {}
	for i = 1, Config.DailyCount do
		local f = card(page, 100, i)
		iconBox(f, "📅", C.pink, 70)
		local text = Theme.label({ Text = "", Size = UDim2.new(1, -290, 0, 28), Position = UDim2.fromOffset(92, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 21, Parent = f })
		local bar = Theme.progressBar({ Size = UDim2.new(1, -290, 0, 18), Position = UDim2.fromOffset(92, 44), Color = C.pink, Parent = f })
		local prog = Theme.label({ Text = "", Size = UDim2.new(1, -290, 0, 18), Position = UDim2.fromOffset(92, 44), Font = Theme.Bold, ZIndex = 3, MaxText = 14, Parent = f })
		local reward = Theme.label({ Text = "", Size = UDim2.new(1, -290, 0, 20), Position = UDim2.fromOffset(92, 68), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.gold, Font = Theme.Bold, MaxText = 16, Parent = f })
		local btn = Theme.button({
			Text = "",
			Size = UDim2.fromOffset(170, 52),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			MaxText = 20,
			Parent = f,
			OnClick = function()
				actions.fire("claimDaily", i)
			end,
		})
		dailyCards[i] = { text = text, bar = bar, prog = prog, reward = reward, btn = btn, frame = f }
	end
	local bonusLabel = Theme.label({ Text = "🔥 Completa los 3 retos para ganar un BONUS igual a la suma de sus premios.", Size = UDim2.new(1, -4, 0, 40), TextWrapped = true, Font = Theme.Bold, TextColor3 = C.gold, LayoutOrder = 10, MaxText = 17, Parent = page })

	local goalsPage = win.pages["Objetivos"]
	sectionHeader(goalsPage, "Completa objetivos para hacer crecer tu imperio", 0, C.blue)
	local goalRows = {}
	for i, goal in ipairs(Config.Goals) do
		local f = card(goalsPage, 64, i)
		local icon = Theme.label({ Text = "🔒", Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(10, 10), MaxText = 32, Parent = f })
		local text = Theme.label({ Text = goal.text, Size = UDim2.new(1, -280, 0, 26), Position = UDim2.fromOffset(62, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = f })
		local sub = Theme.label({ Text = "Premio: " .. Format.cash(goal.reward), Size = UDim2.new(1, -280, 0, 20), Position = UDim2.fromOffset(62, 34), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.gold, Font = Theme.Bold, MaxText = 15, Parent = f })
		local btn = Theme.button({
			Text = "",
			Size = UDim2.fromOffset(170, 44),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			MaxText = 18,
			Parent = f,
			OnClick = function()
				actions.fire("claimGoal")
			end,
		})
		goalRows[i] = { icon = icon, text = text, sub = sub, btn = btn, frame = f }
	end

	refreshers.challenges = function(state)
		resetLabel.Text = "⏰ Nuevos retos en " .. Format.time(state.dailyReset or 0)
		local list = state.daily and state.daily.list or {}
		for i, c in ipairs(dailyCards) do
			local d = list[i]
			if d then
				c.frame.Visible = true
				c.text.Text = d.text
				Theme.setProgress(c.bar, d.progress / d.target)
				if d.kind == "earn" then
					c.prog.Text = Format.cash(d.progress) .. " / " .. Format.cash(d.target)
				else
					c.prog.Text = string.format("%d / %d", math.floor(d.progress), d.target)
				end
				c.reward.Text = "🎁 Premio: " .. Format.cash(d.reward)
				if d.claimed then
					Theme.setButton(c.btn, "✔ Reclamado", C.greenDark)
					c.frame.UIStroke.Color = C.bg3
				elseif d.progress >= d.target then
					Theme.setButton(c.btn, "🎁 Reclamar", C.green)
					c.frame.UIStroke.Color = C.green
				else
					Theme.setButton(c.btn, "En progreso", C.greyDark)
					c.frame.UIStroke.Color = C.bg3
				end
			else
				c.frame.Visible = false
			end
		end
		if state.daily and state.daily.bonusClaimed then
			bonusLabel.Text = "🔥 ¡Bonus diario conseguido! Vuelve mañana para más retos."
		end
		local current, currentIndex = Economy.currentGoal(state)
		for i, goal in ipairs(Config.Goals) do
			local row = goalRows[i]
			if state.goalsClaimed[goal.id] then
				row.icon.Text = "✅"
				Theme.setButton(row.btn, "✔ Hecho", C.greenDark)
				row.frame.UIStroke.Color = C.bg3
			elseif current and i == currentIndex then
				local p = Economy.goalProgress(state, goal)
				row.icon.Text = "🎯"
				if p >= goal.target then
					Theme.setButton(row.btn, "🎁 Reclamar", C.green)
					row.frame.UIStroke.Color = C.green
				else
					Theme.setButton(row.btn, string.format("%d / %d", math.min(p, goal.target), goal.target), C.blue)
					row.frame.UIStroke.Color = C.blue
				end
			else
				row.icon.Text = "🔒"
				Theme.setButton(row.btn, "Próximamente", C.grey)
				row.frame.UIStroke.Color = C.bg3
			end
		end
	end
end

------------------------------------------------------------------------------
-- TIENDA
------------------------------------------------------------------------------

local function buildShop()
	local win = makeWindow("shop", "🛒 Tienda", C.gold, { "Tienda" })
	local page = win.pages["Tienda"]
	local note = Theme.label({
		Text = "",
		Size = UDim2.new(1, -4, 0, 36),
		TextWrapped = true,
		Font = Theme.Bold,
		TextColor3 = C.muted,
		LayoutOrder = 0,
		MaxText = 15,
		Parent = page,
	})
	sectionHeader(page, "⭐ Pases (para siempre)", 1, C.gold)
	local passCards = {}
	for i, key in ipairs(Config.GamePassOrder) do
		local p = Config.GamePasses[key]
		local f = card(page, 100, 1 + i, C.gold)
		local passIcon = iconBox(f, p.icon, C.gold, 76)
		useStoreIcon(passIcon, p.id, Enum.InfoType.GamePass)
		Theme.label({ Text = p.name, Size = UDim2.new(1, -300, 0, 28), Position = UDim2.fromOffset(98, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 23, Parent = f })
		Theme.label({ Text = p.desc, Size = UDim2.new(1, -300, 0, 48), Position = UDim2.fromOffset(98, 42), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextColor3 = C.muted, Font = Theme.Bold, MaxText = 15, Parent = f })
		local btn = Theme.button({
			Text = "",
			Size = UDim2.fromOffset(180, 50),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			MaxText = 20,
			Parent = f,
			OnClick = function()
				local state = Store.state
				if state and state.passes[key] then
					if key == "decor" or key == "theme" then
						actions.fire("setting", key, state.settings[key] == false)
					end
					return
				end
				actions.buyPass(key)
			end,
		})
		passCards[key] = { btn = btn }
	end
	sectionHeader(page, "💵 Paquetes de efectivo", 5, C.green)
	local productCards = {}
	for i, key in ipairs(Config.ProductOrder) do
		local p = Config.Products[key]
		local f = card(page, 92, 5 + i, C.green)
		local productIcon = iconBox(f, p.icon, C.green, 70)
		useStoreIcon(productIcon, p.id, Enum.InfoType.Product)
		Theme.label({ Text = p.name, Size = UDim2.new(1, -300, 0, 28), Position = UDim2.fromOffset(92, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 23, Parent = f })
		local amount = Theme.label({ Text = "", Size = UDim2.new(1, -300, 0, 40), Position = UDim2.fromOffset(92, 42), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.green, MaxText = 26, Parent = f })
		local btn = Theme.button({
			Text = "",
			Size = UDim2.fromOffset(180, 50),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Color = C.green,
			MaxText = 20,
			Parent = f,
			OnClick = function()
				actions.buyProduct(key)
			end,
		})
		productCards[key] = { amount = amount, btn = btn }
	end
	Theme.label({
		Text = "Las compras solo mejoran TU parcela y nunca afectan a otros jugadores. Todo el progreso principal se puede conseguir gratis jugando. 💚",
		Size = UDim2.new(1, -4, 0, 44),
		TextWrapped = true,
		Font = Theme.Bold,
		TextColor3 = C.muted,
		LayoutOrder = 20,
		MaxText = 15,
		Parent = page,
	})

	refreshers.shop = function(state)
		if state.simulation then
			note.Text = "🧪 Modo Studio: los artículos sin ID real se simulan para que puedas probarlos."
		else
			note.Text = "Apoya el juego y consigue extras cosméticos o atajos opcionales."
		end
		for key, c in pairs(passCards) do
			local p = Config.GamePasses[key]
			if state.passes[key] then
				if key == "decor" or key == "theme" then
					local on = state.settings[key] ~= false
					Theme.setButton(c.btn, on and "✔ Activado" or "Desactivado", on and C.greenDark or C.greyDark)
				else
					Theme.setButton(c.btn, "✔ Activo", C.greenDark)
				end
			elseif (p.id or 0) > 0 or state.simulation then
				Theme.setButton(c.btn, "R$ " .. p.price, C.gold)
			else
				Theme.setButton(c.btn, "Próximamente", C.grey)
			end
		end
		for key, c in pairs(productCards) do
			local p = Config.Products[key]
			c.amount.Text = "+" .. Format.cash(Economy.productReward(state, key, state.passes.x2))
			if (p.id or 0) > 0 or state.simulation then
				Theme.setButton(c.btn, "R$ " .. p.price, C.green)
			else
				Theme.setButton(c.btn, "Próximamente", C.grey)
			end
		end
	end
end

------------------------------------------------------------------------------
-- Confirmacion
------------------------------------------------------------------------------

function Panels.confirm(title, body, onYes)
	local shade = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, ZIndex = 60, Parent = gui })
	local f = Theme.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(460, 250), BackgroundColor3 = C.bg, ZIndex = 61, Parent = shade, Radius = 20 })
	Theme.stroke(C.purple, 4).Parent = f
	Theme.label({ Text = title, Size = UDim2.new(1, -30, 0, 40), Position = UDim2.fromOffset(15, 14), TextColor3 = C.purple, ZIndex = 62, MaxText = 28, Parent = f })
	Theme.label({ Text = body, Size = UDim2.new(1, -40, 0, 100), Position = UDim2.fromOffset(20, 60), TextWrapped = true, Font = Theme.Bold, ZIndex = 62, MaxText = 19, Parent = f })
	local yes = Theme.button({ Text = "Sí", Size = UDim2.fromOffset(180, 48), Position = UDim2.new(0.5, 10, 1, -64), Color = C.purple, Parent = f, OnClick = function()
		shade:Destroy()
		onYes()
	end })
	local no = Theme.button({ Text = "Cancelar", Size = UDim2.fromOffset(180, 48), Position = UDim2.new(0.5, -190, 1, -64), Color = C.greyDark, Parent = f, OnClick = function()
		shade:Destroy()
	end })
	for _, b in ipairs({ yes, no }) do
		b.ZIndex = 62
		b.Label.ZIndex = 63
	end
	Theme.pop(f)
end

------------------------------------------------------------------------------
-- API
------------------------------------------------------------------------------

function Panels.open(key, tab)
	if openKey == key and not tab then
		Panels.close()
		return
	end
	Panels.close()
	local win = windows[key]
	if not win then
		return
	end
	openKey = key
	win.shade.Visible = true
	if tab and win.pages[tab] then
		win.select(tab)
	end
	local scale = win.frame:FindFirstChildOfClass("UIScale")
	scale.Scale = 0.7
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	if Store.state and refreshers[key] then
		refreshers[key](Store.state)
	end
	if actions.onOpen then
		actions.onOpen(key)
	end
end

function Panels.close()
	if openKey and windows[openKey] then
		windows[openKey].shade.Visible = false
	end
	openKey = nil
end

function Panels.isOpen(key)
	return openKey == key
end

function Panels.refresh(state)
	if openKey and refreshers[openKey] then
		refreshers[openKey](state)
	end
end

function Panels.init(screenGui, callbacks)
	gui = screenGui
	actions = callbacks
	actions.confirm = Panels.confirm
	buildEmpire()
	buildChallenges()
	buildShop()
	for _, win in pairs(windows) do
		win.shade.Activated:Connect(function()
			Panels.close()
		end)
	end
	Store.Ticked:Connect(function()
		if Store.state then
			Panels.refresh(Store.state)
		end
	end)
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Estilo visual y constructores de interfaz reutilizables.

local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Theme = {}

Theme.Font = Enum.Font.FredokaOne
Theme.Body = Enum.Font.GothamMedium
Theme.Bold = Enum.Font.GothamBold

Theme.C = {
	bg = Color3.fromRGB(28, 32, 48),
	bg2 = Color3.fromRGB(40, 46, 68),
	bg3 = Color3.fromRGB(54, 62, 90),
	text = Color3.fromRGB(245, 247, 255),
	muted = Color3.fromRGB(165, 175, 205),
	green = Color3.fromRGB(80, 215, 110),
	greenDark = Color3.fromRGB(40, 150, 75),
	blue = Color3.fromRGB(80, 160, 255),
	blueDark = Color3.fromRGB(45, 105, 200),
	gold = Color3.fromRGB(255, 200, 60),
	goldDark = Color3.fromRGB(205, 140, 20),
	red = Color3.fromRGB(240, 85, 85),
	redDark = Color3.fromRGB(170, 45, 45),
	purple = Color3.fromRGB(170, 110, 255),
	purpleDark = Color3.fromRGB(110, 60, 200),
	pink = Color3.fromRGB(255, 110, 170),
	grey = Color3.fromRGB(110, 115, 135),
	greyDark = Color3.fromRGB(75, 80, 98),
	white = Color3.new(1, 1, 1),
}

function Theme.new(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function Theme.corner(radius)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Theme.stroke(color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.textStroke(color, thickness)
	return Theme.new("UIStroke", {
		Color = color or Color3.fromRGB(20, 20, 30),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function Theme.padding(all, top)
	return Theme.new("UIPadding", {
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
		PaddingTop = UDim.new(0, top or all),
		PaddingBottom = UDim.new(0, top or all),
	})
end

function Theme.gradient(a, b, rotation)
	return Theme.new("UIGradient", {
		Color = ColorSequence.new(a, b),
		Rotation = rotation or 90,
	})
end

function Theme.list(padding, direction, hAlign, vAlign)
	return Theme.new("UIListLayout", {
		Padding = UDim.new(0, padding or 8),
		FillDirection = direction or Enum.FillDirection.Vertical,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.C.text,
		TextScaled = true,
		Text = "",
	}
	for k, v in pairs(props or {}) do
		if k ~= "MaxText" then
			defaults[k] = v
		end
	end
	local l = Theme.new("TextLabel", defaults)
	if defaults.TextScaled then
		Theme.new("UITextSizeConstraint", { MaxTextSize = props and props.MaxText or 40, Parent = l })
	end
	return l
end

function Theme.panel(props, children)
	local defaults = {
		BackgroundColor3 = Theme.C.bg,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props or {}) do
		if k ~= "Radius" then
			defaults[k] = v
		end
	end
	local f = Theme.new("Frame", defaults, children)
	Theme.corner(props and props.Radius or 14).Parent = f
	return f
end

------------------------------------------------------------------------------
-- Sonidos
------------------------------------------------------------------------------

local SOUNDS = {
	click = { id = "rbxasset://sounds/button.wav", volume = 0.5, pitch = 1.1 },
	success = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, pitch = 1 },
	coin = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.45, pitch = 1.5 },
	build = { id = "rbxasset://sounds/snap.wav", volume = 0.8, pitch = 0.9 },
	levelup = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.7, pitch = 1.25 },
	upgrade = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.7, pitch = 0.8 },
	error = { id = "rbxasset://sounds/button.wav", volume = 0.6, pitch = 0.55 },
}
local soundCache = {}

function Theme.play(name)
	local def = SOUNDS[name]
	if not def then
		return
	end
	local s = soundCache[name]
	if not s then
		s = Instance.new("Sound")
		s.Name = "TE_" .. name
		s.SoundId = def.id
		s.Volume = def.volume
		s.PlaybackSpeed = def.pitch
		s.Parent = SoundService
		soundCache[name] = s
	end
	SoundService:PlayLocalSound(s)
end

------------------------------------------------------------------------------
-- Boton con animacion
------------------------------------------------------------------------------

function Theme.button(props)
	local color = props.Color or Theme.C.green
	local dark = props.Dark or color:Lerp(Color3.new(0, 0, 0), 0.3)
	local btn = Theme.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Theme.corner(props.Radius or 12).Parent = btn
	local stroke = Theme.stroke(dark, 3)
	stroke.Parent = btn
	Theme.gradient(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205), 90).Parent = btn
	local label = Theme.label({
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		Text = props.Text or "",
		TextColor3 = Theme.C.white,
		MaxText = props.MaxText or 28,
		Parent = btn,
	})
	Theme.padding(6, 4).Parent = label
	Theme.textStroke(dark, 2).Parent = label
	local scale = Theme.new("UIScale", { Parent = btn })
	btn.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.05 }):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.94 }):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Back), { Scale = 1.03 }):Play()
	end)
	if props.OnClick then
		btn.Activated:Connect(function()
			Theme.play("click")
			props.OnClick()
		end)
	end
	return btn
end

-- Cambia color y texto de un boton creado con Theme.button
function Theme.setButton(btn, text, color, enabled)
	btn.Label.Text = text
	btn.BackgroundColor3 = color
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.3)
	btn.UIStroke.Color = dark
	btn.Label.UIStroke.Color = dark
	btn.Active = enabled ~= false
	btn.AutoButtonColor = false
end

function Theme.progressBar(props)
	local bar = Theme.new("Frame", {
		Name = props.Name or "Bar",
		Size = props.Size or UDim2.new(1, 0, 0, 14),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.fromRGB(18, 20, 32),
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Theme.corner(8).Parent = bar
	local fill = Theme.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = props.Color or Theme.C.green,
		Parent = bar,
	})
	Theme.corner(8).Parent = fill
	Theme.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190), 90).Parent = fill
	return bar
end

function Theme.setProgress(bar, alpha, animate)
	alpha = math.clamp(alpha or 0, 0, 1)
	local goal = UDim2.fromScale(alpha, 1)
	if animate then
		TweenService:Create(bar.Fill, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = goal }):Play()
	else
		bar.Fill.Size = goal
	end
end

function Theme.pop(guiObject)
	local scale = guiObject:FindFirstChildOfClass("UIScale") or Theme.new("UIScale", { Parent = guiObject })
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="42">
          <Properties>
            <string name="Name">World</string>
          </Properties>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Pedestrians</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Peatones con comportamiento natural:
--  * aceleran y frenan suavemente, giran poco a poco
--  * al final de cada acera se detienen, miran alrededor y dan la vuelta
--  * de vez en cuando paran a mirar la fuente
--  * esquivan / esperan si un jugador se cruza delante
--  * paso con balanceo de brazos y piernas y rebote del cuerpo proporcional a la velocidad

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Pedestrians = {}

local walkers = {}
local HIP = CFrame.new(0, 2, 0)
local SHOULDER = CFrame.new(0, 3.9, 0)
local ACCEL = 5
local TURN_RATE = 5
local ACTIVE_RANGE = 260

local function yawOf(dir)
	return math.atan2(-dir.X, -dir.Z)
end

local function lerpAngle(a, b, alpha)
	local d = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + d * alpha
end

local function register(model)
	local pivot = model:GetPivot()
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local rel = pivot:ToObjectSpace(d.CFrame)
			local limb = nil
			if d.Name == "LegL" or (d.Name == "Shoe" and rel.Position.X < 0) then
				limb = "legL"
			elseif d.Name == "LegR" or (d.Name == "Shoe" and rel.Position.X > 0) then
				limb = "legR"
			elseif d.Name == "ArmL" then
				limb = "armL"
			elseif d.Name == "ArmR" then
				limb = "armR"
			elseif d.Name == "Head" or d.Name == "Hair" or d.Name == "Cap" or d.Name == "Visor" or d.Name:sub(1, 3) == "Eye" then
				limb = "head"
			end
			table.insert(parts, { part = d, rel = rel, limb = limb })
		end
	end
	local phase = model:GetAttribute("Phase") or 0
	local w = {
		model = model,
		parts = parts,
		mode = model:GetAttribute("WalkMode") or "circle",
		cx = model:GetAttribute("CenterX") or 0,
		cz = model:GetAttribute("CenterZ") or 0,
		radius = model:GetAttribute("Radius") or 20,
		a = model:GetAttribute("A") or Vector3.zero,
		b = model:GetAttribute("B") or Vector3.new(10, 0, 0),
		cruise = math.abs(model:GetAttribute("Speed") or 4),
		sign = (model:GetAttribute("Speed") or 1) >= 0 and 1 or -1,
		baseY = model:GetAttribute("BaseY") or 0.5,
		v = 0,
		step = phase * 10,
		state = "walk",
		timer = 0,
		nextIdle = 8 + phase * 20,
		lookYaw = 0,
		active = true,
		seed = phase * 100,
	}
	if w.mode == "line" then
		local len = (w.b - w.a).Magnitude
		local u = (phase * 2 * len) % (2 * len)
		w.leg = u < len and 1 or -1
		w.u = u < len and u or u - len
		w.len = len
	else
		w.angle = phase * math.pi * 2
	end
	local _, dir = Pedestrians._pose(w)
	w.yaw = yawOf(dir)
	table.insert(walkers, w)
end

-- Posicion y direccion de marcha actuales
function Pedestrians._pose(w)
	if w.mode == "line" then
		local delta = (w.b - w.a)
		local unit = delta.Unit
		if w.leg > 0 then
			return w.a + unit * w.u, unit
		end
		return w.b - unit * w.u, -unit
	end
	local pos = Vector3.new(w.cx + math.cos(w.angle) * w.radius, 0, w.cz + math.sin(w.angle) * w.radius)
	local dir = Vector3.new(-math.sin(w.angle), 0, math.cos(w.angle)) * w.sign
	return pos, dir
end

local function blocked(pos, dir)
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local rel = Vector3.new(root.Position.X - pos.X, 0, root.Position.Z - pos.Z)
			local forward = rel:Dot(dir)
			if forward > 0 and forward < 5 and (rel - dir * forward).Magnitude < 2.5 then
				return true
			end
		end
	end
	return false
end

local function stepWalker(w, dt, t)
	local pos, dir = Pedestrians._pose(w)
	local targetSpeed = w.cruise
	local targetYaw = yawOf(dir)

	if w.state == "turn" then
		-- Fin de la acera: se para, mira a un lado y da media vuelta
		w.timer -= dt
		targetSpeed = 0
		local progress = 1 - math.max(0, w.timer) / 1.6
		targetYaw = yawOf(dir) + math.sin(progress * math.pi) * 0.6 + (progress > 0.5 and math.pi or 0)
		if w.timer <= 0 then
			w.leg = -w.leg
			w.u = 0
			w.state = "walk"
			pos, dir = Pedestrians._pose(w)
			targetYaw = yawOf(dir)
		end
	elseif w.state == "idle" then
		-- Parada para mirar la fuente / el escaparate
		w.timer -= dt
		targetSpeed = 0
		local toCenter = Vector3.new(w.cx - pos.X, 0, w.cz - pos.Z)
		if w.mode == "circle" and toCenter.Magnitude > 0.1 then
			targetYaw = yawOf(toCenter.Unit)
		end
		w.lookYaw = math.sin(t * 1.3 + w.seed) * 0.5
		if w.timer <= 0 then
			w.state = "walk"
			w.nextIdle = 14 + (w.seed * 7.3) % 18
		end
	else
		w.lookYaw *= 1 - math.min(1, dt * 3)
		w.nextIdle -= dt
		if w.nextIdle <= 0 then
			w.state = "idle"
			w.timer = 2.2 + (w.seed % 1.5)
		end
		if blocked(pos, dir) then
			targetSpeed = 0
		end
	end

	-- Velocidad con aceleracion suave
	local dv = targetSpeed - w.v
	w.v = math.max(0, w.v + math.clamp(dv, -ACCEL * 1.6 * dt, ACCEL * dt))
	if w.mode == "line" then
		w.u += w.v * dt
		if w.u >= w.len and w.state == "walk" then
			w.u = w.len
			w.state = "turn"
			w.timer = 1.6
		end
		w.u = math.min(w.u, w.len)
	else
		w.angle += w.sign * w.v * dt / w.radius
	end
	pos = Pedestrians._pose(w)

	-- Giro suave
	w.yaw = lerpAngle(w.yaw, targetYaw, math.min(1, dt * TURN_RATE))

	-- Paso: frecuencia proporcional a la velocidad
	local speedFactor = math.clamp(w.v / math.max(w.cruise, 0.1), 0, 1)
	w.step += w.v * dt * 1.9
	local swing = math.sin(w.step) * 0.6 * speedFactor
	local bounce = math.abs(math.sin(w.step)) * 0.16 * speedFactor
	local breathe = math.sin(t * 2 + w.seed) * 0.03 * (1 - speedFactor)
	local pivot = CFrame.new(pos.X, w.baseY + bounce, pos.Z) * CFrame.Angles(0, w.yaw, 0)
	-- Ligera inclinacion hacia delante al andar
	pivot *= CFrame.Angles(-0.06 * speedFactor, 0, 0)
	local idleArm = (1 - speedFactor) * 0.08

	for _, p in ipairs(w.parts) do
		local cf
		if p.limb == "legL" or p.limb == "legR" then
			local a = p.limb == "legL" and swing or -swing
			cf = pivot * HIP * CFrame.Angles(a, 0, 0) * HIP:Inverse() * p.rel
		elseif p.limb == "armL" or p.limb == "armR" then
			local a = (p.limb == "armL" and -swing or swing) * 0.85
			local side = p.limb == "armL" and idleArm or -idleArm
			cf = pivot * SHOULDER * CFrame.Angles(a, 0, side) * SHOULDER:Inverse() * p.rel
		elseif p.limb == "head" then
			cf = pivot * CFrame.new(0, 4.65 + breathe, 0) * CFrame.Angles(0, w.lookYaw, 0) * CFrame.new(0, -4.65, 0) * p.rel
		else
			cf = pivot * CFrame.new(0, breathe, 0) * p.rel
		end
		p.part.CFrame = cf
	end
end

function Pedestrians.start()
	for _, m in ipairs(CollectionService:GetTagged("TE_Walker")) do
		register(m)
	end
end

function Pedestrians.step(dt, t, camPos)
	dt = math.min(dt, 0.1)
	for _, w in ipairs(walkers) do
		if w.model.Parent then
			local pos = Pedestrians._pose(w)
			if (pos - camPos).Magnitude < ACTIVE_RANGE then
				stepWalker(w, dt, t)
			end
		end
	end
end

Pedestrians._walkers = walkers

return Pedestrians
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Traffic</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Trafico del anillo exterior con un modelo de conduccion sencillo:
--  * recorrido con curvas redondeadas (sin giros bruscos de 90 grados)
--  * aceleracion y frenado realistas (curva de frenado v = sqrt(2·a·d))
--  * distancia de seguridad con el coche de delante
--  * se detienen en los semaforos en rojo y ante jugadores en la calzada
--  * ruedas que giran, cabeceo al frenar, balanceo en las curvas y luces de freno

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Traffic = {}

local CORNER_RADIUS = 16
local LANE_OFFSET = 5
local ACCEL = 9
local BRAKE = 20
local CURVE_SPEED = 13
local SAFE_GAP = 11
local STOP_BEFORE = 17 -- distancia del centro del cruce a la linea de detencion
local ACTIVE_RANGE = 400

local cars = {}
local path = nil
local intersections = {}

------------------------------------------------------------------------------
-- Recorrido: rectangulo de esquinas redondeadas (parametro s = distancia)
------------------------------------------------------------------------------

local function buildPath(rx, rz)
	local rc = CORNER_RADIUS
	local lx = 2 * rx - 2 * rc
	local lz = 2 * rz - 2 * rc
	local arc = math.pi * rc / 2
	local segs = {
		{ kind = "line", from = Vector3.new(-rx + rc, 0, -rz), dir = Vector3.new(1, 0, 0), len = lx },
		{ kind = "arc", center = Vector3.new(rx - rc, 0, -rz + rc), a0 = -math.pi / 2, len = arc },
		{ kind = "line", from = Vector3.new(rx, 0, -rz + rc), dir = Vector3.new(0, 0, 1), len = lz },
		{ kind = "arc", center = Vector3.new(rx - rc, 0, rz - rc), a0 = 0, len = arc },
		{ kind = "line", from = Vector3.new(rx - rc, 0, rz), dir = Vector3.new(-1, 0, 0), len = lx },
		{ kind = "arc", center = Vector3.new(-rx + rc, 0, rz - rc), a0 = math.pi / 2, len = arc },
		{ kind = "line", from = Vector3.new(-rx, 0, rz - rc), dir = Vector3.new(0, 0, -1), len = lz },
		{ kind = "arc", center = Vector3.new(-rx + rc, 0, -rz + rc), a0 = math.pi, len = arc },
	}
	local total = 0
	for _, seg in ipairs(segs) do
		seg.start = total
		total += seg.len
	end
	return { segs = segs, length = total, rc = rc }
end

-- Devuelve posicion, direccion y si es curva para la distancia s
local function sample(s)
	s %= path.length
	for _, seg in ipairs(path.segs) do
		if s < seg.start + seg.len then
			local u = s - seg.start
			if seg.kind == "line" then
				return seg.from + seg.dir * u, seg.dir, false
			end
			local a = seg.a0 + u / path.rc
			local pos = seg.center + Vector3.new(math.cos(a), 0, math.sin(a)) * path.rc
			return pos, Vector3.new(-math.sin(a), 0, math.cos(a)), true
		end
	end
	return path.segs[1].from, path.segs[1].dir, false
end

-- Distancia (en sentido de la marcha) hasta la proxima curva
local function distToCurve(s, lane)
	local best = math.huge
	for _, seg in ipairs(path.segs) do
		if seg.kind == "arc" then
			local entry = lane > 0 and seg.start or (seg.start + seg.len)
			local d
			if lane > 0 then
				d = (entry - s) % path.length
			else
				d = (s - entry) % path.length
			end
			best = math.min(best, d)
		end
	end
	return best
end

local function closestS(point)
	local best, bestS = math.huge, 0
	for s = 0, path.length, 1 do
		local p = sample(s)
		local d = (p - point).Magnitude
		if d < best then
			best, bestS = d, s
		end
	end
	return bestS
end

------------------------------------------------------------------------------
-- Semaforos
------------------------------------------------------------------------------

local function lightState(phase, t)
	local cycle = (t / 12 + phase) % 1
	if cycle < 0.42 then
		return "Green"
	elseif cycle < 0.54 then
		return "Yellow"
	end
	return "Red"
end
Traffic.lightState = lightState

local function setupIntersections()
	local byCenter = {}
	for _, light in ipairs(CollectionService:GetTagged("TE_TrafficLight")) do
		if light:GetAttribute("Road") == "ring" then
			local key = string.format("%d,%d", light:GetAttribute("CenterX") or 0, light:GetAttribute("CenterZ") or 0)
			if not byCenter[key] then
				local center = Vector3.new(light:GetAttribute("CenterX") or 0, 0, light:GetAttribute("CenterZ") or 0)
				byCenter[key] = true
				table.insert(intersections, { s = closestS(center), phase = light:GetAttribute("Phase") or 0 })
			end
		end
	end
end

------------------------------------------------------------------------------
-- Coches
------------------------------------------------------------------------------

local function register(model)
	local pivot = model:GetPivot()
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, {
				part = d,
				rel = pivot:ToObjectSpace(d.CFrame),
				wheel = d.Name == "Wheel",
				tail = d.Name == "Taillight",
			})
		end
	end
	local folder = model.Parent
	if not path then
		path = buildPath(folder:GetAttribute("RingX") or 330, folder:GetAttribute("RingZ") or 185)
	end
	local lane = model:GetAttribute("Lane") or 1
	table.insert(cars, {
		model = model,
		parts = parts,
		lane = lane,
		cruise = model:GetAttribute("Speed") or 25,
		s = ((model:GetAttribute("Phase") or 0) * path.length) % path.length,
		v = 0,
		accel = 0,
		wheelAngle = 0,
		roll = 0,
		pitch = 0,
		braking = false,
		active = true,
	})
end

-- Distancia hacia delante (sentido de la marcha) de a hasta b
local function ahead(car, sOther)
	if car.lane > 0 then
		return (sOther - car.s) % path.length
	end
	return (car.s - sOther) % path.length
end

local function playerBlocking(car, pos, dir)
	local best = math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local rel = root.Position - pos
			local forward = rel:Dot(dir)
			local lateral = (rel - dir * forward).Magnitude
			if forward > 0 and forward < 45 and lateral < 4.5 and math.abs(rel.Y) < 8 then
				best = math.min(best, forward)
			end
		end
	end
	return best
end

local function stepCar(car, dt, t, render)
	-- Velocidad deseada: crucero, limitada por curvas, coche delantero, semaforos y jugadores
	local desired = car.cruise
	-- Curva de frenado v = sqrt(2·a·d); por defecto con deceleracion comoda
	local function limitToStopAt(distance, decel)
		local v = math.sqrt(2 * (decel or BRAKE * 0.6) * math.max(0, distance))
		if v < desired then
			desired = v
		end
	end
	local dCurve = distToCurve(car.s, car.lane)
	local _, dir0, inCurve = sample(car.s)
	if inCurve then
		desired = math.min(desired, CURVE_SPEED)
	else
		desired = math.min(desired, math.sqrt(CURVE_SPEED * CURVE_SPEED + 2 * BRAKE * 0.6 * dCurve))
	end
	-- Coche de delante en el mismo carril
	local gap = math.huge
	for _, other in ipairs(cars) do
		if other ~= car and other.lane == car.lane then
			local g = ahead(car, other.s)
			if g > 0 and g < gap then
				gap = g
			end
		end
	end
	if gap < 80 then
		limitToStopAt(gap - SAFE_GAP, BRAKE * 0.8)
	end
	-- Semaforos del anillo. Si al ponerse en ambar/rojo el coche ya no puede detenerse
	-- con comodidad, se "compromete" y cruza (como un conductor real).
	for _, inter in ipairs(intersections) do
		local d = ahead(car, inter.s)
		local distToLine = d - STOP_BEFORE
		if distToLine < -6 or distToLine >= 60 then
			-- ya cruzado (o aun lejos): se olvida la decision tomada
			if car.committed == inter then
				car.committed = nil
			end
			if car.stopping == inter then
				car.stopping = nil
			end
		else
			local state = lightState(inter.phase, t)
			if state == "Green" then
				if car.stopping == inter then
					car.stopping = nil
				end
			elseif car.committed ~= inter then
				-- La decision (parar o cruzar) se toma una vez y se mantiene
				if car.stopping ~= inter then
					local canStop = car.v * car.v <= 2 * BRAKE * math.max(distToLine, 0) + 9
					if canStop then
						car.stopping = inter
					else
						car.committed = inter
					end
				end
				if car.stopping == inter then
					limitToStopAt(math.max(distToLine, 0), BRAKE * 0.6)
				end
			end
		end
	end

	-- Jugadores en la calzada
	local pos0 = sample(car.s)
	local dirTravel = car.lane > 0 and dir0 or -dir0
	local right = dirTravel:Cross(Vector3.yAxis)
	local blocking = playerBlocking(car, pos0 + right * LANE_OFFSET, dirTravel)
	if blocking < math.huge then
		limitToStopAt(blocking - 7, BRAKE)
	end

	-- Integracion (aceleracion limitada)
	local dv = desired - car.v
	local a = math.clamp(dv / math.max(dt, 1e-3), -BRAKE, ACCEL)
	car.v = math.max(0, car.v + a * dt)
	car.accel += (a - car.accel) * math.min(1, dt * 6)
	car.braking = a < -2
	car.s = (car.s + car.lane * car.v * dt) % path.length
	if not render then
		return
	end

	-- Pose
	local pos, dir = sample(car.s)
	if car.lane < 0 then
		dir = -dir
	end
	local r = dir:Cross(Vector3.yAxis)
	local p = pos + r * LANE_OFFSET + Vector3.new(0, 0.3, 0)
	-- Balanceo en curva (aceleracion lateral v^2/r) y cabeceo al acelerar/frenar
	local _, dirAhead = sample(car.s + car.lane * 2)
	if car.lane < 0 then
		dirAhead = -dirAhead
	end
	local turn = dir:Cross(dirAhead).Y -- signo del giro
	local targetRoll = math.clamp(turn * car.v * car.v * 0.0011, -0.07, 0.07)
	car.roll += (targetRoll - car.roll) * math.min(1, dt * 5)
	local targetPitch = math.clamp(car.accel * 0.0035, -0.05, 0.035)
	car.pitch += (targetPitch - car.pitch) * math.min(1, dt * 7)
	local suspension = math.sin(t * 9 + car.s) * 0.04 * math.min(1, car.v / 20)
	local body = CFrame.lookAt(p, p + dir) * CFrame.new(0, suspension, 0) * CFrame.Angles(car.pitch, 0, car.roll)
	local flat = CFrame.lookAt(p, p + dir)
	car.wheelAngle = (car.wheelAngle - car.v * dt / 0.9) % (math.pi * 2)
	for _, info in ipairs(car.parts) do
		if info.wheel then
			info.part.CFrame = flat * info.rel * CFrame.Angles(car.wheelAngle, 0, 0)
		else
			info.part.CFrame = body * info.rel
			if info.tail then
				info.part.Color = car.braking and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(150, 30, 30)
			end
		end
	end
end

function Traffic.start()
	for _, car in ipairs(CollectionService:GetTagged("TE_Car")) do
		register(car)
	end
	if path then
		setupIntersections()
	end
end

function Traffic.step(dt, t, camPos)
	if not path then
		return
	end
	Traffic._time = t
	Traffic._length = path.length
	dt = math.min(dt, 0.1)
	for _, car in ipairs(cars) do
		if car.model.Parent then
			-- Lejos de la camara se simula igual (mismo comportamiento), pero sin mover piezas
			local pos = sample(car.s)
			car.active = (pos - camPos).Magnitude < ACTIVE_RANGE
			stepCar(car, dt, t, car.active)
		end
	end
end

-- Para las pruebas
Traffic._cars = cars
Traffic._sample = function(s)
	return sample(s)
end
Traffic._intersections = intersections

return Traffic
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="45">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>